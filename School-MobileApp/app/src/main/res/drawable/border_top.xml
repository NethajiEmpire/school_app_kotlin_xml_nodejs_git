<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer shape: the border with top corners rounded -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FB8484"/> <!-- Border color -->
            <corners
                android:topLeftRadius="8dp"
                android:topRightRadius="8dp"/>
        </shape>
    </item>

    <!-- Inner shape: the background fill, inset to hide bottom border -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FDF7F7"/> <!-- Background color -->
            <corners
                android:topLeftRadius="8dp"
                android:topRightRadius="8dp"/>
        </shape>
    </item>

</layer-list>
