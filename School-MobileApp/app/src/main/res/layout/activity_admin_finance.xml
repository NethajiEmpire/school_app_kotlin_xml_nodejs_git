<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/otp_rec"
    android:fitsSystemWindows="true"
    tools:context=".activity.AdminFinanceActivity">
    <LinearLayout
        android:id="@+id/Finance"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/header">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:paddingVertical="14dp"
                    android:id="@+id/top"
                    android:paddingHorizontal="16dp"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/backarrow"
                        android:layout_width="20dp"
                        android:layout_height="18dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/ic_back_arrow"
                        android:backgroundTint="@color/colorPrimary"/>
                    <TextView
                        android:layout_marginStart="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toEndOf="@id/backarrow"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:textSize="18dp"
                        android:textColor="@color/colorPrimary"
                        style="@style/FontMedium"
                        android:text="1st Standard"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        android:id="@+id/notify"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_marginEnd="12dp"
                        app:layout_constraintEnd_toStartOf="@id/profile"
                        android:src="@drawable/dash_notification"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:id="@+id/profile"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:src="@drawable/ic_user_profile"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardElevation="0dp"
                android:layout_marginBottom="-30dp"
                app:cardCornerRadius="25dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="30dp"
                    android:orientation="vertical">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">
                        <androidx.core.widget.NestedScrollView
                            android:layout_width="match_parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:gravity="center"
                                android:layout_marginTop="8dp"
                                android:padding="16dp"
                                android:orientation="vertical"
                                android:layout_marginBottom="14dp"
                                android:layout_height="match_parent">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:background="@drawable/rect_gray_line">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:id="@+id/lin1"
                                        android:paddingVertical="12dp"
                                        app:layout_constraintStart_toStartOf="parent"
                                        android:gravity="center"
                                        android:weightSum="3">
                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:gravity="center"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                style="@style/FontRegular"
                                                android:textSize="@dimen/_14sp"
                                                android:text="₹3,15,000"
                                                android:textColor="#32B138"/>
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                style="@style/FontRegular"
                                                android:textSize="@dimen/_12sp"
                                                android:text="Collected Amt"
                                                android:textColor="#585858"/>
                                        </LinearLayout>
                                        <View
                                            android:layout_width="1dp"
                                            android:layout_height="match_parent"
                                            android:background="#EFEFEF"/>
                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:id="@+id/lin3"
                                            android:gravity="center"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                style="@style/FontRegular"
                                                android:textSize="@dimen/_14sp"
                                                android:text="₹63,000"
                                                android:textColor="#FF7700"/>
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                style="@style/FontRegular"
                                                android:textSize="@dimen/_12sp"
                                                android:text="Pending Amt"
                                                android:textColor="#585858"/>
                                        </LinearLayout>
                                        <View
                                            android:layout_width="1dp"
                                            android:layout_height="match_parent"
                                            android:background="#EFEFEF"/>
                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:gravity="center"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textColor="#FF7475"
                                                style="@style/FontRegular"
                                                android:textSize="@dimen/_14sp"
                                                android:text="₹27,000"/>
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                style="@style/FontRegular"
                                                android:textSize="@dimen/_12sp"
                                                android:text="Over Due Amt"
                                                android:textColor="#585858"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">
                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="1dp"
                                            android:layout_marginHorizontal="12dp"
                                            android:background="#F5F5F5"/>
                                    </LinearLayout>
                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:paddingVertical="8dp"
                                        android:gravity="center">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            style="@style/FontRegular"
                                            android:textSize="@dimen/_14sp"
                                            android:textColor="#585858"
                                            android:text="Overall Fees :"
                                            android:id="@+id/overal_fee"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            style="@style/FontRegular"
                                            android:textSize="@dimen/_14sp"
                                            android:textStyle="bold"
                                            android:textColor="#11356B"
                                            android:text="₹4,05,000"
                                            android:layout_toEndOf="@id/overal_fee"/>
                                    </RelativeLayout>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="10dp"
                                    android:layout_marginTop="12dp"
                                    android:background="@drawable/border_line_curve_8dp_gray_with_gray_bg">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">
                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical"
                                            android:padding="4dp">
                                            <TextView
                                                android:id="@+id/std"
                                                style="@style/FontRegular"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="4dp"
                                                android:text="1st Standard"
                                                android:textStyle="bold"
                                                android:textColor="@color/black_varient3"
                                                android:textSize="14sp" />
                                            <TextView
                                                style="@style/FontMedium"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="(2019 – 2022)"
                                                android:layout_marginStart="4dp"
                                                android:textColor="#333333"
                                                android:textSize="12sp" />
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:gravity="right"
                                            android:orientation="vertical"
                                            android:padding="4dp">
                                            <TextView
                                                android:background="@drawable/border_curve_24dp"
                                                android:backgroundTint="#D8FFDA"
                                                android:id="@+id/leaveType"
                                                android:layout_weight="1"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="14sp"
                                                android:paddingHorizontal="16dp"
                                                android:paddingVertical="2dp"
                                                style="@style/FontRegular"
                                                android:textColor="#32B138"
                                                android:text="Active "/>
                                            <TextView
                                                android:id="@+id/stdNum"
                                                style="@style/FontMedium"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="60 Students"
                                                android:layout_marginStart="4dp"
                                                android:textColor="#878787"
                                                android:textSize="12sp" />
                                        </LinearLayout>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center"
                                        android:visibility="visible"
                                        android:paddingVertical="6dp"
                                        android:paddingHorizontal="12dp"
                                        android:background="@drawable/dashed_border_line_curve_8dp_with_white_bg"
                                        android:layout_marginVertical="8dp">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Admission fees"
                                            android:textColor="#003A63"
                                            android:textSize="12sp"
                                            style="@style/FontRegular"
                                            android:layout_weight="1"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="₹1,000"
                                            android:gravity="right"
                                            android:textColor="#32B138"
                                            android:textSize="12sp"
                                            style="@style/FontRegular"
                                            android:layout_weight="1"/>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">
                                        <LinearLayout
                                            android:id="@+id/showDetails"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="horizontal"
                                            android:gravity="center"
                                            android:visibility="visible"
                                            android:paddingVertical="10dp"
                                            android:paddingHorizontal="14dp"
                                            android:background="@drawable/border_curve_4dp_very_light_blue"
                                            android:backgroundTint="#E4F5FF">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Term 1 : ₹40,000"
                                                android:textColor="#003A63"
                                                android:textSize="12sp"
                                                style="@style/FontRegular"
                                                android:layout_weight="1"/>
                                            <ImageView
                                                android:id="@+id/dropDown"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:background="@drawable/ic_drop_down"
                                                android:backgroundTint="#124090"/>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:id="@+id/feeDetails"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="vertical"
                                            android:gravity="center"
                                            android:visibility="gone"
                                            android:layout_marginTop="10dp"
                                            android:padding="1dp"
                                            android:background="@drawable/border_curve_8dp_white_bg">
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:orientation="horizontal"
                                                android:gravity="center"
                                                android:paddingVertical="10dp"
                                                android:paddingHorizontal="14dp"
                                                android:background="@drawable/top_side_curve_light_blue"
                                                android:backgroundTint="#D2ECFF">
                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text="Term 1 : ₹40,000"
                                                    android:textColor="#003A63"
                                                    android:textSize="12sp"
                                                    style="@style/FontRegular"
                                                    android:layout_weight="1"/>
                                                <ImageView
                                                    android:id="@+id/upWard"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:background="@drawable/ic_drop_down"
                                                    android:backgroundTint="#124090"/>
                                            </LinearLayout>
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:id="@+id/topBg"
                                                android:paddingHorizontal="14dp"
                                                android:background="@drawable/border_curve_8dp"
                                                android:orientation="vertical">
                                                <LinearLayout
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:paddingVertical="6dp"
                                                    android:orientation="horizontal">
                                                    <TextView
                                                        android:layout_width="0dp"
                                                        android:layout_height="wrap_content"
                                                        android:layout_weight="1"
                                                        android:text="Tuition Fee"
                                                        style="@style/FontRegular"
                                                        android:textSize="12sp"
                                                        android:textColor="#868686"/>
                                                    <TextView
                                                        android:layout_width="0dp"
                                                        android:layout_height="wrap_content"
                                                        android:layout_weight="1"
                                                        android:gravity="right"
                                                        android:textColor="#111111"
                                                        android:text="₹15,000"
                                                        style="@style/FontRegular"
                                                        android:textSize="12sp" />

                                                </LinearLayout>
                                                <View
                                                    android:layout_width="match_parent"
                                                    android:layout_height="1.4dp"
                                                    android:background="@drawable/dash_line"
                                                    android:backgroundTint="#E1EBED"/>
                                                <LinearLayout
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:paddingVertical="6dp"
                                                    android:orientation="horizontal">
                                                    <TextView
                                                        android:layout_width="0dp"
                                                        android:layout_height="wrap_content"
                                                        android:layout_weight="1"
                                                        android:text="Book Fee"
                                                        style="@style/FontRegular"
                                                        android:textSize="12sp"
                                                        android:textColor="#868686"/>
                                                    <TextView
                                                        android:layout_width="0dp"
                                                        android:layout_height="wrap_content"
                                                        android:layout_weight="1"
                                                        android:gravity="right"
                                                        android:textColor="#111111"
                                                        android:text="₹10,000"
                                                        style="@style/FontRegular"
                                                        android:textSize="12sp" />
                                                </LinearLayout>
                                                <View
                                                    android:layout_width="match_parent"
                                                    android:layout_height="1.4dp"
                                                    android:background="@drawable/dash_line"
                                                    android:backgroundTint="#E1EBED"/>
                                                <LinearLayout
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:paddingVertical="6dp"
                                                    android:orientation="horizontal">
                                                    <TextView
                                                        android:layout_width="0dp"
                                                        android:layout_height="wrap_content"
                                                        android:layout_weight="1"
                                                        android:text="lab Fee"
                                                        style="@style/FontRegular"
                                                        android:textSize="12sp"
                                                        android:textColor="#868686"/>
                                                    <TextView
                                                        android:layout_width="0dp"
                                                        android:layout_height="wrap_content"
                                                        android:layout_weight="1"
                                                        android:gravity="right"
                                                        android:textColor="#111111"
                                                        android:text="₹5,000"
                                                        style="@style/FontRegular"
                                                        android:textSize="12sp" />
                                                </LinearLayout>
                                                <View
                                                    android:layout_width="match_parent"
                                                    android:layout_height="1.4dp"
                                                    android:background="@drawable/dash_line"
                                                    android:backgroundTint="#E1EBED"/>
                                                <LinearLayout
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:paddingVertical="6dp"
                                                    android:orientation="horizontal">
                                                    <TextView
                                                        android:layout_width="0dp"
                                                        android:layout_height="wrap_content"
                                                        android:layout_weight="1"
                                                        android:text="Exam Fee"
                                                        style="@style/FontRegular"
                                                        android:textSize="12sp"
                                                        android:textColor="#868686"/>
                                                    <TextView
                                                        android:layout_width="0dp"
                                                        android:layout_height="wrap_content"
                                                        android:layout_weight="1"
                                                        android:gravity="right"
                                                        android:textColor="#111111"
                                                        android:text="₹5,000"
                                                        style="@style/FontRegular"
                                                        android:textSize="12sp" />
                                                </LinearLayout>
                                                <View
                                                    android:layout_width="match_parent"
                                                    android:layout_height="1.4dp"
                                                    android:background="@drawable/dash_line"
                                                    android:backgroundTint="#E1EBED"/>
                                                <LinearLayout
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:paddingVertical="6dp"
                                                    android:orientation="horizontal">
                                                    <TextView
                                                        android:layout_width="0dp"
                                                        android:layout_height="wrap_content"
                                                        android:layout_weight="1"
                                                        android:text="Uniform Fee"
                                                        style="@style/FontRegular"
                                                        android:textSize="12sp"
                                                        android:textColor="#868686"/>
                                                    <TextView
                                                        android:layout_width="0dp"
                                                        android:layout_height="wrap_content"
                                                        android:layout_weight="1"
                                                        android:gravity="right"
                                                        android:textColor="#111111"
                                                        android:text="₹5,000"
                                                        style="@style/FontRegular"
                                                        android:textSize="12sp" />
                                                </LinearLayout>
                                            </LinearLayout>
                                        </LinearLayout>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center"
                                        android:visibility="visible"
                                        android:paddingVertical="10dp"
                                        android:paddingHorizontal="14dp"
                                        android:layout_marginTop="6dp"
                                        android:background="@drawable/border_curve_4dp_very_light_blue"
                                        android:backgroundTint="#E4F5FF">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Term 2: ₹30,000"
                                            android:textColor="#003A63"
                                            android:textSize="12sp"
                                            style="@style/FontRegular"
                                            android:layout_weight="1"/>
                                        <ImageView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:background="@drawable/ic_drop_down"
                                            android:backgroundTint="#124090"/>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center"
                                        android:visibility="visible"
                                        android:paddingVertical="10dp"
                                        android:paddingHorizontal="14dp"
                                        android:layout_marginTop="6dp"
                                        android:background="@drawable/border_curve_4dp_very_light_blue"
                                        android:backgroundTint="#E4F5FF">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Term 3: ₹30,000"
                                            android:textColor="#003A63"
                                            android:textSize="12sp"
                                            style="@style/FontRegular"
                                            android:layout_weight="1"/>
                                        <ImageView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:background="@drawable/ic_drop_down"
                                            android:backgroundTint="#124090"/>
                                    </LinearLayout>
                                </LinearLayout>
                                <com.google.android.material.tabs.TabLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/tab_layout"
                                    app:tabMaxWidth="0dp"
                                    android:layout_marginTop="8dp"
                                    android:paddingStart="14dp"
                                    app:tabRippleColor="@color/transparent"
                                    app:tabIndicatorHeight="3dp"
                                    app:tabGravity="fill"
                                    app:tabIndicatorFullWidth="true"
                                    app:tabIndicatorColor="@color/colorPrimary"
                                    app:tabSelectedTextColor="@color/colorPrimary"
                                    app:tabTextColor="@color/black_varient3"/>
                                <LinearLayout
                                    android:id="@+id/term1Page"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:orientation="horizontal">
                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:id="@+id/boardType"
                                            android:padding="4dp"
                                            android:gravity="center">
                                            <TextView
                                                android:id="@+id/cbseTap"
                                                style="@style/FontRegular"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:paddingHorizontal="12dp"
                                                android:paddingVertical="4dp"
                                                android:background="@drawable/border_line_curve_4dp_primary"
                                                android:text="1st Std ‘A’ sec"
                                                android:textColor="@color/black"
                                                android:textSize="@dimen/_12sp" />
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:id="@+id/icseTap"
                                                android:text="1st Std ‘B’ Sec"
                                                android:layout_marginStart="6dp"
                                                android:background="@drawable/border_line_curve_4dp_grey"
                                                style="@style/FontRegular"
                                                android:textColor="@color/black_varient6"
                                                android:paddingHorizontal="12dp"
                                                android:paddingVertical="4dp"
                                                android:textSize="@dimen/_14sp"
                                                android:drawablePadding="10dp"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:gravity="center"
                                        android:id="@+id/search_lay"
                                        android:layout_marginTop="8dp"
                                        android:layout_height="wrap_content">
                                        <EditText
                                            android:layout_width="0dp"
                                            android:layout_weight="1"
                                            android:layout_height="wrap_content"
                                            android:hint="Search"
                                            style="@style/FontRegular"
                                            android:textSize="@dimen/_14sp"
                                            android:layout_marginEnd="10dp"
                                            android:inputType="text"
                                            android:id="@+id/search"
                                            android:singleLine="true"
                                            android:imeOptions="actionSearch"
                                            android:drawableStart="@drawable/ic_search"
                                            android:drawablePadding="10dp"
                                            android:paddingVertical="8dp"
                                            android:paddingHorizontal="20dp"
                                            android:textColor="@color/black"
                                            android:background="@drawable/border_line_curve_10dp_bg_gray"/>
                                        <ImageView
                                            android:layout_width="50dp"
                                            android:layout_height="50dp"
                                            android:id="@+id/feefiltr"
                                            android:src="@drawable/filter" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:id="@+id/feeCards"
                                        android:layout_width="match_parent"
                                        android:layout_marginTop="8dp"
                                        android:orientation="vertical"
                                        android:layout_height="wrap_content">
                                        <androidx.recyclerview.widget.RecyclerView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:visibility="gone"
                                            android:id="@+id/financeRecyclerView"/>

                                        <include
                                            android:visibility="gone"
                                            layout="@layout/card_admin_finance_fees"/>
                                        <include
                                            android:visibility="gone"
                                            android:id="@+id/overDueReceipt"
                                            layout="@layout/card_admin_finance_fees"/>
                                        <include
                                            android:visibility="gone"
                                            android:id="@+id/paidReceipt"
                                            layout="@layout/card_admin_finance_fees"/>

                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.core.widget.NestedScrollView>
                        <include
                            android:visibility="gone"
                            android:id="@+id/dialogFeeReceipt"
                            layout="@layout/dialog_fee_student_report"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>