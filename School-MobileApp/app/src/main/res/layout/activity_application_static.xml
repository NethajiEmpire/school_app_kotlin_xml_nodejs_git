<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/otp_rec"
    android:fitsSystemWindows="true"
    tools:context=".activity.ApplicationStaticActivity">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:id="@+id/back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:src="@drawable/back_arrow"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="180dp"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/bg_img"/>
        <ImageView
            android:layout_width="260dp"
            android:layout_height="120dp"
            app:layout_constraintTop_toTopOf="@id/bg_img"
            app:layout_constraintBottom_toBottomOf="@id/bg_img"
            app:layout_constraintStart_toStartOf="@id/bg_img"
            app:layout_constraintEnd_toEndOf="@id/bg_img"
            android:id="@+id/logo"
            android:src="@drawable/vista_academy_logo"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="40dp"
            android:layout_marginBottom="-40dp"
            app:layout_constraintTop_toBottomOf="@id/bg_img"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:layout_marginBottom="40dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01 of 06"
                    style="@style/FontRegular"
                    android:id="@+id/steps"
                    android:textSize="14sp"
                    android:textColor="#89879C"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:weightSum="6">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="12dp"
                        android:layout_weight="1">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:id="@+id/view1"
                            android:background="#D9D9D9"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="12dp"
                        android:layout_weight="1">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:id="@+id/view2"
                            android:background="#D9D9D9"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="12dp"
                        android:layout_weight="1">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:id="@+id/view3"
                            android:background="#D9D9D9"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="12dp"
                        android:layout_weight="1">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:id="@+id/view4"
                            android:background="#D9D9D9"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:id="@+id/view5"
                            android:background="#D9D9D9"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="12dp"
                        android:layout_weight="1">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:id="@+id/view6"
                            android:background="#D9D9D9"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student Information"
                    style="@style/FontMedium"
                    android:layout_marginTop="8dp"
                    android:textSize="18sp"
                    android:id="@+id/title"
                    android:textColor="#4B4B4B"/>
                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recycler"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="8dp"
                            android:visibility="visible"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:listitem="@layout/card_guest" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:id="@+id/lin_doc_verify"
                            android:visibility="gone"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                style="@style/FontRegular"
                                android:gravity="start"
                                android:textSize="16sp"
                                android:id="@+id/txt_title_show1"
                                android:textColor="#A2A9B7"
                                android:text="Your fee payment has been successfully submitted and is now under review."/>
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_students_vector"
                                android:layout_marginVertical="10dp"/>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:paddingVertical="10dp"
                                android:background="@drawable/border_line_curve_8dp_light_blue"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Pending Admin Approval"
                                    style="@style/FontMedium"
                                    android:textSize="16sp"
                                    android:textColor="#E34747"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="#717171"
                                    style="@style/FontRegular"
                                    android:textSize="14sp"
                                    android:id="@+id/txt_title_show2"
                                    android:gravity="center"
                                    android:paddingHorizontal="8dp"
                                    android:layout_marginTop="10dp"
                                    android:text="Our administrative team is verifying your payment details. This process may take up to 01 or 02 working days. You will receive a confirmation via email/SMS once approved."/>
                            </LinearLayout>
                        </LinearLayout>
                        <include
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:id="@+id/include_payment"
                            layout="@layout/card_payment_details"/>
                        <include
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:id="@+id/include_acknow"
                            layout="@layout/card_acknowledgement"/>
                        <include
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:id="@+id/no_data"
                            layout="@layout/layout_no_data_found"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Next"
                            style="@style/FontRegular"
                            android:id="@+id/next"
                            android:background="@drawable/ic_button_bg"
                            android:paddingVertical="14dp"
                            android:layout_marginVertical="22dp"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:textColor="@color/white"/>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <include
            android:id="@+id/spinnerList"
            android:visibility="gone"
            layout="@layout/custom_search_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>