<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/otp_rec"
    tools:context=".activity.AssignmentActivity">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:orientation="vertical">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/header">
          <androidx.constraintlayout.widget.ConstraintLayout
              android:layout_width="match_parent"
              app:layout_constraintTop_toTopOf="parent"
              app:layout_constraintBottom_toBottomOf="parent"
              android:paddingVertical="14dp"
              android:id="@+id/top"
              android:paddingHorizontal="16dp"
              android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/backarrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginEnd="10dp"
                android:background="@drawable/back_arrow"/>
            <TextView
                android:layout_marginStart="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/backarrow"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textSize="@dimen/_16sp"
                android:textColor="@color/colorPrimary"
                style="@style/FontMedium"
                android:text="Assignment"/>
            <ImageView
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:id="@+id/notify"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginEnd="12dp"
                android:visibility="gone"
                android:src="@drawable/dash_notification"/>
          </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="25dp"
            android:layout_marginBottom="-25dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="25dp"
                android:orientation="vertical">
              <androidx.constraintlayout.widget.ConstraintLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="vertical">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/parentcn"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                  <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      app:layout_constraintTop_toTopOf="parent"
                      android:layout_marginBottom="8dp"
                      app:layout_constraintBottom_toBottomOf="parent"
                      android:background="@drawable/border_line_curve_10dp_grey">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                      <LinearLayout
                          android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                          <TextView
                              android:id="@+id/title"
                              style="@style/FontMedium"
                              app:layout_constraintStart_toStartOf="parent"
                              app:layout_constraintTop_toTopOf="parent"
                              android:layout_width="wrap_content"
                              android:textSize="@dimen/_16sp"
                              android:maxLines="2"
                              android:ellipsize="end"
                              android:layout_height="wrap_content"
                              android:text="Linear Equations Assignment"
                              android:textColor="#333333" />
                          <TextView
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:id="@+id/date"
                              android:textSize="@dimen/_12sp"
                              android:layout_marginTop="4dp"
                              style="@style/FontRegular"
                              android:drawablePadding="4dp"
                              android:gravity="center"
                              android:drawableStart="@drawable/hugeicons_date_time_green"
                              app:layout_constraintStart_toStartOf="parent"
                              app:layout_constraintTop_toBottomOf="@id/subjectName"
                              android:textColor="#666666"
                              android:text="Wed, Jun 23, 2025 - Fri, Jun 25, 2025"/>
                        </LinearLayout>
                        <TextView
                            android:visibility="gone"
                            android:id="@+id/status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/border_curve_24dp"
                            android:backgroundTint="#DAE7FF"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            style="@style/FontRegular"
                            android:paddingVertical="4dp"
                            android:layout_gravity="center"
                            android:textSize="@dimen/_12sp"
                            android:text="Ongoing"
                            android:textColor="#3F8BFB" />

                        <!-- <androidx.constraintlayout.widget.ConstraintLayout
                             android:layout_width="0dp"
                             android:layout_weight="1"
                             android:layout_height="wrap_content"
                             android:padding="4dp"
                             android:layout_marginStart="8dp"
                             android:orientation="vertical">
                             <TextView
                                 android:id="@+id/subjectName"
                                 style="@style/FontMedium"
                                 app:layout_constraintStart_toStartOf="parent"
                                 app:layout_constraintTop_toTopOf="parent"
                                 android:layout_width="0dp"
                                 android:textSize="12sp"
                                 android:layout_height="wrap_content"
                                 android:ellipsize="end"
                                 android:maxLines="2"
                                 android:text="English"
                                 android:textColor="#333333" />
                             <TextView
                                 android:layout_width="wrap_content"
                                 android:layout_height="wrap_content"
                                 android:id="@+id/teacherName"
                                 android:textSize="12sp"
                                 style="@style/FontMedium"
                                 app:layout_constraintStart_toStartOf="parent"
                                 app:layout_constraintTop_toBottomOf="@id/subjectName"
                                 android:textColor="#828282"
                                 android:text="Mrs. Anitha"/>
                         </androidx.constraintlayout.widget.ConstraintLayout>-->

                        <!-- <TextView
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:background="@drawable/border_curve_24dp"
                             android:backgroundTint="#DAE7FF"
                             android:paddingHorizontal="14dp"
                             android:paddingVertical="3dp"
                             style="@style/FontRegular"
                             android:id="@+id/assignmentStatus"
                             android:textSize="@dimen/_12sp"
                            android:layout_gravity="center"
                             android:text="New Assignment"
                             android:textColor="#3F8BFB" />-->

                      </LinearLayout>
                      <View
                          android:layout_width="match_parent"
                          android:layout_height=".7dp"
                          android:layout_marginTop="6dp"
                          android:background="#EFEFEF"/>
                      <com.lms.sch.customviews.SeeMoreTextView
                          android:id="@+id/desc"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:textColor="#8F8F8F"
                          style="@style/FontRegular"
                          android:textSize="@dimen/_12sp"
                          android:maxLines="2"
                          android:ellipsize="end"
                          android:layout_marginTop="6dp"
                          android:text="Write a 150-word essay about your favorite festival. Mention why you like it, how it's celebrated, and..."/>
                      <View
                          android:layout_width="match_parent"
                          android:layout_height=".7dp"
                          android:layout_marginTop="6dp"
                          android:background="#EFEFEF"/>
                      <LinearLayout
                          android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:orientation="horizontal"
                          android:layout_gravity="center"
                          android:layout_marginTop="6dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1">
                          <TextView
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:text="Mathematics"
                              android:drawableStart="@drawable/books"
                              android:paddingVertical="4dp"
                              android:drawablePadding="3dp"
                              android:paddingHorizontal="16dp"
                              style="@style/FontRegular"
                              android:id="@+id/subject"
                              android:textSize="@dimen/_14sp"
                              android:textColor="#348F23"/>
                          <TextView
                              android:visibility="gone"
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:text="View Doc"
                              android:id="@+id/viewDoc"
                              android:drawableEnd="@drawable/ic_next"
                              android:drawableTint="#348f23"
                              android:layout_marginStart="16dp"
                              android:drawablePadding="4dp"
                              style="@style/FontRegular"
                              android:textSize="@dimen/_12sp"
                              android:textColor="#348F23"/>
                        </LinearLayout>
                      </LinearLayout>
                    </LinearLayout>
                  </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
              </androidx.constraintlayout.widget.ConstraintLayout>
              <LinearLayout
                  android:id="@+id/search_lay"
                  android:layout_width="match_parent"
                  android:gravity="center"
                  android:layout_marginBottom="4dp"
                  android:paddingVertical="8dp"
                  android:paddingHorizontal="10dp"
                  app:layout_constraintTop_toBottomOf="@id/line1"
                  android:layout_height="wrap_content">
                <EditText
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="Search"
                    style="@style/FontRegular"
                    android:textSize="@dimen/_14sp"
                    android:layout_marginEnd="10dp"
                    android:inputType="text"
                    android:id="@+id/search"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="10dp"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="20dp"
                    android:textColor="@color/grey"
                    android:background="@drawable/border_line_curve_8dp_grey"/>
                <ImageView
                    android:id="@+id/filter"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_filter_blue"/>
              </LinearLayout>
              <HorizontalScrollView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:scrollbars="none"
                  android:visibility="gone"
                  android:layout_marginBottom="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="16dp"
                    android:orientation="horizontal">
                  <LinearLayout
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:id="@+id/tabAllLay"
                      android:layout_marginEnd="8dp"
                      android:padding="4dp"
                      android:background="@drawable/border_line_curve_24dp_grey"
                      android:gravity="center">
                    <TextView
                        android:id="@+id/tabAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        style="@style/FontRegular"
                        android:textColor="@color/black_varient6"
                        android:paddingHorizontal="16dp"
                        android:textSize="@dimen/_14sp"
                        android:drawablePadding="10dp"/>
                  </LinearLayout>
                  <LinearLayout
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:id="@+id/tabPendingLay"
                      android:layout_marginEnd="8dp"
                      android:padding="4dp"
                      android:background="@drawable/border_line_curve_24dp_grey"
                      android:gravity="center">
                    <TextView
                        android:id="@+id/tabPending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Marks Pending"
                        style="@style/FontRegular"
                        android:textColor="@color/black_varient6"
                        android:paddingHorizontal="6dp"
                        android:textSize="@dimen/_14sp"
                        android:drawablePadding="10dp"/>
                  </LinearLayout>
                  <LinearLayout
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:id="@+id/tabCompletedLay"
                      android:padding="4dp"
                      android:background="@drawable/border_line_curve_24dp_primary"
                      android:gravity="center">
                    <TextView
                        android:id="@+id/tabCompleted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Marks Updated"
                        android:paddingHorizontal="6dp"
                        style="@style/FontRegular"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_14sp"
                        android:drawablePadding="10dp"/>
                  </LinearLayout>
                </LinearLayout>
              </HorizontalScrollView>
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="match_parent"
                  android:orientation="vertical">
              <include
                  android:id="@+id/no_data1"
                  layout="@layout/layout_no_data_found"
                  android:visibility="gone"/>
              <androidx.recyclerview.widget.RecyclerView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:padding="8dp"
                  android:id="@+id/assignmentRecycler"/>
              </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
      </LinearLayout>
  </LinearLayout>
  <include
      android:visibility="gone"
      android:id="@+id/dialogMarkUpdate"
      layout="@layout/dialog_assingment_mark_upload"/>
  <include
      android:visibility="gone"
      android:id="@+id/dialogMarkResult"
      layout="@layout/dialog_marksheet"/>
  </androidx.constraintlayout.widget.ConstraintLayout>