<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/main"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@drawable/otp_rec"
android:fitsSystemWindows="true"
tools:context=".activity.AssignmentResActivity">
<LinearLayout
    android:id="@+id/subjectProgress"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingVertical="16dp"
            android:id="@+id/top"
            android:paddingHorizontal="16dp"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/back_dash"
                android:id="@+id/backarrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <TextView
                android:layout_marginStart="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/backarrow"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textSize="18dp"
                android:textColor="@color/colorPrimary"
                style="@style/FontMedium"
                android:text="Assignment"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="25dp"
            android:layout_marginBottom="-30dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="30dp"
                android:orientation="vertical">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/sub" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="8dp"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/subject"
                                        style="@style/FontRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Subject   :  English"
                                        android:textColor="@color/black_varient3"
                                        android:textSize="@dimen/_14sp" />

                                    <TextView
                                        android:id="@+id/teacher"
                                        style="@style/FontRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="Teacher  : Mrs Anitha"
                                        android:textColor="@color/black_varient3"
                                        android:textSize="@dimen/_14sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="end"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/status"
                                        style="@style/FontRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/border_line_curve"
                                        android:paddingHorizontal="12dp"
                                        android:paddingVertical="2dp"
                                        android:text="Ongoing"
                                        android:textColor="#3F8BFB"
                                        android:textSize="@dimen/_12sp" />

                                    <TextView
                                        android:id="@+id/points"
                                        style="@style/FontRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="+2 points"
                                        android:textColor="@color/blue"
                                        android:textSize="@dimen/_12sp" />

                                </LinearLayout>

                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_alignBottom="@+id/homeworktext"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/dash_line"
                            android:backgroundTint="#F0F0F0" />

                        <RelativeLayout
                            android:id="@+id/relp2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:paddingVertical="8dp">

                            <TextView
                                android:id="@+id/givenOn"
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:paddingVertical="2dp"
                                android:text="Given On : "
                                android:textColor="#868686"
                                android:textSize="@dimen/_12sp" />

                            <TextView
                                android:id="@+id/givendate"
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_toRightOf="@id/givenOn"
                                android:paddingVertical="2dp"
                                android:text="20-04-2025"
                                android:textColor="#4F4F4F"
                                android:textSize="@dimen/_14sp" />

                            <TextView
                                android:id="@+id/submitOn"
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_toLeftOf="@id/submitdate"
                                android:paddingVertical="2dp"
                                android:text="Submitted On : "
                                android:textColor="#868686"
                                android:textSize="@dimen/_12sp" />

                            <TextView
                                android:id="@+id/submitdate"
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:paddingVertical="2dp"
                                android:text="24-04-2025"
                                android:textColor="#4F4F4F"
                                android:textSize="@dimen/_14sp" />
                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_alignBottom="@+id/homeworktext"
                            android:background="@drawable/dash_line"
                            android:backgroundTint="#F0F0F0" />

                        <LinearLayout
                            android:id="@+id/result_lay"
                            android:layout_width="match_parent"
                            android:layout_height="100.5dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/project_res_background"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:visibility="gone">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/border_line_curve_6dp_gray"
                                android:orientation="vertical"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="18dp">
                                <TextView
                                    style="@style/FontRegular"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Your Mark"
                                    android:textColor="#232B68"
                                    android:textSize="@dimen/_16sp" />
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/sMarks"
                                        style="@style/FontRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" 08 "
                                        android:textColor="#32B138"
                                        android:textSize="@dimen/_16sp" />

                                    <TextView
                                        android:id="@+id/tMarks"
                                        style="@style/FontRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="/ 10"
                                        android:textColor="#32B138"
                                        android:textSize="@dimen/_16sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="10dp"
                            android:visibility="gone"
                            android:background="@drawable/border_line_curve_8dp_light_blue"
                            android:orientation="vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="10dp">
                            <TextView
                                android:id="@+id/assTitlelbl"
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="Title :- "
                                android:textColor="#868686"
                                android:textSize="@dimen/_12sp" />
                            <TextView
                                android:id="@+id/assTitle1"
                                style="@style/FontMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="Write an essay on ''My Favorite Festival"
                                android:textColor="#232B68"
                                android:textSize="@dimen/_14sp" />

                            <TextView
                                android:id="@+id/dec"
                                style="@style/FontMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="Description :- "
                                android:textColor="#868686"
                                android:textSize="@dimen/_12sp" />

                            <com.lms.sch.customviews.SeeMoreTextView
                                android:id="@+id/assdsc1"
                                style="@style/FontMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Write a short essay about your favorite festival."
                                android:textColor="#232B68"
                                android:textSize="@dimen/_14sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:background="@drawable/border_line_curve_8dp_light_blue">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="start|center_vertical">
                                <TextView
                                    android:id="@+id/que1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Title: "
                                    android:textColor="#212121"
                                    android:textSize="@dimen/_14sp"
                                    style="@style/FontMedium"
                                    android:ellipsize="end" />
                                <com.lms.sch.customviews.SeeMoreTextView
                                    android:id="@+id/assTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Write an essay on My Favorite Festival"
                                    android:textColor="#1976D2"
                                    android:textSize="@dimen/_13sp"
                                    style="@style/FontRegular"
                                    android:maxLines="2"
                                    android:ellipsize="end" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/que3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Description: "
                                android:textColor="#212121"
                                android:textSize="@dimen/_14sp"
                                style="@style/FontMedium"
                                android:maxLines="1"
                                android:ellipsize="end" />
                            <com.lms.sch.customviews.SeeMoreTextView
                                android:id="@+id/assdsc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Write a short essay about your favorite festival. You can talk about how you celebrate it, why you love it, any special foods, clothes, or traditions you follow, and how it makes you feel. Try to keep it personal and creative!"
                                android:textColor="#424242"
                                android:textSize="@dimen/_12sp"
                                style="@style/FontRegular"
                                android:ellipsize="end" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/noteLay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/border_line_curve_10dp_grey"
                            android:backgroundTint="#FFF2F2"
                            android:orientation="vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="10dp">
                            <TextView
                                style="@style/FontMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Note*"
                                android:textColor="#5A5A5A"
                                android:textSize="@dimen/_14sp" />

                            <TextView
                                android:id="@+id/note"
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Don't forget! You need to complete and submit before the due date to earn points, if you miss the deadline, you won't receive any marks."
                                android:textColor="#5A5A5A"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/border_line_curve_10dp_grey"
                            android:backgroundTint="#FFF2F2"
                            android:orientation="vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="10dp"
                            android:visibility="gone">

                            <TextView
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingVertical="4dp"
                                android:text="Note*"
                                android:textColor="#5A5A5A"
                                android:textSize="@dimen/_14sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="horizontal"
                                android:paddingVertical="4dp">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/border_line_green_1dp"
                                    android:paddingHorizontal="4dp"
                                    android:paddingVertical="4dp"
                                    android:src="@drawable/hugeicons_tick_01" />

                                <TextView
                                    style="@style/FontRegular"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="4dp"
                                    android:text="You’ve marked this homework as completed. If you tapped it by mistake, just uncheck and click Done again to update."
                                    android:textColor="#5A5A5A"
                                    android:textSize="@dimen/_14sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/upload_lay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">
                            <TextView
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Upload Your Home Work"
                                android:textColor="@color/black_varient3"
                                android:textSize="@dimen/_12sp" />
                            <TextView
                                android:id="@+id/attach"
                                style="@style/FontRegular"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/border_line_curve_8dp_light_blue"
                                android:drawableEnd="@drawable/prime_upload"
                                android:hint="Choose File"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="12dp"
                                android:textColor="#868686"
                                android:textSize="14sp" />
                            <TextView
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="left"
                                android:layout_marginTop="2dp"
                                android:text="* Maximum size 5Mb"
                                android:textColor="#E34747"
                                android:textSize="@dimen/_12sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/attach_lay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/uploadTxtt"
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Uploaded Home Work"
                                android:textColor="#868686"
                                android:textSize="@dimen/_14sp" />
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/attachRecycler"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginVertical="8dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/remarkLay"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sp"
                                android:layout_marginTop="12dp"
                                style="@style/FontRegular"
                                android:textColor="#5A5A5A"
                                android:text="Teacher Remarks"/>
                            <TextView
                                android:background="@drawable/border_line_curve_8dp_light_blue"
                                android:layout_width="match_parent"
                                android:paddingVertical="8dp"
                                android:paddingHorizontal="10dp"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sp"
                                android:layout_marginTop="4dp"
                                style="@style/FontRegular"
                                android:id="@+id/remarks"
                                android:textColor="@color/colorPrimary"
                                android:text="--/--"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/doneHw"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="12dp"
                            android:paddingHorizontal="8dp"
                            android:textSize="@dimen/_14sp"
                            android:visibility="gone"
                            style="@style/FontDefault"
                            android:textAlignment="center"
                            android:layout_marginTop="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/ic_button_bg"
                            android:text="Done"
                            android:textColor="#FFFFFF"/>
                        <TextView
                            android:id="@+id/doneAssingment"
                            style="@style/FontRegular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_weight="1"
                            android:background="@drawable/ic_button_bg"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="12dp"
                            android:text="Done"
                            android:textAlignment="center"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_14sp"
                            android:visibility="gone" />
                        <LinearLayout
                            android:id="@+id/okCancel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <TextView
                                android:id="@+id/cancel"
                                style="@style/FontRegular"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:layout_weight="1"
                                android:background="@drawable/border_line_curve_4dp_navy_blue"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="12dp"
                                android:text="Cancel"
                                android:textAlignment="center"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/_14sp" />

                            <TextView
                                android:id="@+id/makeasdone"
                                style="@style/FontRegular"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/border_line_curve_4dp_navy_blue"
                                android:backgroundTint="#232B68"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="12dp"
                                android:text="Make As Done"
                                android:textAlignment="center"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/_14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>