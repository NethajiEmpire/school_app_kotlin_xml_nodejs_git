<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/otp_rec"
    android:fitsSystemWindows="true"
    tools:context=".activity.HomeWorkActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/header">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:paddingVertical="14dp"
                    android:id="@+id/top"
                    android:paddingHorizontal="16dp"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/backarrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:background="@drawable/back_arrow"/>
                    <TextView
                        android:layout_marginStart="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toEndOf="@id/backarrow"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:textSize="@dimen/_16sp"
                        android:textColor="@color/colorPrimary"
                        style="@style/FontMedium"
                        android:text="Home Work"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        android:id="@+id/notify"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_marginEnd="12dp"
                        app:layout_constraintEnd_toStartOf="@id/profile"
                        android:src="@drawable/dash_notification"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:id="@+id/profile"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:src="@drawable/ic_user_profile"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardElevation="0dp"
                android:layout_marginBottom="-30dp"
                app:cardCornerRadius="25dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="30dp"
                    android:orientation="vertical">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/parentcn"
                            android:layout_marginTop="12dp"
                            android:layout_marginHorizontal="12dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:cardCornerRadius="10dp"
                                android:background="@drawable/border_line_curve_10dp_grey"
                                android:layout_marginBottom="8dp"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:padding="12dp">
                                        <LinearLayout
                                            android:visibility="gone"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentEnd="true"
                                            android:layout_centerVertical="true">
                                            <ImageView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginEnd="6dp"
                                                android:id="@+id/checkBoxStatus"
                                                android:src="@drawable/rectangle_checkbox"/>
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Mark as done"
                                                android:id="@+id/txt"
                                                style="@style/FontRegular"
                                                android:textSize="12sp"
                                                android:textColor="@color/black_varient6"/>
                                        </LinearLayout>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Mathematics"
                                            android:drawableTint="#348f23"
                                            android:drawablePadding="4dp"
                                            android:drawableStart="@drawable/books"
                                            android:layout_alignParentStart="true"
                                            android:layout_centerVertical="true"
                                            android:background="@drawable/border_curve_16dp"
                                            android:backgroundTint="#3360F645"
                                            android:paddingVertical="4dp"
                                            android:paddingHorizontal="16dp"
                                            style="@style/FontRegular"
                                            android:id="@+id/subject"
                                            android:textSize="@dimen/_12sp"
                                            android:textColor="#348F23"/>
                                    </RelativeLayout>
                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height=".7dp"
                                        android:background="#EFEFEF"/>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:paddingHorizontal="12dp"
                                        android:paddingVertical="8dp"
                                        android:orientation="vertical"
                                        android:layout_height="wrap_content">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Chapter 5 - Algebra Worksheet"
                                            android:id="@+id/title"
                                            android:singleLine="true"
                                            style="@style/FontMedium"
                                            android:textSize="16sp"
                                            android:textColor="@color/black_varient3"/>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content">
                                            <ImageView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginEnd="6dp"
                                                android:id="@+id/notes"
                                                android:layout_gravity="center"
                                                android:src="@drawable/description"/>
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Solve the given set of algebraic equations."
                                                android:id="@+id/desc"
                                                android:singleLine="true"
                                                android:layout_gravity="center"
                                                style="@style/FontRegular"
                                                android:textSize="12sp"
                                                android:textColor="@color/black_varient6"/>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:visibility="gone"
                                            android:layout_marginTop="10dp">
                                            <ImageView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginEnd="6dp"
                                                android:src="@drawable/codex_file"/>
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Reference - Chapter 4 - Algebraic Expressions (Textbook Pg. 56-65)"
                                                android:layout_gravity="center"
                                                style="@style/FontDefault"
                                                android:textSize="12sp"
                                                android:textColor="@color/black_varient3"/>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="8dp"
                                            android:gravity="center"
                                            android:orientation="horizontal">
                                            <ImageView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:id="@+id/icon"
                                                android:src="@drawable/ic_date"/>
                                            <TextView
                                                android:id="@+id/date"
                                                android:layout_weight="1"
                                                android:layout_width="0dp"
                                                android:layout_gravity="center"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/_10sp"
                                                android:layout_marginStart="6dp"
                                                style="@style/FontRegular"
                                                android:textColor="@color/black_varient6"
                                                android:text="Wed, Jun 23, 2025 - Fri, Jun 25, 2025"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    <LinearLayout
                        android:id="@+id/search_lay"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="12dp"
                        app:layout_constraintTop_toBottomOf="@id/line1"
                        android:layout_height="wrap_content">
                        <EditText
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Search"
                            style="@style/FontRegular"
                            android:textSize="@dimen/_14sp"
                            android:layout_marginEnd="10dp"
                            android:inputType="text"
                            android:id="@+id/search"
                            android:singleLine="true"
                            android:imeOptions="actionSearch"
                            android:drawableStart="@drawable/ic_search"
                            android:drawablePadding="10dp"
                            android:paddingVertical="10dp"
                            android:paddingHorizontal="20dp"
                            android:textColor="@color/grey"
                            android:background="@drawable/border_line_curve_8dp_grey"/>
                        <ImageView
                            android:id="@+id/filter"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_filter_blue"/>
                    </LinearLayout>
                    <HorizontalScrollView
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="10dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingLeft="12dp"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/tabAllLay"
                                android:layout_marginEnd="8dp"
                                android:padding="4dp"
                                android:background="@drawable/border_line_curve_24dp_grey"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/tabAll"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="All"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient6"
                                    android:paddingHorizontal="16dp"
                                    android:textSize="@dimen/_14sp"
                                    android:drawablePadding="10dp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/tabPendingLay"
                                android:layout_marginEnd="8dp"
                                android:padding="4dp"
                                android:background="@drawable/border_line_curve_24dp_grey"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/tabPending"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Remarks Pending"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient6"
                                    android:paddingHorizontal="6dp"
                                    android:textSize="@dimen/_14sp"
                                    android:drawablePadding="10dp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/tabCompletedLay"
                                android:padding="4dp"
                                android:background="@drawable/border_line_curve_24dp_primary"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/tabCompleted"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Remarks Updated"
                                    android:paddingHorizontal="6dp"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_14sp"
                                    android:drawablePadding="10dp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </HorizontalScrollView>
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:id="@+id/recycler"/>
                    <include
                        android:id="@+id/noData"
                        android:visibility="gone"
                        layout="@layout/layout_no_data_found"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
    <include
        android:visibility="gone"
        android:id="@+id/dialogMarkUpdate"
        layout="@layout/dialog_hw_mark_upload"/>
    <include
        android:visibility="gone"
        android:id="@+id/dialogMarkShow"
        layout="@layout/dialog_marksheet"/>
</androidx.constraintlayout.widget.ConstraintLayout>