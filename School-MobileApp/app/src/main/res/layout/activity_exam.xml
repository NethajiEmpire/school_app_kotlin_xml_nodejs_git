<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activity.ExamActivity">
    <LinearLayout
        android:id="@+id/createhomework"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/headertwo"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/header">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="126dp"
                    android:id="@+id/banner"
                    android:scaleType="centerCrop"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:src="@drawable/dash_rec"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:paddingVertical="12dp"
                    android:id="@+id/top"
                    android:paddingHorizontal="16dp"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/backarrow"
                        android:layout_width="25dp"
                        android:layout_height="18dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/ic_back_arrow"
                        android:backgroundTint="@color/colorPrimary"/>
                    <TextView
                        android:layout_marginStart="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toEndOf="@id/backarrow"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:textSize="18dp"
                        android:textColor="@color/colorPrimary"
                        style="@style/FontSemiBold"
                        android:text="Class Test"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        android:id="@+id/notify"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_marginEnd="12dp"
                        app:layout_constraintEnd_toStartOf="@id/profile"
                        android:src="@drawable/dash_notification"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:id="@+id/profile"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:src="@drawable/ic_user_profile"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/parentcn"
                        android:layout_marginTop="8dp"
                        android:layout_marginHorizontal="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:background="@drawable/border_line_curve_10dp_grey">
                        <LinearLayout
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"
                                android:layout_marginHorizontal="6dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="10dp">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">
                                        <ImageView
                                            android:layout_width="40dp"
                                            android:layout_height="40dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/img_sub"/>
                                        <androidx.constraintlayout.widget.ConstraintLayout
                                            android:layout_width="0dp"
                                            android:layout_weight="1"
                                            android:layout_height="wrap_content"
                                            android:padding="4dp"
                                            android:orientation="vertical">
                                            <TextView
                                                android:id="@+id/txt_title"
                                                style="@style/FontMedium"
                                                app:layout_constraintStart_toStartOf="parent"
                                                app:layout_constraintTop_toTopOf="parent"
                                                android:layout_width="0dp"
                                                android:textSize="14sp"
                                                android:layout_height="wrap_content"
                                                android:ellipsize="end"
                                                android:maxLines="2"
                                                android:text="Mathematics Unit Test – 1"
                                                android:textColor="@color/black_varient3" />
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:id="@+id/txt_incharge"
                                                android:textSize="14sp"
                                                style="@style/FontDefault"
                                                app:layout_constraintStart_toStartOf="parent"
                                                app:layout_constraintTop_toBottomOf="@id/txt_title"
                                                android:textColor="@color/colorPrimary"
                                                android:text="Mathematics | Algebra"/>
                                        </androidx.constraintlayout.widget.ConstraintLayout>
                                        <TextView
                                            android:id="@+id/status"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/_12sp"
                                            style="@style/FontDefault"
                                            android:textColor="@color/orange"
                                            android:layout_gravity="center"
                                            android:paddingHorizontal="12dp"
                                            android:paddingVertical="3dp"
                                            android:background="@drawable/border_curve_16dp"
                                            android:backgroundTint="@color/light_orange_bg"
                                            android:text="Today"/>
                                    </LinearLayout>
                                    <androidx.constraintlayout.widget.ConstraintLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:background="@drawable/dashed_border_line_curve_8dp">
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="8dp"
                                            app:layout_constraintTop_toTopOf="parent"
                                            app:layout_constraintBottom_toBottomOf="parent"
                                            android:id="@+id/lin1"
                                            android:orientation="horizontal">
                                            <RelativeLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:layout_weight="1"
                                                android:paddingStart="4dp"
                                                android:orientation="vertical">
                                                <TextView
                                                    android:layout_marginEnd="10dp"
                                                    android:layout_alignParentStart="true"
                                                    android:id="@+id/totalMarks"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textColor="#868686"
                                                    style="@style/FontDefault"
                                                    android:textSize="12sp"
                                                    android:maxLines="1"
                                                    android:text="Total Marks"/>
                                                <TextView
                                                    android:layout_toEndOf="@id/totalMarks"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textColor="#333333"
                                                    style="@style/FontRegular"
                                                    android:textSize="12sp"
                                                    android:maxLines="2"
                                                    android:ellipsize="end"
                                                    android:text="50 Mark"/>
                                                <TextView
                                                    android:layout_toStartOf="@+id/scheduledOn"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textColor="#868686"
                                                    style="@style/FontDefault"
                                                    android:textSize="12sp"
                                                    android:maxLines="1"
                                                    android:layout_marginEnd="10dp"
                                                    android:text="Scheduled On"/>
                                                <TextView
                                                    android:layout_alignParentEnd="true"
                                                    android:id="@+id/scheduledOn"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textColor="#333333"
                                                    style="@style/FontRegular"
                                                    android:textSize="12sp"
                                                    android:maxLines="2"
                                                    android:ellipsize="end"
                                                    android:text="16 May, 2024"/>
                                            </RelativeLayout>
                                        </LinearLayout>
                                    </androidx.constraintlayout.widget.ConstraintLayout>
                                    <LinearLayout
                                        android:layout_gravity="center"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:id="@+id/allDetails"
                                        android:padding="12dp"
                                        android:visibility="gone"
                                        android:orientation="vertical"
                                        android:background="@drawable/border_line_curve_10dp_orange">
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="horizontal">
                                            <ImageView
                                                android:layout_marginStart="3dp"
                                                android:textAlignment="center"
                                                android:paddingVertical="2dp"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:src="@drawable/carbon_information"
                                                android:id="@+id/info_img"
                                                app:layout_constraintStart_toStartOf="@id/mainn"
                                                app:layout_constraintTop_toTopOf="@id/mainn"
                                                app:layout_constraintBottom_toTopOf="@id/mainn"
                                                app:layout_constraintEnd_toEndOf="@id/mainn"
                                                app:riv_corner_radius="50dp"
                                                app:riv_border_color="@color/hint_color2"
                                                app:riv_border_width="0dp"/>
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textColor="@color/orange"
                                                style="@style/FontDefault"
                                                android:layout_gravity="center"
                                                android:layout_marginStart="8dp"
                                                android:textSize="14sp"
                                                android:maxLines="1"
                                                android:text="Note"/>
                                        </LinearLayout>
                                        <TextView
                                            style="@style/FontRegular"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="6dp"
                                            android:ellipsize="end"
                                            android:layout_marginTop="8dp"
                                            android:text="Chapter 3: Algebraic Expressions"
                                            android:textColor="#232B68"
                                            android:textSize="@dimen/_12sp" />
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/_12sp"
                                            android:textColor="#868686"
                                            style="@style/FontDefault"
                                            android:maxLines="3"
                                            android:ellipsize="end"
                                            android:text="* Introduction to algebra"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/_12sp"
                                            android:textColor="#868686"
                                            android:layout_marginTop="3dp"
                                            style="@style/FontDefault"
                                            android:maxLines="3"
                                            android:ellipsize="end"
                                            android:text="* Basic operations on algebraic expressions"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/_12sp"
                                            android:textColor="#868686"
                                            style="@style/FontDefault"
                                            android:layout_marginTop="3dp"
                                            android:maxLines="3"
                                            android:ellipsize="end"
                                            android:text="* Factorization techniques"/>
                                        <TextView
                                            style="@style/FontRegular"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="6dp"
                                            android:ellipsize="end"
                                            android:layout_marginTop="8dp"
                                            android:text="Chapter 5: Linear Equations"
                                            android:textColor="#232B68"
                                            android:textSize="@dimen/_12sp" />
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/_12sp"
                                            android:textColor="#868686"
                                            style="@style/FontDefault"
                                            android:maxLines="3"
                                            android:ellipsize="end"
                                            android:text="* Solving one-variable equations"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/_12sp"
                                            android:textColor="#868686"
                                            style="@style/FontDefault"
                                            android:layout_marginTop="3dp"
                                            android:maxLines="3"
                                            android:ellipsize="end"
                                            android:text="* Word problems on linear equations"/>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/parentcn"
                        app:layout_constraintBottom_toBottomOf="@id/parentcn"
                        app:layout_constraintStart_toStartOf="@id/parentcn"
                        app:layout_constraintEnd_toEndOf="@id/parentcn">
                        <LinearLayout
                            android:id="@+id/showdetails"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/border_line_curve_24dp_grey"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="3dp">
                            <TextView
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sp"
                                style="@style/FontDefault"
                                android:text="Show Details"
                                android:drawablePadding="10dp"
                                />
                            <ImageView
                                android:layout_marginStart="6dp"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_drop_down"
                                />
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/closeAll"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_12sp"
                            style="@style/FontDefault"
                            android:src="@drawable/ri_arrow_drop_up_line"
                            android:background="@drawable/border_line_primary_circle"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/search_lay"
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:layout_marginBottom="4dp"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="10dp"
                    app:layout_constraintTop_toBottomOf="@id/line1"
                    android:layout_height="wrap_content">
                    <EditText
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="Search"
                        style="@style/FontSemiBold"
                        android:textSize="@dimen/_14sp"
                        android:layout_marginEnd="10dp"
                        android:inputType="text"
                        android:id="@+id/search3"
                        android:singleLine="true"
                        android:imeOptions="actionSearch"
                        android:drawableStart="@drawable/ic_search"
                        android:drawablePadding="10dp"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="20dp"
                        android:textColor="@color/grey"
                        android:background="@drawable/border_line_curve_8dp_grey"/>
                    <ImageView
                        android:id="@+id/filter3"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/filter_icon_atten"/>
                </LinearLayout>
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tabcompletedlay"
                            android:padding="4dp"
                            android:background="@drawable/border_line_curve_24dp_primary"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tabcompleted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Absent"
                                android:paddingHorizontal="6dp"
                                style="@style/FontRegular"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_14sp"
                                android:drawablePadding="10dp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tabnotcompletedlay"
                            android:layout_marginStart="8dp"
                            android:padding="4dp"
                            android:background="@drawable/border_line_curve_24dp_grey"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tabpending"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Present"
                                style="@style/FontRegular"
                                android:textColor="@color/black_varient6"
                                android:paddingHorizontal="6dp"
                                android:textSize="@dimen/_14sp"
                                android:drawablePadding="10dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <androidx.core.widget.NestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/complt"/>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:id="@+id/pendingcards"
                                android:visibility="visible">
                                <include
                                    layout="@layout/card_exam_absent"/>
                                <include
                                    layout="@layout/card_exam_absent"/>
                                <include
                                    layout="@layout/card_exam_absent"/>
                                <include
                                    layout="@layout/card_exam_absent"/>
                                <include
                                    layout="@layout/card_exam_absent"/>
                                <include
                                    layout="@layout/card_exam_absent"/>
                                <include
                                    layout="@layout/card_exam_absent"/>
                                <include
                                    layout="@layout/card_exam_absent"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/completedcards"
                                android:visibility="gone"
                                android:orientation="vertical">
                                <androidx.recyclerview.widget.RecyclerView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/completedrecycle"
                                    android:visibility="gone"/>
                                <include
                                    android:id="@+id/compledscards"
                                    layout="@layout/card_exam_present"/>
                                <include
                                    layout="@layout/card_exam_present"/>
                                <include
                                    layout="@layout/card_exam_present"/>
                                <include
                                    layout="@layout/card_exam_present"/>
                                <include
                                    layout="@layout/card_exam_present"/>
                                <include
                                    layout="@layout/card_exam_present"/>
                                <include
                                    layout="@layout/card_exam_present"/>
                                <include
                                    layout="@layout/card_exam_present"/>
                                <include
                                    layout="@layout/card_exam_present"/>

                            </LinearLayout>
                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/head"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <include
            android:id="@+id/markSheet"
            android:visibility="gone"
            layout="@layout/dialog_marksheet"/>
        <include
            android:visibility="gone"
            android:id="@+id/updateMark"
            layout="@layout/dialog_update_mark"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>