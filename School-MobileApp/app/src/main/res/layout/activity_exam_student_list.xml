<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@drawable/otp_rec"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:id="@+id/timeTableTop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/header">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:id="@+id/top"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/backarrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:src="@drawable/back_arrow"/>
                    <TextView
                        android:id="@+id/topHeader"
                        android:layout_marginStart="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toEndOf="@id/backarrow"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:textSize="@dimen/_18sp"
                        android:textColor="@color/colorPrimary"
                        style="@style/FontMedium"
                        android:text="Exam"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardElevation="0dp"
            app:cardCornerRadius="25dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/parentLayout"
                android:padding="16dp"
                android:background="@color/white"
                android:orientation="vertical">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/parentcn"
                        android:layout_marginTop="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:background="@drawable/border_line_curve_10dp_grey">
                        <LinearLayout
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:id="@+id/examCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingVertical="6dp"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_gravity="center"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/midTerm"
                                        style="@style/FontMedium"
                                        android:layout_width="wrap_content"
                                        android:textSize="@dimen/_16sp"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:maxLines="2"
                                        android:text="1st Mid term Exam"
                                        android:textColor="@color/black_varient3" />
                                </LinearLayout>
                                <TextView
                                    android:id="@+id/status"
                                    android:background="@drawable/border_curve_24dp"
                                    android:paddingVertical="4dp"
                                    android:paddingHorizontal="16dp"
                                    style="@style/FontRegular"
                                    android:textSize="@dimen/_12sp"
                                    android:layout_gravity="center"
                                    android:backgroundTint="#DFEDFD"
                                    android:textColor="#61A4F3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Upcoming"/>
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/allDetails"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/border_line_curve_6dp_light_blue"
                                android:padding="12dp"
                                android:visibility="gone"
                                android:orientation="vertical"
                                android:layout_marginTop="8dp"
                                android:layout_gravity="center">
                                <LinearLayout
                                    android:id="@+id/row1"
                                    android:layout_weight="1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:weightSum="3">
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Standard &amp; Sec"
                                            android:textColor="#868686"
                                            style="@style/FontRegular"
                                            android:textSize="@dimen/_12sp" />
                                        <TextView
                                            android:id="@+id/std"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="1st Std - A Sec"
                                            android:textColor="#333333"
                                            style="@style/FontRegular"
                                            android:textSize="@dimen/_12sp"
                                            android:layout_marginTop="4dp" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Academic year"
                                            android:textColor="#868686"
                                            style="@style/FontRegular"
                                            android:textSize="@dimen/_12sp" />
                                        <TextView
                                            android:id="@+id/batch"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="2019-2022"
                                            android:textColor="#333333"
                                            style="@style/FontRegular"
                                            android:textSize="@dimen/_12sp"
                                            android:layout_marginTop="4dp" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Total Subjects"
                                            android:textColor="#868686"
                                            style="@style/FontRegular"
                                            android:textSize="@dimen/_12sp" />
                                        <TextView
                                            android:id="@+id/sub"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="5 Subjects"
                                            android:textColor="#333333"
                                            style="@style/FontRegular"
                                            android:textSize="@dimen/_12sp"
                                            android:layout_marginTop="4dp" />
                                    </LinearLayout>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/row2"
                                    android:layout_weight="1"
                                    android:layout_marginTop="4dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:weightSum="3">
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Start Date"
                                            android:textColor="#868686"
                                            style="@style/FontRegular"
                                            android:textSize="@dimen/_12sp" />
                                        <TextView
                                            android:id="@+id/startDate"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="12 Mar 2024"
                                            android:textColor="#333333"
                                            style="@style/FontRegular"
                                            android:textSize="@dimen/_12sp"
                                            android:layout_marginTop="4dp" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="End Date"
                                            android:textColor="#868686"
                                            style="@style/FontRegular"
                                            android:textSize="@dimen/_12sp" />
                                        <TextView
                                            android:id="@+id/endDate"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="26 Mar 2024"
                                            android:textColor="#333333"
                                            style="@style/FontRegular"
                                            android:textSize="@dimen/_12sp"
                                            android:layout_marginTop="4dp" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                    </LinearLayout>

                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/mingcute_down_line"
                        android:padding="8dp"
                        android:id="@+id/down"
                        app:layout_constraintTop_toBottomOf="@id/parentcn"
                        app:layout_constraintBottom_toBottomOf="@id/parentcn"
                        app:layout_constraintStart_toStartOf="@id/parentcn"
                        app:layout_constraintEnd_toEndOf="@id/parentcn"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:id="@+id/search_lay"
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:layout_marginBottom="4dp"
                    android:paddingVertical="8dp"
                    app:layout_constraintTop_toBottomOf="@id/line1"
                    android:layout_height="wrap_content">
                    <EditText
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="Search"
                        style="@style/FontRegular"
                        android:textSize="@dimen/_14sp"
                        android:layout_marginEnd="10dp"
                        android:inputType="text"
                        android:id="@+id/search3"
                        android:singleLine="true"
                        android:imeOptions="actionSearch"
                        android:drawableStart="@drawable/ic_search"
                        android:drawablePadding="10dp"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="20dp"
                        android:textColor="@color/black_varient6"
                        android:background="@drawable/border_line_curve_8dp_grey"/>
                    <ImageView
                        android:id="@+id/filter3"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_filter_blue"/>
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Students"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:textSize="@dimen/_16sp"
                        android:id="@+id/title1"
                        style="@style/FontRegular"
                        android:textColor="@color/black_varient3"/>
                    <TextView
                        android:id="@+id/students"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp"
                        android:paddingHorizontal="12dp"
                        android:textSize="@dimen/_12sp"
                        style="@style/FontRegular"
                        android:gravity="center"
                        android:drawableStart="@drawable/bell_"
                        android:drawableTint="@color/white"
                        android:drawablePadding="6dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:background="@drawable/border_line_curve_4dp_navy_blue"
                        android:backgroundTint="#232B68"
                        android:text="Remind All"
                        android:textColor="#FFFFFF"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/studentRecycler"/>
                    <include
                        android:id="@+id/noData"
                        android:visibility="gone"
                        layout="@layout/layout_no_data_found"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>