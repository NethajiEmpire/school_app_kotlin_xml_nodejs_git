<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/otp_rec"
    android:fitsSystemWindows="true"
    tools:context=".activity.FeeStructureActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="180dp"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/fee"/>
    <ImageView
        android:layout_width="260dp"
        android:layout_height="120dp"
        app:layout_constraintTop_toTopOf="@+id/fee"
        app:layout_constraintBottom_toBottomOf="@+id/fee"
        app:layout_constraintStart_toStartOf="@+id/fee"
        app:layout_constraintEnd_toEndOf="@+id/fee"
        android:id="@+id/vistalogo"
        android:src="@drawable/vista_academy_logo"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/fee"
        app:layout_constraintBottom_toBottomOf="parent"
        app:cardElevation="0dp"
        android:layout_marginBottom="-40dp"
        app:cardCornerRadius="40dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible"
                android:id="@+id/feestructure">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome to Vista Academy!"
                        style="@style/FontMedium"
                        android:layout_marginTop="8dp"
                        android:textSize="24sp"
                        android:textColor="#4B4B4B"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Empowering young mind with quality education and a bright future!"
                        android:layout_marginTop="8dp"
                        android:id="@+id/cont1"
                        style="@style/FontRegular"
                        android:textSize="16sp"
                        android:textColor="#A2A9B7"/>

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/registerboys" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:layout_gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fee Structure"
                            android:textColor="#4B4B4B"
                            style="@style/FontRegular"
                            android:textSize="18sp" />

                        <com.google.android.material.tabs.TabLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tabStateBoard">

                        </com.google.android.material.tabs.TabLayout>

                    </RelativeLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_line_curve_8dp_light_blue">
                        <LinearLayout
                            android:id="@+id/recyclertop"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_width="match_parent"
                            android:padding="2dp"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/border_line_curve_1dp_gray"
                                android:orientation="horizontal"
                                android:layout_marginVertical="16dp"
                                android:layout_marginHorizontal="8dp"
                                android:padding="1dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Term 1"
                                    android:padding="12dp"
                                    android:textColor="#232B68"
                                    android:textSize="14sp"
                                    android:background="@drawable/border_curve_4dp_start_light_blue"
                                    style="@style/FontRegular"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Term 2"
                                    android:padding="12dp"
                                    android:textColor="#C8C8C8"
                                    android:textSize="14sp"
                                    android:background="@android:color/transparent"
                                    style="@style/FontRegular"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Term 3"
                                    android:padding="12dp"
                                    android:textColor="#C8C8C8"
                                    android:textSize="14sp"
                                    android:background="@android:color/transparent"
                                    style="@style/FontRegular"/>
                            </LinearLayout>

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/feestructureRecyclerview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toBottomOf="@+id/recyclertop"
                            />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/mingcute_down_line"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/mingcute_down_line"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:padding="4dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Admission Process"
                            android:textColor="#4B4B4B"
                            style="@style/FontRegular"
                            android:textSize="18sp" />
                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/admissionRecyclerview"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Why Choose Vista Academy?"
                            style="@style/FontRegular"
                            android:id="@+id/chose"
                            android:padding="8dp"
                            android:textSize="18sp"
                            android:textColor="#4B4B4B"/>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:layout_marginTop="8dp">
                            <androidx.viewpager2.widget.ViewPager2
                                android:id="@+id/viewPager"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                            <me.relex.circleindicator.CircleIndicator3
                                android:id="@+id/indicator"
                                android:layout_width="match_parent"
                                android:layout_height="20dp"
                                app:ci_margin="3dp"
                                android:layout_alignParentBottom="true"
                                android:layout_centerHorizontal="true"
                                android:layout_marginBottom="8dp"
                                app:ci_drawable="@drawable/circle_indicator_color"
                                app:layout_constraintBottom_toBottomOf="parent"/>
                        </RelativeLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:layout_marginBottom="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contact Us"
                            style="@style/FontRegular"
                            android:id="@+id/contactus"
                            android:textSize="18sp"
                            android:textColor="#4B4B4B"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Dont hesitate to contact us whether you have a suggestion on our improvement, a complaint to discuss or a  issue to resolve."
                            android:layout_marginTop="8dp"
                            android:id="@+id/cont"
                            style="@style/FontRegular"
                            android:textSize="12sp"
                            android:textColor="#A2A9B7"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:weightSum="2">
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/border_curve_card_background_12dp_gray"
                                    android:gravity="center"
                                    android:padding="16dp"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="68dp"
                                        android:layout_height="68dp"
                                        android:src="@drawable/ic_call_us"
                                        android:padding="12dp" />

                                    <TextView
                                        android:id="@+id/call_us"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Call us"
                                        android:textColor="#3F51B5"
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:layout_marginTop="8dp" />

                                    <TextView
                                        android:id="@+id/callTeam"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Our team is on the line"
                                        android:textColor="#808080"
                                        android:textSize="12sp"
                                        android:layout_marginTop="4dp" />

                                    <TextView
                                        android:id="@+id/callAvail"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Mon-Fri • 9-17"
                                        android:textColor="#808080"
                                        android:textSize="12sp"
                                        android:layout_marginTop="4dp" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/border_curve_card_background_12dp_gray"
                                    android:gravity="center"
                                    android:padding="16dp"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="68dp"
                                        android:layout_height="68dp"
                                        android:src="@drawable/ic_email_us"
                                        android:padding="12dp" />

                                    <TextView
                                        android:id="@+id/email_us"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Email Us"
                                        android:textColor="#3F51B5"
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:layout_marginTop="8dp" />

                                    <TextView
                                        android:id="@+id/ourteam"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Our team is online"
                                        android:textColor="#808080"
                                        android:textSize="12sp"
                                        android:layout_marginTop="4dp" />

                                    <TextView
                                        android:id="@+id/emailAvail"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Mon-Fri • 9-17"
                                        android:textColor="#808080"
                                        android:textSize="12sp"
                                        android:layout_marginTop="4dp" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/registerhere"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Register"
                            style="@style/FontRegular"
                            android:textSize="14sp"
                            android:layout_gravity="center"
                            android:background="@drawable/ic_button_bg"
                            android:layout_marginVertical="22dp"
                            android:gravity="center"
                            android:textColor="@color/white"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>