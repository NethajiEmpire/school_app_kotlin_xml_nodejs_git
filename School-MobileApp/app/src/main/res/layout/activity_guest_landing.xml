<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".activity.FeeStructureActivity">
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/fee"/>
    <ImageView
        android:layout_width="105dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="@+id/fee"
        app:layout_constraintBottom_toBottomOf="@+id/fee"
        app:layout_constraintStart_toStartOf="@+id/fee"
        android:id="@+id/vistalogo"
        android:layout_marginStart="16dp"
        android:src="@drawable/vista_academy_logo"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/fee"
        app:layout_constraintBottom_toBottomOf="parent"
        app:cardElevation="0dp"
        android:layout_marginBottom="-20dp"
        app:cardCornerRadius="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible"
                android:id="@+id/feestructure">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome to Vista Academy!"
                        style="@style/FontMedium"
                        android:layout_marginTop="12dp"
                        android:textSize="16sp"
                        android:textColor="#4B4B4B"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Empowering young mind with quality education and a bright future!"
                        android:id="@+id/cont1"
                        style="@style/FontRegular"
                        android:textSize="10sp"
                        android:textColor="#A2A9B7"/>
                    <ImageView
                        android:id="@+id/register"
                        android:layout_width="match_parent"
                        android:layout_height="144dp"
                        android:scaleType="fitXY"
                        android:visibility="gone"
                        android:src="@drawable/registerboys" />
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="180dp">
                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/viewPager1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                        <me.relex.circleindicator.CircleIndicator3
                            android:id="@+id/indicator1"
                            android:layout_width="match_parent"
                            android:layout_height="20dp"
                            app:ci_margin="3dp"
                            android:layout_alignParentBottom="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginBottom="8dp"
                            app:ci_drawable="@drawable/rectangle_indicator"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:id="@+id/explore"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Explore Our Premier Facilities!"
                                android:textColor="#4B4B4B"
                                style="@style/FontMedium"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vista School-Where Innovation Meets Learning!"
                                android:textColor="#717171"
                                style="@style/FontRegular"
                                android:visibility="gone"
                                android:textSize="12sp" />
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/GuestLandingRecyclerview"
                                android:layout_width="match_parent"
                                android:layout_marginTop="12dp"
                                android:layout_height="wrap_content"
                                app:layout_constraintTop_toBottomOf="@+id/recyclertop"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:id="@+id/schoolAdv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Advantages of the school"
                                android:textColor="#4B4B4B"
                                style="@style/FontMedium"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Focus on academics, sports and creativity."
                                android:textColor="#717171"
                                style="@style/FontRegular"
                                android:visibility="gone"
                                android:textSize="12sp" />
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_marginTop="4dp"
                                android:layout_height="wrap_content">
                                <HorizontalScrollView
                                    android:id="@+id/advantageScholl"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:layout_constraintTop_toTopOf="parent"
                                    android:scrollbars="none">
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:padding="12dp"
                                        android:background="@drawable/border_line_curve_6dp_light_blue"
                                        android:backgroundTint="#EFF9FF">
                                        <androidx.constraintlayout.widget.ConstraintLayout
                                            android:layout_width="102dp"
                                            android:layout_height="65dp"
                                            android:background="@drawable/border_curve_line_1dp_gray_lightpink_background">
                                            <ImageView
                                                android:id="@+id/student"
                                                android:layout_width="35dp"
                                                android:layout_height="35dp"
                                                android:src="@drawable/grade2"
                                                app:layout_constraintTop_toTopOf="parent"
                                                app:layout_constraintEnd_toEndOf="parent" />
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Maximum \nStudents get A+ \nin every year"
                                                android:textColor="#4B4B4B"
                                                android:textSize="10sp"
                                                android:padding="10dp"
                                                android:lineSpacingExtra="3dp"
                                                app:layout_constraintTop_toTopOf="parent"
                                                app:layout_constraintTop_toBottomOf="@id/student"
                                                app:layout_constraintStart_toStartOf="parent" />
                                        </androidx.constraintlayout.widget.ConstraintLayout>
                                        <androidx.constraintlayout.widget.ConstraintLayout
                                            android:layout_width="102dp"
                                            android:layout_height="65dp"
                                            android:layout_marginStart="8dp"
                                            android:background="@drawable/border_curve_line_1dp_gray_lightpink_background">
                                            <ImageView
                                                android:id="@+id/health"
                                                android:layout_width="35dp"
                                                android:layout_height="35dp"
                                                android:src="@drawable/health2"
                                                app:layout_constraintTop_toTopOf="parent"
                                                app:layout_constraintEnd_toEndOf="parent" />
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="A Safe &amp; \nHealthy Learning Space!"
                                                android:textColor="#4B4B4B"
                                                android:textSize="10sp"
                                                android:padding="10dp"
                                                android:lineSpacingExtra="3dp"
                                                app:layout_constraintTop_toTopOf="parent"
                                                app:layout_constraintTop_toBottomOf="@id/health"
                                                app:layout_constraintStart_toStartOf="parent" />
                                        </androidx.constraintlayout.widget.ConstraintLayout>
                                        <androidx.constraintlayout.widget.ConstraintLayout
                                            android:layout_width="102dp"
                                            android:layout_height="65dp"
                                            android:layout_marginStart="6dp"
                                            android:background="@drawable/border_curve_line_1dp_gray_lightpink_background">
                                            <ImageView
                                                android:id="@+id/tech"
                                                android:layout_width="35dp"
                                                android:layout_height="35dp"
                                                android:src="@drawable/tech2"
                                                app:layout_constraintTop_toTopOf="parent"
                                                app:layout_constraintEnd_toEndOf="parent" />
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="We have all \nthe new technologies"
                                                android:textColor="#4B4B4B"
                                                android:textSize="10sp"
                                                android:padding="10dp"
                                                android:lineSpacingExtra="3dp"
                                                app:layout_constraintTop_toTopOf="parent"
                                                app:layout_constraintTop_toBottomOf="@id/tech"
                                                app:layout_constraintStart_toStartOf="parent" />
                                        </androidx.constraintlayout.widget.ConstraintLayout>
                                        <androidx.constraintlayout.widget.ConstraintLayout
                                            android:layout_width="102dp"
                                            android:layout_height="65dp"
                                            android:layout_marginStart="6dp"
                                            android:background="@drawable/border_curve_line_1dp_gray_lightpink_background">
                                            <ImageView
                                                android:id="@+id/projector"
                                                android:layout_width="35dp"
                                                android:layout_height="35dp"
                                                android:src="@drawable/projector2"
                                                app:layout_constraintTop_toTopOf="parent"
                                                app:layout_constraintEnd_toEndOf="parent" />
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="We teach \nall time using projector"
                                                android:textColor="#4B4B4B"
                                                android:textSize="10sp"
                                                android:padding="10dp"
                                                android:lineSpacingExtra="3dp"
                                                app:layout_constraintTop_toTopOf="parent"
                                                app:layout_constraintTop_toBottomOf="@id/projector"
                                                app:layout_constraintStart_toStartOf="parent" />
                                        </androidx.constraintlayout.widget.ConstraintLayout>
                                        <androidx.constraintlayout.widget.ConstraintLayout
                                            android:layout_width="102dp"
                                            android:layout_height="65dp"
                                            android:layout_marginStart="6dp"
                                            android:background="@drawable/border_curve_line_1dp_gray_lightpink_background">
                                            <ImageView
                                                android:id="@+id/teacher"
                                                android:layout_width="35dp"
                                                android:layout_height="35dp"
                                                android:src="@drawable/teacher2"
                                                app:layout_constraintTop_toTopOf="parent"
                                                app:layout_constraintEnd_toEndOf="parent" />
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Every one of \nour teachers is \nhighly qualified."
                                                android:textColor="#4B4B4B"
                                                android:textSize="10sp"
                                                android:lineSpacingExtra="3dp"
                                                android:padding="8dp"
                                                app:layout_constraintTop_toTopOf="parent"
                                                app:layout_constraintTop_toBottomOf="@id/teacher"
                                                app:layout_constraintStart_toStartOf="parent" />
                                        </androidx.constraintlayout.widget.ConstraintLayout>
                                    </LinearLayout>
                                </HorizontalScrollView>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Admission Process"
                            android:textColor="#4B4B4B"
                            android:layout_marginTop="12dp"
                            style="@style/FontMedium"
                            android:textSize="14sp" />
                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:id="@+id/admissionRecyclerview"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Why Choose Vista Academy?"
                            style="@style/FontRegular"
                            android:id="@+id/chose"
                            android:padding="8dp"
                            android:textSize="14sp"
                            android:textColor="#4B4B4B"/>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:layout_marginTop="3dp">
                            <androidx.viewpager2.widget.ViewPager2
                                android:id="@+id/viewPager"
                                android:layout_width="match_parent"
                                android:visibility="gone"
                                android:layout_height="match_parent"/>
                            <me.relex.circleindicator.CircleIndicator3
                                android:id="@+id/indicator"
                                android:layout_width="match_parent"
                                android:layout_height="20dp"
                                app:ci_margin="3dp"
                                android:visibility="gone"
                                android:layout_alignParentBottom="true"
                                android:layout_centerHorizontal="true"
                                android:layout_marginBottom="8dp"
                                app:ci_drawable="@drawable/circle_indicator_color"
                                app:layout_constraintBottom_toBottomOf="parent"/>
                        </RelativeLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:visibility="gone"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contact Us"
                            style="@style/FontRegular"
                            android:id="@+id/contactus"
                            android:textSize="18sp"
                            android:textColor="#4B4B4B"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Dont hesitate to contact us whether you have a suggestion on our improvement, a complaint to discuss or a  issue to resolve."
                            android:layout_marginTop="8dp"
                            android:id="@+id/cont"
                            style="@style/FontRegular"
                            android:textSize="12sp"
                            android:textColor="#A2A9B7"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:weightSum="2">
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/border_curve_card_background_12dp_gray"
                                    android:gravity="center"
                                    android:padding="16dp"
                                    android:orientation="vertical">
                                    <ImageView
                                        android:layout_width="68dp"
                                        android:layout_height="68dp"
                                        android:src="@drawable/ic_call_us"
                                        android:padding="12dp" />
                                    <TextView
                                        android:id="@+id/call_us"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Call us"
                                        android:textColor="#3F51B5"
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:layout_marginTop="8dp" />

                                    <TextView
                                        android:id="@+id/callTeam"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Our team is on the line"
                                        android:textColor="#808080"
                                        android:textSize="12sp"
                                        android:layout_marginTop="4dp" />
                                    <TextView
                                        android:id="@+id/callAvail"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Mon-Fri • 9-17"
                                        android:textColor="#808080"
                                        android:textSize="12sp"
                                        android:layout_marginTop="4dp" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/border_curve_card_background_12dp_gray"
                                    android:gravity="center"
                                    android:padding="16dp"
                                    android:orientation="vertical">
                                    <ImageView
                                        android:layout_width="68dp"
                                        android:layout_height="68dp"
                                        android:src="@drawable/ic_email_us"
                                        android:padding="12dp" />
                                    <TextView
                                        android:id="@+id/email_us"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Email Us"
                                        android:textColor="#3F51B5"
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:layout_marginTop="8dp" />
                                    <TextView
                                        android:id="@+id/ourteam"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Our team is online"
                                        android:textColor="#808080"
                                        android:textSize="12sp"
                                        android:layout_marginTop="4dp" />
                                    <TextView
                                        android:id="@+id/emailAvail"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Mon-Fri • 9-17"
                                        android:textColor="#808080"
                                        android:textSize="12sp"
                                        android:layout_marginTop="4dp" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Register"
                            style="@style/FontRegular"
                            android:textSize="14sp"
                            android:layout_gravity="center"
                            android:background="@drawable/ic_button_bg"
                            android:layout_marginVertical="22dp"
                            android:gravity="center"
                            android:textColor="@color/white"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="For Enquiry"
                        android:layout_marginTop="8dp"
                        style="@style/FontMedium"
                        android:id="@+id/enquiry"
                        android:textSize="14sp"
                        android:textColor="#4B4B4B"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:padding="8dp"
                        android:background="@drawable/border_line_curve_10dp_grey"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="50dp"
                            android:src="@drawable/enquiry"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_gravity="center"
                                android:paddingStart="8dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/names"
                                    style="@style/FontMedium"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    android:layout_width="0dp"
                                    android:textSize="16sp"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:text="Geetha Lakshmi S"
                                    android:textColor="#333333" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    style="@style/FontRegular"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/names"
                                    android:textColor="#999999"
                                    android:text="School Management"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                            <ImageView
                                android:id="@+id/checkBoxStatus"
                                android:layout_width="38dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_call_round" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/registerhere"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Register"
                        style="@style/FontRegular"
                        android:textSize="14sp"
                        android:layout_marginTop="16dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/ic_button_bg"
                        android:gravity="center"
                        android:textColor="@color/white"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>