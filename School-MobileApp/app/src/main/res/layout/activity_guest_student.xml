<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/otp_rec"
    tools:context=".activity.GuestStudentActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/header">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:paddingVertical="14dp"
                    android:id="@+id/top"
                    android:paddingHorizontal="16dp"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/backarrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/back_arrow"/>
                    <TextView
                        android:id="@+id/guestStudent"
                        android:layout_marginStart="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toEndOf="@id/backarrow"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:textSize="@dimen/_16sp"
                        android:textColor="@color/colorPrimary"
                        style="@style/FontMedium"
                        android:text="Guest Student Info "/>
                    <ImageView
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        android:id="@+id/notify"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_marginEnd="12dp"
                        android:visibility="gone"
                        android:src="@drawable/dash_notification"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="25dp"
                android:layout_marginBottom="-25dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="25dp"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginTop="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/gradiant_light_blue"
                        android:orientation="vertical"
                        android:padding="10dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <com.makeramen.roundedimageview.RoundedImageView
                                android:id="@+id/profileimg"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:riv_corner_radius="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_user_profile"/>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="4dp">

                                <TextView
                                    android:id="@+id/name"
                                    style="@style/FontMedium"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:ellipsize="end"
                                    android:text="Nethaji Hada"
                                    android:textColor="@color/black_varient3"
                                    android:textSize="14sp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <TextView
                                    android:id="@+id/stdId"
                                    style="@style/FontMedium"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="STDID2434"
                                    android:textColor="#818181"
                                    android:textSize="12sp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/name" />
                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <TextView
                                android:visibility="gone"
                                android:id="@+id/status"
                                style="@style/FontMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/border_curve_24dp"
                                android:backgroundTint="#D9FFDB"
                                android:gravity="center"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="4dp"
                                android:text="Active"
                                android:textColor="#32B138"
                                android:textSize="@dimen/_14sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1.5dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/dash_line"
                            android:backgroundTint="#DFDFDF" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <TextView
                                android:id="@+id/mobile"
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_call_with_blue"
                                android:drawablePadding="4dp"
                                android:text="+91 98765 43210"
                                android:textColor="#2B3580"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/email"
                                    style="@style/FontRegular"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawableStart="@drawable/ic_mail_with_blue"
                                    android:drawablePadding="4dp"
                                    android:text="nethajihada@gmail.com"
                                    android:textColor="#2B3580"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:visibility="visible">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:layout_marginVertical="16dp"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/stdInfo"
                                android:layout_marginEnd="8dp"
                                android:padding="4dp"
                                android:background="@drawable/border_line_curve_4dp_primary"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/tabAll"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Student Information"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient3"
                                    android:paddingHorizontal="16dp"
                                    android:textSize="@dimen/_14sp"
                                    android:drawablePadding="10dp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/parentInfo"
                                android:layout_marginEnd="8dp"
                                android:padding="4dp"
                                android:background="@drawable/border_line_curve_4dp_primary"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/tabPending"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Parent / Guardian Info"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient6"
                                    android:paddingHorizontal="6dp"
                                    android:textSize="@dimen/_14sp"
                                    android:drawablePadding="10dp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/tabCompletedLay"
                                android:padding="4dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/border_line_curve_4dp_primary"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/academicInfo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Academic Information "
                                    android:paddingHorizontal="6dp"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_14sp"
                                    android:drawablePadding="10dp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/transactionInfo"
                                android:layout_marginEnd="8dp"
                                android:padding="4dp"
                                android:background="@drawable/border_line_curve_4dp_primary"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/tabCompleted"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Documents"
                                    android:paddingHorizontal="6dp"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_14sp"
                                    android:drawablePadding="10dp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/feeInfo"
                                android:padding="4dp"
                                android:background="@drawable/border_line_curve_4dp_primary"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/feeinfo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Transaction"
                                    android:paddingHorizontal="6dp"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_14sp"
                                    android:drawablePadding="10dp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </HorizontalScrollView>
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:background="@drawable/border_curve_15_light_blue"
                        android:id="@+id/stdInfoRecycle"
                        android:orientation="vertical"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:id="@+id/applyFilterLay"
                        android:padding="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_marginEnd="10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Approve"
                            android:drawableEnd="@drawable/hugeicons_tick"
                            android:drawableTint="@color/white"
                            android:drawablePadding="4dp"
                            style="@style/FontRegular"
                            android:id="@+id/Accept"
                            android:background="@drawable/border_curve_4dp"
                            android:backgroundTint="@color/colorPrimary"
                            android:textColor="@color/white"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="18dp"
                            android:textSize="@dimen/_14sp"/>
                        <TextView
                            android:drawableEnd="@drawable/close2"
                            android:drawableTint="@color/white"
                            android:drawablePadding="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reject"
                            style="@style/FontRegular"
                            android:id="@+id/apply"
                            android:background="@drawable/border_curve_4dp"
                            android:backgroundTint="@color/red2"
                            android:textColor="@color/white"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="18dp"
                            android:textSize="@dimen/_14sp"/>
                    </LinearLayout>
                </LinearLayout>

            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>