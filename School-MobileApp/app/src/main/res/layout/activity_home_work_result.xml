<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/main"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@drawable/otp_rec"
android:fitsSystemWindows="true">
<LinearLayout
    android:id="@+id/timeTableTop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/header">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:id="@+id/top"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/backarrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:src="@drawable/back_arrow"/>
                <TextView
                    android:id="@+id/topHeader"
                    android:layout_marginStart="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/backarrow"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:textSize="@dimen/_18sp"
                    android:textColor="@color/colorPrimary"
                    style="@style/FontMedium"
                    android:text="Home Work"/>
                <ImageView
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    android:id="@+id/notify"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintEnd_toStartOf="@id/profile"
                    android:src="@drawable/dash_notification"/>
                <ImageView
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:id="@+id/profile"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:src="@drawable/ic_user_profile"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <LinearLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_weight="1">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center"
                    android:padding="4dp">
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/sub"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="center"
                        android:layout_marginStart="8dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/subject"
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Subject  : English"
                                android:textColor="@color/black_varient3"
                                android:textSize="@dimen/_14sp"/>
                            <TextView
                                android:id="@+id/teacher"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black_varient6"
                                android:textSize="@dimen/_12sp"
                                android:layout_marginTop="4dp"
                                style="@style/FontRegular"
                                android:text="Teacher  : Mrs Anitha"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="end"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/border_line_curve"
                                android:backgroundTint="#DAE7FF"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="2dp"
                                android:text="Ongoing"
                                style="@style/FontRegular"
                                android:textColor="#3F8BFB"
                                android:textSize="@dimen/_12sp" />
                            <TextView
                                android:id="@+id/points"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+2 points"
                                android:layout_marginTop="4dp"
                                android:textSize="@dimen/_12sp"
                                android:layout_gravity="center"
                                style="@style/FontRegular"
                                android:textColor="@color/blue"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_alignBottom="@+id/homeworktext"
                    android:background="@drawable/dash_line"
                    android:backgroundTint="#F0F0F0"
                    />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/relp2">
                        <TextView
                            android:layout_weight="1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_12sp"
                            android:text="Given On "
                            android:layout_centerVertical="true"
                            android:paddingVertical="2dp"
                            android:textColor="@color/black_varient6"
                            style="@style/FontDefault"
                            android:id="@+id/givenOn"
                            android:layout_alignParentStart="true" />
                        <TextView
                            android:layout_weight="2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=":- 20-04-2025"
                            android:paddingVertical="2dp"
                            android:layout_centerVertical="true"
                            style="@style/FontRegular"
                            android:textSize="@dimen/_12sp"
                            android:textColor="#4F4F4F"
                            android:id="@+id/givenDate"
                            android:layout_toRightOf="@id/givenOn" />
                    <TextView
                        android:layout_weight="1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Submit On"
                        android:textColor="@color/black_varient6"
                        style="@style/FontDefault"
                        android:paddingVertical="2dp"
                        android:layout_centerVertical="true"
                        android:textSize="@dimen/_12sp"
                        android:layout_toLeftOf="@id/submitDate"
                        android:id="@+id/submitOn"/>
                    <TextView
                        android:layout_weight="2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#4F4F4F"
                        android:text=":- 21-04-2025"
                        style="@style/FontRegular"
                        android:layout_centerVertical="true"
                        android:paddingVertical="2dp"
                        android:textSize="@dimen/_12sp"
                        android:id="@+id/submitDate"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_alignBottom="@+id/homeworktext"
                    android:background="@drawable/dash_line"
                    android:backgroundTint="#F0F0F0" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:background="@drawable/border_line_curve_8dp_light_blue">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="start|center_vertical">
                        <TextView
                            android:id="@+id/que1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Title: "
                            android:textColor="#212121"
                            android:textSize="@dimen/_14sp"
                            style="@style/FontMedium"
                            android:maxLines="1"
                            android:ellipsize="end" />
                        <com.lms.sch.customviews.SeeMoreTextView
                            android:id="@+id/que"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Write an essay on My Favorite Festival"
                            android:textColor="#1976D2"
                            android:textSize="@dimen/_13sp"
                            style="@style/FontRegular"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/que3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Description: "
                        android:textColor="#212121"
                        android:textSize="@dimen/_14sp"
                        style="@style/FontMedium"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <com.lms.sch.customviews.SeeMoreTextView
                        android:id="@+id/desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Write a short essay about your favorite festival. You can talk about how you celebrate it, why you love it, any special foods, clothes, or traditions you follow, and how it makes you feel. Try to keep it personal and creative!"
                        android:textColor="#424242"
                        android:textSize="@dimen/_12sp"
                        style="@style/FontRegular"
                        android:ellipsize="end" />
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="10dp"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="8dp"
                    android:id="@+id/noteLay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:backgroundTint="#FFF2F2"
                    android:background="@drawable/border_line_curve_10dp_grey">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_14sp"
                        style="@style/FontMedium"
                        android:textColor="#5A5A5A"
                        android:text="Note*"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:id="@+id/noteCheck"
                            android:src="@drawable/checkbox_untick"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#5A5A5A"
                            android:textSize="@dimen/_12sp"
                            android:id="@+id/note"
                            android:layout_marginStart="4dp"
                            style="@style/FontDefault"
                            android:text="Mark as Done if you’ve completed this homework. This is just for you to remember what you’ve finished!"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/upload_lay"
                    android:visibility="gone"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_12sp"
                        android:layout_marginTop="12dp"
                        style="@style/FontRegular"
                        android:textColor="@color/black_varient3"
                        android:text="Upload Your Home Work"/>
                    <TextView
                        android:id="@+id/attach"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Choose File"
                        android:background="@drawable/border_line_curve_8dp_light_blue"
                        android:paddingVertical="12dp"
                        android:layout_marginTop="8dp"
                        android:paddingHorizontal="16dp"
                        android:textColor="#868686"
                        android:drawableEnd="@drawable/prime_upload"
                        android:textSize="14sp"
                        style="@style/FontRegular"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_10sp"
                        android:layout_marginTop="2dp"
                        style="@style/FontRegular"
                        android:textColor="#E34747"
                        android:text="* Maximum size 5Mb"/>

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/attach_lay"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_12sp"
                        android:layout_marginTop="12dp"
                        style="@style/FontRegular"
                        android:id="@+id/uploadTxtt"
                        android:textColor="#5A5A5A"
                        android:text="Uploaded Home Work"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="8dp"
                        android:id="@+id/attachRecycler"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/remarkLay"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_12sp"
                        android:layout_marginTop="12dp"
                        style="@style/FontRegular"
                        android:textColor="#5A5A5A"
                        android:text="Teacher Remarks"/>
                    <TextView
                        android:background="@drawable/border_line_curve_8dp_light_blue"
                        android:layout_width="match_parent"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="10dp"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_12sp"
                        android:layout_marginTop="4dp"
                        style="@style/FontRegular"
                        android:id="@+id/remarks"
                        android:textColor="@color/colorPrimary"
                        android:text="--/--"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/doneHw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="8dp"
                    android:textSize="@dimen/_14sp"
                    style="@style/FontDefault"
                    android:textAlignment="center"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/ic_button_bg"
                    android:text="Done"
                    android:textColor="#FFFFFF"/>
                <LinearLayout
                    android:id="@+id/upload"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:weightSum="2">
                    <TextView
                        android:id="@+id/uploadTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="8dp"
                        android:textSize="@dimen/_14sp"
                        style="@style/FontDefault"
                        android:textAlignment="center"
                        android:layout_weight="1"
                        android:background="@drawable/border_line_curve_4dp_navy_blue"
                        android:backgroundTint="#232B68"
                        android:text="upload"
                        android:textColor="#FFFFFF"
                        />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/okCancel"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">
                    <TextView
                        android:id="@+id/cancel"
                        android:layout_weight="1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:textSize="@dimen/_14sp"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="8dp"
                        android:textColor="@color/colorPrimary"
                        style="@style/FontDefault"
                        android:layout_marginEnd="12dp"
                        android:text="Cancel"
                        android:background="@drawable/border_line_curve_4dp_navy_blue"/>
                    <TextView
                        android:id="@+id/makeasdone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="8dp"
                        android:textSize="@dimen/_14sp"
                        style="@style/FontDefault"
                        android:textAlignment="center"
                        android:layout_weight="1"
                        android:background="@drawable/border_line_curve_4dp_navy_blue"
                        android:backgroundTint="#232B68"
                        android:text="Make As Done"
                        android:textColor="#FFFFFF"
                        />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>