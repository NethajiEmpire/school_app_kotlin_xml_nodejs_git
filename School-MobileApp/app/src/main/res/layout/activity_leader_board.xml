<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_leader_board"
    tools:context=".activity.LeaderBoardActivity">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            android:paddingVertical="14dp"
            android:id="@+id/top"
            android:paddingHorizontal="16dp"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/backarrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/back_arrow"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/backarrow"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textSize="16sp"
                android:layout_marginStart="10dp"
                android:textColor="@color/white"
                style="@style/FontMedium"
                android:text="Leader Board"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:id="@+id/notify"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginEnd="12dp"
                android:visibility="gone"
                app:layout_constraintEnd_toStartOf="@id/profile"
                android:src="@drawable/dash_notification"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/profile"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/ic_user_profile"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="22dp"
            android:background="@drawable/border_curve_8dp"
            app:layout_constraintTop_toBottomOf="@id/top"
            android:padding="6dp"
            android:id="@+id/tab"
            android:weightSum="2"
            android:orientation="horizontal">
            <TextView
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:id="@+id/tab_points_board"
                android:text="Points  Board"
                style="@style/FontRegular"
                android:layout_marginEnd="4dp"
                android:background="@drawable/border_curve_8dp"
                android:backgroundTint="@color/colorPrimary"
                android:paddingVertical="6dp"
                android:paddingHorizontal="14dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/_14sp"/>
            <TextView

                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Score Board"
                android:id="@+id/tab_score_board"
                style="@style/FontRegular"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:background="@drawable/border_line_curve_8dp_grey"
                android:paddingVertical="6dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/black_varient6"
                android:textSize="@dimen/_14sp"
                android:drawablePadding="10dp"/>

        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:id="@+id/view"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/tab"
            android:layout_height="210dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:id="@+id/topGradeLay"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="@id/view"
            app:layout_constraintBottom_toBottomOf="@id/view">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="3"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">
                        <com.makeramen.roundedimageview.RoundedImageView
                            android:id="@+id/img1"
                            android:layout_width="63dp"
                            android:layout_height="63dp"
                            android:src="@drawable/ic_user_profile"
                            android:scaleType="centerCrop"
                            app:riv_mutate_background="true"
                            android:layout_gravity="center"
                            android:elevation="24dp"
                            app:layout_constraintStart_toStartOf="@id/mainn1"
                            app:layout_constraintTop_toTopOf="@id/mainn1"
                            app:layout_constraintBottom_toTopOf="@id/mainn1"
                            app:layout_constraintEnd_toEndOf="@id/mainn1"
                            app:riv_corner_radius="50dp"
                            app:riv_border_color="#009BD6"
                            app:riv_border_width="2dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2"
                            style="@style/FontMedium"
                            android:gravity="center"
                            android:elevation="24dp"
                            app:layout_constraintTop_toBottomOf="@id/img1"
                            app:layout_constraintBottom_toBottomOf="@id/img1"
                            app:layout_constraintEnd_toEndOf="@id/img1"
                            app:layout_constraintStart_toStartOf="@id/img1"
                            android:background="@drawable/rec"
                            android:textSize="@dimen/_12sp"
                            android:textColor="@color/white"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:layout_marginTop="16dp"
                            android:gravity="bottom|center"
                            android:id="@+id/mainn1"
                            android:paddingBottom="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:background="@drawable/border_curve_left_20dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/rank2Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp"
                                android:text="--/--"
                                android:singleLine="true"
                                android:textColor="@color/white"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_10sp"
                                android:text="--/--"
                                android:singleLine="true"
                                android:textColor="#B7B3B3"/>
                            <TextView
                                android:id="@+id/points2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/FontMedium"
                                android:textSize="@dimen/_12sp"
                                android:text="0"
                                android:textColor="#009BD6"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/FontMedium"
                                android:textSize="@dimen/_12sp"
                                android:text="--/--"
                                android:id="@+id/status2"
                                android:textColor="#009BD6"/>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:id="@+id/lin3"
                    android:gravity="center"
                    android:orientation="vertical">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">
                        <com.makeramen.roundedimageview.RoundedImageView
                            android:id="@+id/img"
                            android:layout_width="63dp"
                            android:layout_height="63dp"
                            android:src="@drawable/ic_user_profile"
                            android:scaleType="centerCrop"
                            app:riv_mutate_background="true"
                            android:layout_gravity="center"
                            android:elevation="24dp"
                            app:layout_constraintStart_toStartOf="@id/mainn"
                            app:layout_constraintTop_toTopOf="@id/mainn"
                            app:layout_constraintBottom_toTopOf="@id/mainn"
                            app:layout_constraintEnd_toEndOf="@id/mainn"
                            app:riv_corner_radius="50dp"
                            app:riv_border_color="#00D95F"
                            app:riv_border_width="2dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            style="@style/FontMedium"
                            android:gravity="center"
                            android:elevation="24dp"
                            app:layout_constraintTop_toBottomOf="@id/img"
                            app:layout_constraintBottom_toBottomOf="@id/img"
                            app:layout_constraintEnd_toEndOf="@id/img"
                            app:layout_constraintStart_toStartOf="@id/img"
                            android:background="@drawable/rec"
                            android:backgroundTint="#00D95F"
                            android:textSize="@dimen/_12sp"
                            android:textColor="@color/white"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="170dp"
                            android:layout_marginTop="16dp"
                            android:gravity="center|bottom"
                            app:layout_constraintDimensionRatio="1:1.5"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:id="@+id/mainn"
                            android:paddingBottom="12dp"
                            android:background="@drawable/border_curve_top_28dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/rank1Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_14sp"
                                android:text="--/--"
                                android:singleLine="true"
                                android:textColor="@color/white"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp"
                                android:text="--/--"
                                android:singleLine="true"
                                android:textColor="#B7B3B3"/>
                            <TextView
                                android:id="@+id/points"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/FontMedium"
                                android:textSize="@dimen/_14sp"
                                android:text="0"
                                android:textColor="#00D95F"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/FontMedium"
                                android:textSize="@dimen/_14sp"
                                android:id="@+id/status1"
                                android:text="--/--"
                                android:singleLine="true"
                                android:textColor="#00D95F"/>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">
                        <com.makeramen.roundedimageview.RoundedImageView
                            android:id="@+id/img2"
                            android:layout_width="63dp"
                            android:layout_height="63dp"
                            android:src="@drawable/ic_user_profile"
                            android:scaleType="centerCrop"
                            app:riv_mutate_background="true"
                            android:layout_gravity="center"
                            android:elevation="24dp"
                            app:layout_constraintStart_toStartOf="@id/mainn2"
                            app:layout_constraintTop_toTopOf="@id/mainn2"
                            app:layout_constraintBottom_toTopOf="@id/mainn2"
                            app:layout_constraintEnd_toEndOf="@id/mainn2"
                            app:riv_corner_radius="50dp"
                            app:riv_border_color="#FFAA00"
                            app:riv_border_width="2dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3"
                            style="@style/FontMedium"
                            android:gravity="center"
                            android:elevation="24dp"
                            app:layout_constraintTop_toBottomOf="@id/img2"
                            app:layout_constraintBottom_toBottomOf="@id/img2"
                            app:layout_constraintEnd_toEndOf="@id/img2"
                            app:layout_constraintStart_toStartOf="@id/img2"
                            android:background="@drawable/rec"
                            android:backgroundTint="#FFAA00"
                            android:textSize="@dimen/_12sp"
                            android:textColor="@color/white"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:layout_marginTop="16dp"
                            android:gravity="bottom|center"
                            android:id="@+id/mainn2"
                            android:paddingBottom="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:background="@drawable/border_curve_right_20dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/rank3Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp"
                                android:text="--/--"
                                android:singleLine="true"
                                android:textColor="@color/white"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_10sp"
                                android:text="--/--"
                                android:singleLine="true"
                                android:textColor="#B7B3B3"/>
                            <TextView
                                android:id="@+id/points3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/FontMedium"
                                android:textSize="@dimen/_12sp"
                                android:text="0"
                                android:textColor="#FFAA00"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/FontMedium"
                                android:textSize="@dimen/_12sp"
                                android:text="--/--"
                                android:id="@+id/status3"
                                android:singleLine="true"
                                android:textColor="#FFAA00"/>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="-30dp"
            app:layout_constraintTop_toBottomOf="@id/view"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:layout_marginBottom="30dp"
                android:orientation="vertical">
                <include
                    android:visibility="gone"
                    android:id="@+id/dialog_filter"
                    layout="@layout/dialog_filter_leader_board"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/mainPage"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:padding="8dp"
                        android:id="@+id/exam_lay"
                        android:background="@drawable/dashed_border_line_curve_8dp_with_white_bg"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="4dp">
                                <TextView
                                    android:id="@+id/exam"
                                    style="@style/FontMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:text="Term 3rd exam"
                                    android:layout_marginStart="4dp"
                                    android:textColor="@color/black_varient3"
                                    android:textSize="@dimen/_14sp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <TextView
                                    android:id="@+id/date"
                                    style="@style/FontRegular"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="18 may 2025 - 21 may 2025"
                                    android:drawableStart="@drawable/carbon_time"
                                    android:drawablePadding="3dp"
                                    android:layout_marginTop="4dp"
                                    android:layout_marginStart="4dp"
                                    android:textColor="#555555"
                                    android:textSize="11sp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/name" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <EditText
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Search"
                            style="@style/FontRegular"
                            android:textSize="@dimen/_14sp"
                            android:inputType="text"
                            android:id="@+id/search"
                            android:layout_marginEnd="8dp"
                            android:singleLine="true"
                            android:imeOptions="actionSearch"
                            android:drawableStart="@drawable/ic_search"
                            android:drawablePadding="10dp"
                            android:paddingVertical="10dp"
                            android:paddingHorizontal="20dp"
                            android:textColor="@color/black"
                            android:background="@drawable/border_line_curve_10dp_grey"/>
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:id="@+id/filter"
                            android:src="@drawable/ic_filter_blue"/>
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/filter_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                    <include
                        android:id="@+id/no_data"
                        layout="@layout/layout_no_data_found"
                        android:visibility="gone"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:id="@+id/recycler1" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>