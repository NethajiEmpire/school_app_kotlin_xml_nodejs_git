<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/otp_rec"
    android:fitsSystemWindows="true"
    tools:context=".activity.LeaveApprovalActivity">
    <LinearLayout
        android:id="@+id/timeTableTop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/header">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:id="@+id/top"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/backarrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:background="@drawable/back_arrow"/>
                    <TextView
                        android:id="@+id/topHeader"
                        android:layout_marginStart="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toEndOf="@id/backarrow"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:textSize="@dimen/_18sp"
                        android:textColor="@color/colorPrimary"
                        style="@style/FontMedium"
                        android:text="Leave Request"/>
                    <ImageView
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        android:id="@+id/notify"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_marginEnd="12dp"
                        app:layout_constraintEnd_toStartOf="@id/profile"
                        android:src="@drawable/dash_notification"/>
                    <ImageView
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:id="@+id/profile"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:src="@drawable/ic_user_profile"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardElevation="0dp"
            app:cardCornerRadius="25dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:background="@color/white"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/page1"
                    android:visibility="visible"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/filter_lay"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="8dp"
                        app:layout_constraintTop_toBottomOf="@id/line1"
                        android:layout_height="wrap_content">
                        <EditText
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Search"
                            style="@style/FontRegular"
                            android:textSize="@dimen/_14sp"
                            android:layout_marginEnd="10dp"
                            android:inputType="text"
                            android:id="@+id/search"
                            android:singleLine="true"
                            android:imeOptions="actionSearch"
                            android:drawableStart="@drawable/ic_search"
                            android:drawablePadding="10dp"
                            android:paddingVertical="10dp"
                            android:paddingHorizontal="20dp"
                            android:textColor="@color/black"
                            android:background="@drawable/border_line_curve_8dp_grey"/>
                        <ImageView
                            android:id="@+id/filter"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/filter_icon_atten"/>
                    </LinearLayout>
                    <HorizontalScrollView
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingLeft="16dp"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/pendingTab"
                                android:padding="4dp"
                                android:background="@drawable/border_line_curve_24dp_primary"
                                android:gravity="center">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Pending"
                                    android:paddingHorizontal="6dp"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_14sp"
                                    android:drawablePadding="10dp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="06"
                                    android:textSize="@dimen/_10sp"
                                    android:gravity="center"
                                    android:textColor="@color/white"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/ic_round_line2"
                                    style="@style/FontRegular"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/rejectTab"
                                android:layout_marginStart="8dp"
                                android:padding="4dp"
                                android:background="@drawable/border_line_curve_24dp_grey"
                                android:gravity="center">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rejected "
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient6"
                                    android:paddingHorizontal="6dp"
                                    android:textSize="@dimen/_14sp"
                                    android:drawablePadding="10dp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="06"
                                    android:textSize="@dimen/_10sp"
                                    android:gravity="center"
                                    android:textColor="@color/white"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/ic_round_line_3"
                                    style="@style/FontRegular"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/approvedTab"
                                android:layout_marginStart="8dp"
                                android:padding="4dp"
                                android:background="@drawable/border_line_curve_24dp_grey"
                                android:gravity="center">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Approved "
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient6"
                                    android:paddingHorizontal="6dp"
                                    android:textSize="@dimen/_14sp"
                                    android:drawablePadding="10dp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="06"
                                    android:textSize="@dimen/_10sp"
                                    android:gravity="center"
                                    android:textColor="@color/white"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/ic_round_line_3"
                                    style="@style/FontRegular"/>
                            </LinearLayout>
                        </LinearLayout>
                    </HorizontalScrollView>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">
                        <include
                            android:id="@+id/noData"
                            android:visibility="gone"
                            layout="@layout/layout_no_data_found"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/leaveRequestRecycler" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/page2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:orientation="vertical">
                    <androidx.core.widget.NestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="4dp"
                                app:layout_constraintTop_toTopOf="parent"
                                android:background="@drawable/border_line_curve_10dp_very_light_gray">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="10dp">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">
                                        <ImageView
                                            android:layout_width="40dp"
                                            android:layout_height="40dp"
                                            app:riv_corner_radius="20dp"
                                            android:id="@+id/img"
                                            android:src="@drawable/ic_user_profile"/>
                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical"
                                            android:padding="4dp">
                                            <TextView
                                                android:id="@+id/name"
                                                style="@style/FontMedium"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="4dp"
                                                android:singleLine="true"
                                                android:text="Nethaji Hada"
                                                android:textColor="@color/black_varient3"
                                                android:textSize="14sp" />
                                            <TextView
                                                android:id="@+id/requestId"
                                                style="@style/FontRegular"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Teac23"
                                                android:singleLine="true"
                                                android:layout_marginStart="4dp"
                                                android:textColor="#818181"
                                                android:textSize="12sp"/>
                                        </LinearLayout>
                                        <TextView
                                            android:background="@drawable/border_curve_24dp"
                                            android:backgroundTint="#E8F6FF"
                                                android:id="@+id/leaveType"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:textSize="@dimen/_12sp"
                                            android:paddingHorizontal="16dp"
                                            android:paddingVertical="4dp"
                                            style="@style/FontMedium"
                                            android:textColor="#799BFF"
                                            android:layout_marginEnd="10dp"
                                            android:text="Sick "/>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/border_line_curve_8dp_light_rose"
                                        android:layout_marginTop="10dp"
                                        android:layout_marginBottom="12dp"
                                        android:orientation="vertical">
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="8dp"
                                            android:layout_marginHorizontal="6dp"
                                            android:orientation="horizontal">
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="Role"
                                                style="@style/FontRegular"
                                                android:textSize="14sp"
                                                android:textColor="#868686"/>
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:gravity="end"
                                                android:id="@+id/role"
                                                android:textColor="@color/black_varient3"
                                                android:paddingRight="10dp"
                                                android:text="Teacher"
                                                style="@style/FontRegular"
                                                android:textSize="14sp" />

                                        </LinearLayout>
                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="1dp"
                                            android:id="@+id/line1"
                                            android:background="#E9EDF4"/>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="6dp"
                                            android:id="@+id/clsLay"
                                            android:layout_marginHorizontal="6dp"
                                            android:orientation="horizontal">
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="Class &amp; Section"
                                                style="@style/FontRegular"
                                                android:textSize="14sp"
                                                android:textColor="#868686"/>
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="6th Std - A Sec"
                                                android:gravity="end"
                                                android:id="@+id/standard"
                                                android:textColor="@color/black_varient3"
                                                android:paddingRight="10dp"
                                                style="@style/FontRegular"
                                                android:textSize="14sp" />
                                        </LinearLayout>
                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="1dp"
                                            android:id="@+id/line2"
                                            android:background="#E9EDF4"/>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="6dp"
                                            android:id="@+id/boardLay"
                                            android:layout_marginHorizontal="6dp"
                                            android:orientation="horizontal">
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="Board"
                                                style="@style/FontRegular"
                                                android:textSize="14sp"
                                                android:textColor="#868686"/>
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="12 April 2014"
                                                android:gravity="end"
                                                android:id="@+id/board"
                                                android:textColor="@color/black_varient3"
                                                android:paddingRight="10dp"
                                                style="@style/FontRegular"
                                                android:textSize="14sp" />
                                        </LinearLayout>
                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="1dp"
                                            android:background="#E9EDF4"/>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="6dp"
                                            android:layout_marginHorizontal="6dp"
                                            android:orientation="horizontal">
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="Requested On"
                                                style="@style/FontRegular"
                                                android:textSize="14sp"
                                                android:textColor="#868686"/>
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="12 April 2014"
                                                android:gravity="end"
                                                android:id="@+id/requested"
                                                android:textColor="@color/black_varient3"
                                                android:paddingRight="10dp"
                                                style="@style/FontRegular"
                                                android:textSize="14sp" />
                                        </LinearLayout>
                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="1dp"
                                            android:background="#E9EDF4"/>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="6dp"
                                            android:layout_marginHorizontal="6dp"
                                            android:orientation="horizontal">
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="Start Date"
                                                style="@style/FontRegular"
                                                android:textSize="14sp"
                                                android:textColor="#868686"/>
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="14 April 2014"
                                                style="@style/FontRegular"
                                                android:textSize="14sp"
                                                android:id="@+id/from"
                                                android:gravity="end"
                                                android:textColor="@color/black_varient3"
                                                android:paddingRight="10dp"/>
                                        </LinearLayout>
                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="1dp"
                                            android:background="#E9EDF4"/>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="6dp"
                                            android:layout_marginHorizontal="6dp"
                                            android:orientation="horizontal">
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="End Date"
                                                style="@style/FontRegular"
                                                android:textSize="14sp"
                                                android:textColor="#868686"/>
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="14 April 2014"
                                                style="@style/FontRegular"
                                                android:textSize="14sp"
                                                android:id="@+id/to"
                                                android:gravity="end"
                                                android:textColor="@color/black_varient3"
                                                android:paddingRight="10dp"/>
                                        </LinearLayout>
                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="1dp"
                                            android:visibility="gone"
                                            android:background="#E9EDF4"/>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="6dp"
                                            android:visibility="gone"
                                            android:layout_marginHorizontal="6dp"
                                            android:orientation="horizontal">
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="Leave Type"
                                                style="@style/FontRegular"
                                                android:textSize="14sp"
                                                android:textColor="#868686"/>
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="Sick Leave"
                                                style="@style/FontRegular"
                                                android:id="@+id/type"
                                                android:textSize="14sp"
                                                android:gravity="end"
                                                android:textColor="@color/black_varient3"
                                                android:paddingRight="10dp"/>
                                        </LinearLayout>
                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="1dp"
                                            android:background="#E9EDF4"/>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="6dp"
                                            android:layout_marginHorizontal="6dp"
                                            android:orientation="horizontal">
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="Number of Days"
                                                style="@style/FontRegular"
                                                android:textSize="14sp"
                                                android:textColor="#868686"/>
                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="2 Days"
                                                style="@style/FontRegular"
                                                android:id="@+id/days"
                                                android:textSize="14sp"
                                                android:gravity="end"
                                                android:textColor="@color/black_varient3"
                                                android:paddingRight="10dp"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:padding="8dp"
                                android:layout_marginHorizontal="4dp"
                                android:background="@drawable/dashed_border_line_curve_8dp_with_white_bg"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/FontMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Reason"
                                    android:textColor="#868686"
                                    android:textSize="14sp" />
                                <com.lms.sch.customviews.SeeMoreTextView
                                    style="@style/FontRegular"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Fever and cold — need 2 days rest"
                                    android:textColor="#124090"
                                    android:id="@+id/reasonTxt"
                                    android:textSize="14sp" />
                                <com.lms.sch.customviews.SeeMoreTextView
                                    style="@style/FontRegular"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="need 2 days rest"
                                    android:textColor="@color/black_varient6"
                                    android:id="@+id/desc"
                                    android:textSize="14sp" />
                            </LinearLayout>
                            <TextView
                                style="@style/FontMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Approval Status"
                                android:layout_marginTop="12dp"
                                android:textColor="#868686"
                                android:textSize="14sp" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:layout_marginHorizontal="4dp"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/approve"
                                    style="@style/FontRegular"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Approve"
                                    android:layout_marginEnd="10dp"
                                    android:drawablePadding="6dp"
                                    android:drawableStart="@drawable/radio_empty"
                                    android:textColor="#868686"
                                    android:padding="4dp"
                                    android:layout_marginStart="4dp"
                                    android:textSize="14sp" />
                                <TextView
                                    android:id="@+id/reject"
                                    style="@style/FontRegular"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rejected"
                                    android:padding="4dp"
                                    android:drawablePadding="6dp"
                                    android:drawableStart="@drawable/radio_empty"
                                    android:textColor="#868686"
                                    android:layout_marginStart="4dp"
                                    android:textSize="14sp" />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/reasonLay"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/FontMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Reason"
                                    android:layout_marginTop="12dp"
                                    android:textColor="#868686"
                                    android:textSize="14sp" />
                                <EditText
                                    android:id="@+id/reason"
                                    android:layout_width="match_parent"
                                    android:layout_height="96dp"
                                    android:layout_marginHorizontal="4dp"
                                    android:hint="Write something here"
                                    android:paddingVertical="12dp"
                                    style="@style/FontRegular"
                                    android:layout_marginTop="12dp"
                                    android:gravity="start|top"
                                    android:inputType="textMultiLine"
                                    android:paddingHorizontal="16dp"
                                    android:background="@drawable/border_line_curve_8dp_light_blue"
                                    android:textColor="#999999"
                                    android:textColorHint="#999999"
                                    android:textSize="14sp" />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginVertical="12dp"
                                android:orientation="horizontal"
                                android:gravity="end">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingVertical="8dp"
                                    android:paddingHorizontal="40dp"
                                    android:textSize="@dimen/_14sp"
                                    android:layout_marginEnd="12dp"
                                    android:id="@+id/cancel"
                                    style="@style/FontRegular"
                                    android:background="@drawable/border_line_curve_4dp_grey"
                                    android:text="Cancel"
                                    android:textColor="@color/colorPrimary" />
                                <TextView
                                    android:id="@+id/submit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingVertical="8dp"
                                    android:paddingHorizontal="40dp"
                                    android:textSize="@dimen/_14sp"
                                    style="@style/FontRegular"
                                    android:background="@drawable/border_line_curve_4dp_navy_blue"
                                    android:backgroundTint="#232B68"
                                    android:text="Submit"
                                    android:textColor="#FFFFFF" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>