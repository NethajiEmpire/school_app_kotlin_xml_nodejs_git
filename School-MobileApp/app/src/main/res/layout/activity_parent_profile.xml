<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/parent_profile_background"
    tools:context=".activity.ParentProfileActivity">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/toplay">
        <View
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/view">
        </View>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/back"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:src="@drawable/back_arrow"/>
        <RelativeLayout
            android:id="@+id/profileContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="24dp"
            app:layout_constraintBottom_toTopOf="@id/card2"
            app:layout_constraintStart_toStartOf="@+id/toplay"
            app:layout_constraintEnd_toEndOf="@+id/toplay">
            <RelativeLayout
                android:id="@+id/imageContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">
                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/img"
                    android:layout_width="95dp"
                    android:layout_height="95dp"
                    app:riv_border_width="1dp"
                    app:riv_border_color="@color/grey"
                    app:riv_corner_radius="50dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_user_profile"/>
                <ImageView
                    android:id="@+id/editIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/edit"
                    android:layout_alignBottom="@id/img"
                    android:layout_alignEnd="@id/img"/>
            </RelativeLayout>
            <LinearLayout
                android:id="@+id/txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/imageContainer"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">
                <LinearLayout
                    android:id="@+id/nameLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:src="@drawable/uil_user"/>
                    <TextView
                        android:id="@+id/parentname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hada Nethaji"
                        android:layout_marginStart="3dp"
                        style="@style/FontSemiBold"
                        android:textSize="@dimen/_16sp"
                        android:textColor="@color/white"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5th Standard | Roll No: 29"
                    android:textColor="@color/white"
                    android:id="@+id/role"
                    android:textSize="@dimen/_14sp"
                    style="@style/FontRegular"/>
            </LinearLayout>
        </RelativeLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/card2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="30dp"
            android:layout_marginBottom="-40dp"
            app:layout_constraintTop_toBottomOf="@id/view"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginBottom="40dp"
                android:background="@color/white">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/white">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:id="@+id/stats_lay"
                            android:layout_margin="16dp"
                            android:gravity="center">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                app:layout_constraintTop_toTopOf="parent">
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:cardElevation="0dp"
                                    app:cardCornerRadius="10dp"
                                    android:id="@+id/card"
                                    android:layout_marginVertical="4dp"
                                    app:cardBackgroundColor="#005DFF">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:id="@+id/topBg"
                                        android:layout_marginStart="2dp"
                                        android:paddingVertical="8dp"
                                        android:paddingHorizontal="12dp"
                                        android:background="@drawable/border_line_curve_8dp_gray_with_gray_bg"
                                        android:orientation="vertical">
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="horizontal"
                                            android:gravity="center_vertical">
                                            <com.makeramen.roundedimageview.RoundedImageView
                                                android:id="@+id/profile"
                                                android:layout_width="48dp"
                                                android:layout_height="48dp"
                                                app:riv_corner_radius="24dp"
                                                app:riv_border_color="#efefef"
                                                app:riv_border_width=".5dp"
                                                android:src="@drawable/ic_user_profile" />
                                            <LinearLayout
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="2"
                                                android:layout_marginStart="12dp"
                                                android:orientation="vertical">
                                                <TextView
                                                    android:id="@+id/StdName"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text="Nethaji Hada"
                                                    android:textSize="@dimen/_16sp"
                                                    style="@style/FontMedium"
                                                    android:textColor="@color/black_varient3" />
                                                <TextView
                                                    android:id="@+id/rollNo"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text="Roll no: 211"
                                                    android:textSize="@dimen/_12sp"
                                                    style="@style/FontRegular"
                                                    android:textColor="@color/black_varient3" />
                                            </LinearLayout>
                                            <TextView
                                                android:id="@+id/status"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Active"
                                                android:background="@drawable/border_curve_24dp"
                                                android:backgroundTint="#FFE0E1"
                                                android:paddingHorizontal="12dp"
                                                android:paddingVertical="4dp"
                                                android:textSize="@dimen/_12sp"
                                                style="@style/FontRegular"
                                                android:textColor="#EA5455"
                                                android:layout_gravity="center_vertical" />

                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:paddingVertical="6dp"
                                            android:paddingHorizontal="10dp"
                                            android:layout_marginTop="8dp"
                                            android:background="@drawable/dashed_border_line_curve_8dp_with_white_bg"
                                            android:orientation="horizontal">
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:orientation="vertical">
                                                <TextView
                                                    android:id="@+id/feeDateType"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textColor="#868686"
                                                    style="@style/FontDefault"
                                                    android:textSize="12sp"
                                                    android:maxLines="1"
                                                    android:text="Class &amp; Section"/>
                                                <TextView
                                                    android:id="@+id/stdStand"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textColor="#333333"
                                                    style="@style/FontRegular"
                                                    android:textSize="12sp"
                                                    android:maxLines="2"
                                                    android:layout_marginTop="4dp"
                                                    android:text="2nd Std - ‘B’ Sec"/>
                                            </LinearLayout>
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:gravity="center"
                                                android:orientation="vertical">
                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textColor="#868686"
                                                    style="@style/FontDefault"
                                                    android:textSize="12sp"
                                                    android:maxLines="1"
                                                    android:text="Admission No"/>
                                                <TextView
                                                    android:id="@+id/admissionId"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textColor="#333333"
                                                    style="@style/FontRegular"
                                                    android:textSize="12sp"
                                                    android:maxLines="2"
                                                    android:layout_marginTop="4dp"
                                                    android:text="STU2024_055"/>
                                            </LinearLayout>
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:gravity="right"
                                                android:orientation="vertical">
                                                <TextView
                                                    android:id="@+id/amtType"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textColor="#868686"
                                                    style="@style/FontDefault"
                                                    android:textSize="12sp"
                                                    android:maxLines="1"
                                                    android:text="Relation"/>
                                                <TextView
                                                    style="@style/FontRegular"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="4dp"
                                                    android:ellipsize="end"
                                                    android:maxLines="2"
                                                    android:text="Daughter"
                                                    android:textColor="#333333"
                                                    android:textSize="12sp" />
                                            </LinearLayout>
                                        </LinearLayout>
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:id="@+id/line"
                            android:src="@drawable/dash_line"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/student_view"
                            android:visibility="visible"
                            android:orientation="vertical">
                            <LinearLayout
                                android:id="@+id/studentInfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="14dp"
                                android:background="@drawable/border_curve_line_1dp_gray"
                                android:layout_marginVertical="10dp"
                                android:layout_marginHorizontal="15dp">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/user_blue" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="My Information"
                                    android:textColor="#283593"
                                    android:textSize="14sp"
                                    style="@style/FontRegular"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"/>
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/forward_arrow" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/complaints"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="14dp"
                                android:background="@drawable/border_curve_line_1dp_gray"
                                android:layout_marginVertical="5dp"
                                android:layout_marginHorizontal="15dp">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_complaints" />
                                <TextView
                                    android:id="@+id/comp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Complaints"
                                    android:textColor="#283593"
                                    android:textSize="14sp"
                                    style="@style/FontRegular"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"/>
                                <ImageView
                                    android:id="@+id/forwardArraow"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/forward_arrow" />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:id="@+id/settings"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="14dp"
                                android:background="@drawable/border_curve_line_1dp_gray"
                                android:layout_marginVertical="5dp"
                                android:layout_marginHorizontal="15dp">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/circum_settings" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Settings"
                                    android:textColor="#283593"
                                    android:textSize="14sp"
                                    style="@style/FontRegular"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"/>
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/forward_arrow" />
                            </LinearLayout>

                        </LinearLayout>
                        <LinearLayout
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/teacher_view"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="14dp"
                                android:background="@drawable/border_curve_line_1dp_gray"
                                android:layout_marginVertical="10dp"
                                android:layout_marginHorizontal="15dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/user_blue" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="My Details"
                                    android:textColor="#283593"
                                    android:textSize="14sp"
                                    style="@style/FontRegular"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"/>
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/forward_arrow" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/professionalDetalsTeacher"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="14dp"
                                android:background="@drawable/border_curve_line_1dp_gray"
                                android:layout_marginVertical="5dp"
                                android:layout_marginHorizontal="15dp">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/user_blue" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Complaints"
                                    android:textColor="#283593"
                                    android:textSize="14sp"
                                    style="@style/FontRegular"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"/>
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/forward_arrow" />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:id="@+id/leaveRequest"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="14dp"
                                android:background="@drawable/border_curve_line_1dp_gray"
                                android:layout_marginVertical="5dp"
                                android:layout_marginHorizontal="15dp">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/circum_settings" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Leave Request"
                                    android:textColor="#283593"
                                    android:textSize="14sp"
                                    style="@style/FontRegular"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"/>
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/forward_arrow" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/notificationinfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="14dp"
                                android:background="@drawable/border_curve_line_1dp_gray"
                                android:layout_marginVertical="5dp"
                                android:layout_marginHorizontal="15dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/bell_" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Notification"
                                    android:textColor="#283593"
                                    android:textSize="14sp"
                                    style="@style/FontRegular"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"/>
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/forward_arrow" />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="14dp"
                                android:background="@drawable/border_curve_line_1dp_gray"
                                android:layout_marginVertical="5dp"
                                android:layout_marginHorizontal="15dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/user_lock_1" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Privacy &amp; Policy"
                                    android:textColor="#283593"
                                    android:textSize="14sp"
                                    style="@style/FontRegular"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"/>
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/forward_arrow" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp"
                            android:id="@+id/logout"
                            android:background="@drawable/border_curve_line_1dp_gray"
                            android:layout_marginVertical="5dp"
                            android:layout_marginHorizontal="15dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/image_logout" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Logout"
                                android:textColor="#C83428"
                                android:textSize="14sp"
                                style="@style/FontRegular"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"/>
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/forward_arrow_red" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Android 1.0"
                            android:id="@+id/version"
                            android:layout_marginVertical="16dp"
                            style="@style/FontRegular"
                            android:textColor="#AFAFAF"
                            android:textSize="@dimen/_12sp"/>
                    </LinearLayout>

                </androidx.core.widget.NestedScrollView>
            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>