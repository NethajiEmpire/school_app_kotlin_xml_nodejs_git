<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/otp_rec"
    android:fitsSystemWindows="true"
    tools:context=".activity.TeacherProfileDetailsActivity">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/toplay">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/header">

            <androidx.constraintlayout.widget.ConstraintLayout
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="match_parent"
                android:paddingVertical="14dp"
                android:id="@+id/top"
                android:paddingHorizontal="16dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/backarrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:src="@drawable/back_arrow"/>
                <TextView
                    android:layout_marginStart="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/backarrow"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:textSize="@dimen/_16sp"
                    android:textColor="@color/colorPrimary"
                    android:id="@+id/pageHeading"
                    style="@style/FontMedium"
                    android:text="Term2 Fees"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/card2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="30dp"
            android:layout_marginBottom="-40dp"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginBottom="40dp"
                android:background="@color/white">
                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/lin">
                    <LinearLayout
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/white">

                        <LinearLayout
                            android:id="@+id/onlinePay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="12dp"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/border_line_curve_8dp_light_blue">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Payment details"
                                    android:padding="6dp"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="@dimen/_14sp"
                                    style="@style/FontMedium"/>
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_gravity="center"
                                    android:background="#DAEFFF"
                                    />
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:weightSum="4">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:padding="6dp"
                                        android:weightSum="2"
                                        android:orientation="horizontal">
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginVertical="2dp"
                                                android:text="Full Name"
                                                android:textSize="@dimen/_12sp"
                                                android:textColor="#89879C"
                                                style="@style/FontDefault"/>
                                            <TextView
                                                android:id="@+id/name"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginVertical="2dp"
                                                android:text="Alrin sherbi"
                                                android:singleLine="true"
                                                android:textSize="@dimen/_14sp"
                                                android:textColor="#636363"
                                                style="@style/FontRegular"/>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginVertical="2dp"
                                                android:text="Email"
                                                android:textSize="@dimen/_12sp"
                                                android:textColor="#89879C"
                                                style="@style/FontDefault"/>
                                            <TextView
                                                android:id="@+id/email"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginVertical="2dp"
                                                android:text="alrinsherbi@gmail.com"
                                                android:singleLine="true"
                                                android:textSize="@dimen/_14sp"
                                                android:textColor="#636363"
                                                style="@style/FontRegular"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:padding="6dp"
                                        android:weightSum="2"
                                        android:orientation="horizontal">
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginVertical="2dp"
                                                android:text="Mobile"
                                                android:textSize="@dimen/_12sp"
                                                android:textColor="#89879C"
                                                style="@style/FontDefault"/>
                                            <TextView
                                                android:id="@+id/mobile"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginVertical="2dp"
                                                android:text="9873456890"
                                                android:singleLine="true"
                                                android:textSize="@dimen/_14sp"
                                                android:textColor="#636363"
                                                style="@style/FontRegular"/>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginVertical="2dp"
                                                android:text="Grade"
                                                android:textSize="@dimen/_12sp"
                                                android:textColor="#89879C"
                                                style="@style/FontDefault"/>
                                            <TextView
                                                android:id="@+id/grade"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginVertical="2dp"
                                                android:text="9th Standard"
                                                android:singleLine="true"
                                                android:textSize="@dimen/_14sp"
                                                android:textColor="#636363"
                                                style="@style/FontRegular"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:padding="6dp"
                                        android:weightSum="2"
                                        android:orientation="horizontal">
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginVertical="2dp"
                                                android:text="Fees Name"
                                                android:textSize="@dimen/_12sp"
                                                android:textColor="#89879C"
                                                style="@style/FontDefault"/>
                                            <TextView
                                                android:id="@+id/typoffees"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginVertical="2dp"
                                                android:text="Term 2"
                                                android:singleLine="true"
                                                android:textSize="@dimen/_14sp"
                                                android:textColor="#636363"
                                                style="@style/FontRegular"/>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginVertical="2dp"
                                                android:text="Due Date"
                                                android:id="@+id/dateTxt"
                                                android:textSize="@dimen/_12sp"
                                                android:textColor="#89879C"
                                                style="@style/FontDefault"/>
                                            <TextView
                                                android:id="@+id/dueDate"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginVertical="2dp"
                                                android:text="29-09-2025"
                                                android:singleLine="true"
                                                android:textSize="@dimen/_14sp"
                                                android:textColor="#636363"
                                                style="@style/FontRegular"/>
                                        </LinearLayout>
                                     </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintTop_toTopOf="parent">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:id="@+id/onlineTab">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="12dp"
                                    android:orientation="vertical">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:layout_marginTop="8dp"
                                        android:background="@drawable/border_line_curve_10dp_grey">
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:weightSum="3"
                                            android:layout_marginTop="12dp"
                                            android:orientation="horizontal">
                                            <View
                                                android:layout_weight="1.2"
                                                android:layout_width="match_parent"
                                                android:layout_height="1dp"
                                                android:layout_gravity="center"
                                                android:background="@color/black_varient6"
                                                android:backgroundTint="#A5ADE7"/>
                                            <TextView
                                                android:paddingVertical="4dp"
                                                android:background="@drawable/border_curve_100dp_blue"
                                                android:layout_weight=".6"
                                                android:gravity="center"
                                                style="@style/FontRegular"
                                                android:textColor="@color/colorPrimary"
                                                android:textSize="@dimen/_14sp"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:text="Billing Summary "/>
                                            <View
                                                android:layout_weight="1.2"
                                                android:layout_width="match_parent"
                                                android:layout_height="1dp"
                                                android:layout_gravity="center"
                                                android:background="@color/black_varient6"
                                                android:backgroundTint="#A5ADE7" />
                                        </LinearLayout>
                                        <androidx.recyclerview.widget.RecyclerView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="8dp"
                                            android:id="@+id/recycler"/>
                                        <LinearLayout
                                            android:background="@drawable/border_curve_0dp_blue"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="12dp"
                                            android:orientation="horizontal">
                                            <TextView
                                                android:layout_weight="1"
                                                android:textAlignment="viewStart"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:text="Payable Amount"
                                                android:textColor="#333333"
                                                style="@style/FontRegular"
                                                android:textSize="@dimen/_14sp"/>
                                            <TextView
                                                android:id="@+id/totalAmount"
                                                android:textAlignment="textEnd"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="₹12,000"
                                                android:textColor="#00A606"
                                                style="@style/FontRegular"
                                                android:textSize="@dimen/_14sp"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:layout_marginHorizontal="12dp"
                                android:layout_marginBottom="30dp"
                                android:padding="12dp"
                                android:id="@+id/acknowledge_lay"
                                android:background="@drawable/border_curve_8dp_orange"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <ImageView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:padding="8dp"
                                        android:id="@+id/check"
                                        android:src="@drawable/rectangle_checkbox"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        style="@style/FontRegular"
                                        android:layout_gravity="center"
                                        android:textSize="@dimen/_14sp"
                                        android:gravity="center"
                                        android:textColor="@color/orange"
                                        android:text="Agree With Acknowledgement"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        style="@style/FontRegular"
                                        android:textSize="@dimen/_12sp"
                                        android:textColor="@color/black_varient6"
                                        android:text="I understand that the fees are non-refundable and confirm that the details mentioned above are correct."
                                        android:maxLines="2"/>

                                    <TextView
                                        style="@style/FontRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:maxLines="1"
                                        android:text="🔹 I agree to follow all the rules and regulations of the institution."
                                        android:textColor="@color/black_varient6"
                                        android:textSize="@dimen/_12sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:maxLines="1"
                                        style="@style/FontRegular"
                                        android:textSize="@dimen/_12sp"
                                        android:textColor="@color/black_varient6"
                                        android:text="🔹 Any outstanding dues will be cleared as per the school’s policies."/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:maxLines="1"
                                        style="@style/FontRegular"
                                        android:textSize="@dimen/_12sp"
                                        android:textColor="@color/black_varient6"
                                        android:text="🔹 I have received the official receipt for this payment."/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:id="@+id/lin"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Proceed to Pay"
                        style="@style/FontRegular"
                        android:id="@+id/next"
                        android:background="@drawable/ic_button_bg"
                        android:paddingVertical="14dp"
                        android:layout_margin="12dp"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:textColor="@color/white"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>