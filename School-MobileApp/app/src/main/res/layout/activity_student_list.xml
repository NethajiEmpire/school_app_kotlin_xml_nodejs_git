<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/otp_rec"
    android:fitsSystemWindows="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/header">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            android:paddingVertical="14dp"
            android:id="@+id/top"
            android:paddingHorizontal="16dp"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/back_arrow"/>
            <TextView
                android:id="@+id/topHeader"
                android:layout_marginStart="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/back"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textSize="@dimen/_16sp"
                android:textColor="@color/colorPrimary"
                style="@style/FontMedium"
                android:text="Students List"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:id="@+id/notify"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginEnd="12dp"
                android:visibility="gone"
                app:layout_constraintEnd_toStartOf="@id/profile"
                android:src="@drawable/dash_notification"/>
            <com.makeramen.roundedimageview.RoundedImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/profile"
                app:riv_corner_radius="24dp"
                android:visibility="gone"
                app:riv_border_color="#efefef"
                app:riv_border_width=".5dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/ic_user_profile"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardElevation="0dp"
        app:cardCornerRadius="25dp"
        android:layout_marginBottom="-25dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:layout_marginBottom="25dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/border_line_curve_10dp_grey"
                    android:orientation="vertical">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_height="wrap_content">
                        <com.makeramen.roundedimageview.RoundedImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:id="@+id/sub"
                            app:riv_corner_radius="8dp"
                            app:riv_border_color="#efefef"
                            app:riv_border_width=".5dp"
                            app:layout_constraintStart_toStartOf="parent"
                            android:src="@drawable/sub"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            app:layout_constraintStart_toEndOf="@+id/sub"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mathematics"
                                android:textSize="@dimen/_16sp"
                                style="@style/FontMedium"
                                android:textColor="@color/colorPrimary"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="9th STD"
                                android:textSize="@dimen/_12sp"
                                style="@style/FontRegular"
                                android:textColor="@color/black_varient6"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:padding="4dp"
                            android:id="@+id/click"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:src="@drawable/mingcute_down_arrow"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:id="@+id/downLay"
                        android:visibility="gone"
                        android:background="@drawable/dashed_border_line_curve_8dp"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:weightSum="3"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:paddingStart="6dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Attendance"
                                    android:textSize="@dimen/_12sp"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient6"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="86%"
                                    android:layout_marginTop="3dp"
                                    android:textSize="@dimen/_14sp"
                                    style="@style/FontMedium"
                                    android:textColor="@color/black_varient3"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:paddingStart="6dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Class test"
                                    android:textSize="@dimen/_12sp"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient6"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="46%"
                                    android:layout_marginTop="3dp"
                                    android:textSize="@dimen/_14sp"
                                    style="@style/FontMedium"
                                    android:textColor="@color/black_varient3"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:paddingStart="6dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Examination"
                                    android:textSize="@dimen/_12sp"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient6"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="86%"
                                    android:layout_marginTop="3dp"
                                    android:textSize="@dimen/_14sp"
                                    style="@style/FontMedium"
                                    android:textColor="@color/black_varient3"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:weightSum="3"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:paddingStart="6dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Home Work"
                                    android:textSize="@dimen/_12sp"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient6"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="56%"
                                    android:layout_marginTop="3dp"
                                    android:textSize="@dimen/_14sp"
                                    style="@style/FontMedium"
                                    android:textColor="@color/black_varient3"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:paddingStart="6dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Assigments"
                                    android:textSize="@dimen/_12sp"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient6"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="66%"
                                    android:layout_marginTop="3dp"
                                    android:textSize="@dimen/_14sp"
                                    style="@style/FontMedium"
                                    android:textColor="@color/black_varient3"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:paddingStart="6dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Projects"
                                    android:textSize="@dimen/_12sp"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient6"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="95%"
                                    android:layout_marginTop="3dp"
                                    android:textSize="@dimen/_14sp"
                                    style="@style/FontMedium"
                                    android:textColor="@color/black_varient3"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/filter_lay2"
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:layout_marginVertical="6dp"
                    android:paddingHorizontal="12dp"
                    app:layout_constraintTop_toBottomOf="@id/line1"
                    android:layout_height="wrap_content">
                    <EditText
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="Search"
                        style="@style/FontRegular"
                        android:textSize="@dimen/_14sp"
                        android:layout_marginEnd="10dp"
                        android:inputType="text"
                        android:id="@+id/search2"
                        android:singleLine="true"
                        android:imeOptions="actionSearch"
                        android:drawableStart="@drawable/ic_search"
                        android:drawablePadding="10dp"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="20dp"
                        android:textColor="@color/black"
                        android:background="@drawable/border_line_curve_8dp_grey"/>
                    <ImageView
                        android:id="@+id/filter2"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_filter_blue"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:id="@+id/recycler"/>
                <include
                    android:visibility="gone"
                    android:id="@+id/noData"
                    layout="@layout/layout_no_data_found"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>