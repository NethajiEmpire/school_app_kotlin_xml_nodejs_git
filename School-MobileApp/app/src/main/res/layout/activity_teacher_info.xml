<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/otp_rec"
    android:fitsSystemWindows="true"
    tools:context=".activity.StudentInfoActivity">
    <LinearLayout
        android:id="@+id/timeTableTop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/header">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="25dp"
                    android:id="@+id/top"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/backarrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:background="@drawable/back_arrow"/>
                    <TextView
                        android:id="@+id/topHeader"
                        android:layout_marginStart="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toEndOf="@id/backarrow"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:textSize="@dimen/_18sp"
                        android:textColor="@color/colorPrimary"
                        style="@style/FontMedium"
                        android:text="Teacher Info"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardElevation="0dp"
            app:cardCornerRadius="25dp"
            android:layout_marginBottom="-25dp">
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/scroll_view">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp"
                    android:layout_marginBottom="35dp"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/parentLayout"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="10dp"
                            android:orientation="vertical"
                            android:background="@drawable/border_line_curve_10dp_very_light_gray">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <ImageView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_gravity="center"
                                    android:id="@+id/tprofile"
                                    android:src="@drawable/ic_user_profile"/>
                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="4dp">
                                    <TextView
                                        android:id="@+id/name"
                                        style="@style/FontMedium"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:text="Nethaji Hada"
                                        android:layout_marginStart="4dp"
                                        android:textColor="@color/black_varient3"
                                        android:textSize="14sp"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />
                                    <TextView
                                        android:id="@+id/stdId"
                                        style="@style/FontMedium"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:text="STDID2434"
                                        android:layout_marginStart="4dp"
                                        android:textColor="#818181"
                                        android:textSize="12sp"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toBottomOf="@id/name" />
                                </androidx.constraintlayout.widget.ConstraintLayout>
                                <TextView
                                    android:background="@drawable/border_curve_24dp"
                                    android:backgroundTint="#D9FFDB"
                                    android:id="@+id/status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:textSize="@dimen/_14sp"
                                    android:paddingHorizontal="16dp"
                                    android:paddingVertical="4dp"
                                    style="@style/FontMedium"
                                    android:textColor="#32B138"
                                    android:text="Active"/>
                            </LinearLayout>
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1.5dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/dash_line"
                                android:backgroundTint="#DFDFDF"/>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawableStart="@drawable/ic_call_with_blue"
                                    android:drawablePadding="4dp"
                                    android:text="+91 98765 43210"
                                    android:id="@+id/mobile"
                                    android:textColor="#2B3580"
                                    android:textSize="12sp"
                                    style="@style/FontRegular" />
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:drawableStart="@drawable/ic_mail_with_blue"
                                        android:drawablePadding="4dp"
                                        android:text="nethajihada@gmail.com"
                                        android:textColor="#2B3580"
                                        android:id="@+id/email"
                                        android:textSize="12sp"
                                        style="@style/FontRegular" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/personalInfo_lay"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/border_line_curve_10dp_grey"
                                android:orientation="vertical">
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="10dp"
                                    android:layout_margin="1dp"
                                    android:background="@drawable/border_curve_6dp"
                                    android:orientation="horizontal"
                                    android:id="@+id/personalInformation">

                                    <TextView
                                        android:layout_alignParentStart="true"
                                        android:layout_centerVertical="true"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Personal Information"
                                        android:textSize="@dimen/_14sp"
                                        android:textColor="@color/black_varient3"
                                        style="@style/FontRegular"/>
                                    <ImageView
                                        android:id="@+id/down1"
                                        android:layout_alignParentEnd="true"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerVertical="true"
                                        android:background="@drawable/down_gradient"/>
                                </RelativeLayout>
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:id="@+id/v1"
                                    android:visibility="gone"
                                    android:background="#EFEFEF"/>
                                <androidx.recyclerview.widget.RecyclerView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="8dp"
                                    android:visibility="gone"
                                    android:id="@+id/personalInfoRecycler"/>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:visibility="visible"
                                    android:id="@+id/personalShowDetails">
                                    <LinearLayout
                                        app:layout_constraintTop_toTopOf="parent"
                                        android:layout_width="match_parent"
                                        android:weightSum="2"
                                        android:visibility="gone"
                                        android:layout_height="wrap_content">
                                        <LinearLayout
                                            android:layout_marginStart="6dp"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/_12sp"
                                                style="@style/FontRegular"
                                                android:text="Student ID"
                                                android:textColor="#89879C"/>
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/_14sp"
                                                style="@style/FontRegular"
                                                android:layout_marginTop="3dp"
                                                android:id="@+id/tId"
                                                android:text="TCH2025012"
                                                android:textColor="#636363"/>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:layout_marginStart="6dp"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/_12sp"
                                                style="@style/FontRegular"
                                                android:text="Blood Group"
                                                android:textColor="#89879C"/>
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/_14sp"
                                                android:id="@+id/bloodgroup"
                                                style="@style/FontRegular"
                                                android:layout_marginTop="3dp"
                                                android:text="B+"
                                                android:textColor="#636363"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                    <LinearLayout
                                        app:layout_constraintTop_toTopOf="parent"
                                        android:layout_width="match_parent"
                                        android:weightSum="2"
                                        android:visibility="gone"
                                        android:layout_height="wrap_content">
                                        <LinearLayout
                                            android:layout_marginStart="6dp"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/_12sp"
                                                style="@style/FontRegular"
                                                android:text="Gender"
                                                android:textColor="#89879C"/>
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/_14sp"
                                                style="@style/FontRegular"
                                                android:layout_marginTop="3dp"
                                                android:id="@+id/gender"
                                                android:text="Male"
                                                android:textColor="#636363"/>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_marginStart="6dp"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/_12sp"
                                                style="@style/FontRegular"
                                                android:text="Date of Birth"
                                                android:textColor="#89879C"/>
                                            <TextView
                                                android:id="@+id/dateOfBirth"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/_14sp"
                                                style="@style/FontRegular"
                                                android:layout_marginTop="3dp"
                                                android:text="12 April 2014"
                                                android:textColor="#636363"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                    <LinearLayout
                                        app:layout_constraintTop_toTopOf="parent"
                                        android:layout_width="match_parent"
                                        android:weightSum="2"
                                        android:visibility="gone"
                                        android:layout_height="wrap_content">
                                        <LinearLayout
                                            android:layout_marginStart="6dp"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/_12sp"
                                                style="@style/FontRegular"
                                                android:text="Address"
                                                android:textColor="#89879C"/>
                                            <TextView
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/_14sp"
                                                style="@style/FontRegular"
                                                android:layout_marginTop="3dp"
                                                android:id="@+id/address"
                                                android:text="5/22, Anna Nagar, Trichy, Tamil Nadu – 620001"
                                                android:textColor="#636363"/>
                                        </LinearLayout>
                                    </LinearLayout>

                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/academicInfo_lay"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/border_line_curve_10dp_grey"
                                android:orientation="vertical">
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="10dp"
                                    android:layout_margin="1dp"
                                    android:background="@drawable/border_curve_6dp"
                                    android:orientation="horizontal"
                                    android:id="@+id/academicInformation">
                                    <TextView
                                        android:layout_alignParentStart="true"
                                        android:layout_centerVertical="true"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Academic Information"
                                        android:textSize="@dimen/_14sp"
                                        android:textColor="@color/black_varient3"
                                        style="@style/FontRegular"/>
                                    <ImageView
                                        android:id="@+id/down3"
                                        android:layout_alignParentEnd="true"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerVertical="true"
                                        android:background="@drawable/down_gradient"/>
                                </RelativeLayout>
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:id="@+id/v3"
                                    android:visibility="gone"
                                    android:background="#EFEFEF"/>
                                <androidx.recyclerview.widget.RecyclerView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="8dp"
                                    android:visibility="gone"
                                    android:id="@+id/academicInfoRecycler"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/BankDetails"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/border_line_curve_10dp_grey"
                                android:orientation="vertical">
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="10dp"
                                    android:layout_margin="1dp"
                                    android:background="@drawable/border_curve_6dp"
                                    android:orientation="horizontal"
                                    android:id="@+id/parentInformation">
                                    <TextView
                                        android:layout_alignParentStart="true"
                                        android:layout_centerVertical="true"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Bank Details"
                                        android:textSize="@dimen/_14sp"
                                        android:textColor="@color/black_varient3"
                                        style="@style/FontRegular"/>
                                    <ImageView
                                        android:id="@+id/down2"
                                        android:layout_alignParentEnd="true"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerVertical="true"
                                        android:background="@drawable/down_gradient"/>
                                </RelativeLayout>
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:id="@+id/v2"
                                    android:visibility="gone"
                                    android:background="#EFEFEF"/>
                                <androidx.recyclerview.widget.RecyclerView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="8dp"
                                    android:visibility="gone"
                                    android:id="@+id/Bankrecycle"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/documentInfo_lay"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/border_line_curve_10dp_grey"
                                android:orientation="vertical">
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="10dp"
                                    android:layout_margin="1dp"
                                    android:background="@drawable/border_curve_6dp"
                                    android:orientation="horizontal"
                                    android:id="@+id/documentInformation">

                                    <TextView
                                        android:layout_alignParentStart="true"
                                        android:layout_centerVertical="true"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Document Information"
                                        android:textSize="@dimen/_14sp"
                                        android:textColor="@color/black_varient3"
                                        style="@style/FontRegular"/>
                                    <ImageView
                                        android:id="@+id/down4"
                                        android:layout_alignParentEnd="true"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerVertical="true"
                                        android:background="@drawable/down_gradient"/>
                                </RelativeLayout>
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:id="@+id/v4"
                                    android:visibility="gone"
                                    android:background="#EFEFEF"/>
                                <androidx.recyclerview.widget.RecyclerView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="8dp"
                                    android:visibility="gone"
                                    android:id="@+id/documentInfoRecycler"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/LeaveAttendance"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/border_line_curve_10dp_grey"
                                android:orientation="vertical">
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="10dp"
                                    android:layout_margin="1dp"
                                    android:background="@drawable/border_curve_6dp"
                                    android:orientation="horizontal"
                                    android:id="@+id/LeaveAttendanceinfo">

                                    <TextView
                                        android:layout_alignParentStart="true"
                                        android:layout_centerVertical="true"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Leave &amp; Attendance"
                                        android:textSize="@dimen/_14sp"
                                        android:textColor="@color/black_varient3"
                                        style="@style/FontRegular"/>
                                    <ImageView
                                        android:id="@+id/down5"
                                        android:layout_alignParentEnd="true"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerVertical="true"
                                        android:background="@drawable/down_gradient"/>
                                </RelativeLayout>
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:id="@+id/v5"
                                    android:visibility="gone"
                                    android:background="#EFEFEF"/>
                                <androidx.recyclerview.widget.RecyclerView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="8dp"
                                    android:visibility="gone"
                                    android:id="@+id/leaverecycle"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>