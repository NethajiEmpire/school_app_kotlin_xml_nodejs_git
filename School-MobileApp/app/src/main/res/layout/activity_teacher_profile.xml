<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/profile_background"
    tools:context=".activity.TeacherProfileActivity">
      <LinearLayout
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:orientation="vertical">
         <androidx.constraintlayout.widget.ConstraintLayout
             android:layout_width="match_parent"
             android:layout_height="match_parent"
             android:orientation="vertical">
            <View
                android:id="@+id/head"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="200dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/parentcn"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
               <ImageView
                   android:id="@+id/backarrow"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   app:layout_constraintStart_toStartOf="parent"
                   app:layout_constraintBottom_toBottomOf="parent"
                   app:layout_constraintTop_toTopOf="parent"
                   android:background="@drawable/back_arrow"/>
               <TextView
                   android:id="@+id/topHeader"
                   android:layout_marginStart="16dp"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   app:layout_constraintStart_toEndOf="@id/backarrow"
                   app:layout_constraintTop_toTopOf="parent"
                   app:layout_constraintBottom_toBottomOf="parent"
                   android:textSize="@dimen/_18sp"
                   android:textColor="@color/white"
                   style="@style/FontMedium"
                   android:text="Profile"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/profile"
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:riv_corner_radius="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_user_profile"
                android:scaleType="centerCrop"
                android:elevation="54dp"
                app:layout_constraintTop_toTopOf="@+id/lay"
                app:layout_constraintBottom_toTopOf="@id/lay"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
<!--             <com.makeramen.roundedimageview.RoundedImageView-->
<!--                 android:id="@+id/profile"-->
<!--                 android:layout_width="40dp"-->
<!--                 android:layout_height="40dp"-->
<!--                 app:riv_corner_radius="20dp"-->
<!--                 android:layout_gravity="center"-->
<!--                 app:layout_constraintTop_toTopOf="@+id/lay"-->
<!--                 app:layout_constraintBottom_toTopOf="@id/lay"-->
<!--                 app:layout_constraintStart_toStartOf="parent"-->
<!--                 app:layout_constraintEnd_toEndOf="parent"-->
<!--                 android:src="@drawable/ic_user_profile"/>-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/lay"
                android:elevation="24dp"
                app:layout_constraintTop_toBottomOf="@id/head"
                app:layout_constraintBottom_toBottomOf="@id/head">
               <LinearLayout
                   android:id="@+id/detailLayout"
                   android:layout_marginHorizontal="25dp"
                   android:layout_width="0dp"
                   android:background="@drawable/border_line_curve_10dp_light_grey_blue"
                   android:padding="6dp"
                   android:layout_height="wrap_content"
                   app:layout_constraintTop_toTopOf="parent"
                   android:orientation="vertical"
                   app:layout_constraintStart_toStartOf="parent"
                   app:layout_constraintEnd_toEndOf="parent">
                  <TextView
                      android:id="@+id/name"
                      style="@style/FontRegular"
                      android:layout_gravity="center"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="Karthick"
                      android:layout_marginTop="45dp"
                      android:textColor="@color/black_varient3"/>
                  <TextView
                      style="@style/FontRegular"
                      android:id="@+id/teacherId"
                      android:layout_gravity="center"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="TCH8765"
                      android:textColor="#868686"/>
                  <TextView
                      style="@style/FontRegular"
                      android:id="@+id/role"
                      android:layout_gravity="center"
                      android:background="@drawable/border_curve_24dp"
                      android:backgroundTint="#1A59EB8A"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="Science"
                      android:textSize="@dimen/_12sp"
                      android:paddingHorizontal="16dp"
                      android:paddingVertical="2dp"
                      android:textColor="#32B138"/>
                  <View
                      android:layout_width="match_parent"
                      android:layout_height="1.5dp"
                      android:layout_marginTop="8dp"
                      android:background="@drawable/dash_line"
                      android:backgroundTint="#DFDFDF"/>

                   <View
                       android:id="@+id/view"
                       android:layout_width="match_parent"
                       android:layout_height="100dp" />

                   <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:paddingVertical="8dp"
                      android:gravity="center"
                      android:weightSum="2">
                     <TextView
                         android:id="@+id/mobile"
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:drawableStart="@drawable/ic_call_with_blue"
                         android:drawablePadding="4dp"
                         android:textSize="@dimen/_12sp"
                         style="@style/FontRegular"
                         android:singleLine="true"
                         android:textColor="@color/colorPrimary"
                         android:text="+91 98765 43210"/>
                     <TextView
                         android:id="@+id/email"
                         android:layout_width="wrap_content"
                         android:drawableStart="@drawable/ic_mail_with_blue"
                         android:drawablePadding="4dp"
                         android:layout_height="wrap_content"
                         android:textSize="@dimen/_12sp"
                         android:layout_marginStart="16dp"
                         android:singleLine="true"
                         style="@style/FontRegular"
                         android:textColor="@color/colorPrimary"
                         android:text="sasikumar@school.edu"/>
                  </LinearLayout>


               </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FDFDFD"
                app:layout_constraintTop_toBottomOf="@id/head"
                app:layout_constraintBottom_toBottomOf="parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/teacher_view"
                        android:orientation="vertical">
                        <LinearLayout
                            android:id="@+id/myDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp"
                            android:background="@drawable/border_line_curve_10dp_light_grey_blue"
                            android:layout_marginVertical="5dp"
                            android:layout_marginHorizontal="15dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/user_blue" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="My Details"
                                android:textColor="#283593"
                                android:textSize="14sp"
                                style="@style/FontRegular"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"/>
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/forward_arrow" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/professionalDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp"
                            android:visibility="gone"
                            android:background="@drawable/border_line_curve_10dp_light_grey_blue"
                            android:layout_marginVertical="5dp"
                            android:layout_marginHorizontal="15dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/professioal" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Professional Details"
                                android:textColor="#283593"
                                android:textSize="14sp"
                                style="@style/FontRegular"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"/>
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/forward_arrow" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:id="@+id/leaveRequest"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp"
                            android:background="@drawable/border_line_curve_10dp_light_grey_blue"
                            android:layout_marginVertical="5dp"
                            android:layout_marginHorizontal="15dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/line" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Leave Request"
                                android:textColor="#283593"
                                android:textSize="14sp"
                                style="@style/FontRegular"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"/>
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/forward_arrow" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/complaints"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp"
                            android:background="@drawable/border_curve_line_1dp_gray"
                            android:layout_marginVertical="5dp"
                            android:layout_marginHorizontal="15dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_complaints" />
                            <TextView
                                android:id="@+id/comp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Complaints"
                                android:textColor="#283593"
                                android:textSize="14sp"
                                style="@style/FontRegular"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"/>
                            <ImageView
                                android:id="@+id/forwardArraow"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/forward_arrow" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/notification"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp"
                            android:background="@drawable/border_line_curve_10dp_light_grey_blue"
                            android:layout_marginVertical="5dp"
                            android:layout_marginHorizontal="15dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/bell_" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Notification"
                                android:textColor="#283593"
                                android:textSize="14sp"
                                style="@style/FontRegular"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"/>
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/forward_arrow" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/privacy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp"
                            android:background="@drawable/border_line_curve_10dp_light_grey_blue"
                            android:layout_marginVertical="5dp"
                            android:layout_marginHorizontal="15dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/user_lock_1" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Privacy &amp; Policy"
                                android:textColor="#283593"
                                android:textSize="14sp"
                                style="@style/FontRegular"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"/>
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/forward_arrow" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        android:id="@+id/logout"
                        android:background="@drawable/border_line_curve_10dp_light_grey_blue"
                        android:layout_marginVertical="5dp"
                        android:layout_marginHorizontal="15dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/image_logout" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Logout"
                            android:textColor="#C83428"
                            android:textSize="14sp"
                            style="@style/FontRegular"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"/>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/forward_arrow_red" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
         </androidx.constraintlayout.widget.ConstraintLayout>
      </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>