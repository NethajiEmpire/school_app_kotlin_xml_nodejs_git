<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/otp_rec"
    android:fitsSystemWindows="true"
    tools:context=".activity.TeacherRaiseComplaintActivity">
    <LinearLayout
        android:id="@+id/complaintsTop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/header">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:id="@+id/backarrow"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/back_arrow"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:id="@+id/topHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="Complaints"
                        android:textSize="@dimen/_18sp"
                        android:textColor="@color/colorPrimary"
                        style="@style/FontMedium"
                        app:layout_constraintStart_toEndOf="@id/backarrow"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/raiseTab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Raise"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:paddingVertical="6dp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/border_curve_4dp_very_light_blue"
                        android:backgroundTint="#124090"
                        android:drawableStart="@drawable/ic_plus"
                        android:drawablePadding="4dp"
                        android:gravity="center"
                        android:textSize="14sp"
                        style="@style/FontRegular"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardElevation="0dp"
            app:cardCornerRadius="25dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/page1"
                    android:background="@color/white"
                    android:orientation="vertical">
                    <com.google.android.material.tabs.TabLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/tab_layout"
                        app:tabMaxWidth="0dp"
                        android:visibility="visible"
                        android:paddingStart="14dp"
                        app:tabRippleColor="@color/transparent"
                        app:tabIndicatorHeight="3dp"
                        app:tabGravity="fill"
                        app:tabIndicatorFullWidth="true"
                        app:tabIndicatorColor="@color/colorPrimary"
                        app:tabSelectedTextColor="@color/colorPrimary"
                        app:tabTextColor="@color/black_varient3"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/complaintPage"
                        android:visibility="visible"
                        android:padding="16dp"
                        android:orientation="vertical">
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="8dp">
                                <LinearLayout
                                    android:id="@+id/totalCmpTab"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:padding="8dp"
                                    android:background="@drawable/border_line_curve_8dp_grey"
                                    android:gravity="center">
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <TextView
                                            android:id="@+id/cmpNum"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="09"
                                            android:textSize="@dimen/_16sp"
                                            android:textColor="@color/colorPrimary"
                                            style="@style/FontRegular" />
                                        <TextView
                                            android:id="@+id/allCmp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Total Complaint's"
                                            android:textSize="12sp"
                                            android:textColor="#808080"
                                            android:singleLine="true"
                                            android:ellipsize="end"
                                            style="@style/FontRegular" />
                                    </LinearLayout>
                                    <ImageView
                                        android:id="@+id/iconImage"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:layout_marginStart="8dp"
                                        android:layout_gravity="center_vertical"
                                        android:src="@drawable/ic_group_complaints" />
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/unsCompTab"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:padding="8dp"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/border_line_curve_8dp_grey"
                                    android:gravity="center_vertical">
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical"
                                        android:gravity="center_vertical">
                                        <TextView
                                            android:id="@+id/uncmpNum"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="09"
                                            android:textSize="@dimen/_16sp"
                                            android:textColor="@color/colorPrimary"
                                            style="@style/FontRegular" />
                                        <TextView
                                            android:id="@+id/UnsolveCmpTxt"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Unsolved"
                                            android:textSize="@dimen/_12sp"
                                            android:textColor="#808080"
                                            style="@style/FontRegular" />
                                    </LinearLayout>
                                    <ImageView
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:layout_marginStart="8dp"
                                        android:layout_gravity="center_vertical"
                                        android:src="@drawable/ic_complaint_orange" />
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/solveTab"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:padding="8dp"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/border_line_curve_8dp_grey"
                                    android:gravity="center_vertical">
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical"
                                        android:gravity="center_vertical">
                                        <TextView
                                            android:id="@+id/solNum"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="09"
                                            android:textSize="@dimen/_16sp"
                                            android:textColor="@color/colorPrimary"
                                            style="@style/FontRegular" />

                                        <TextView
                                            android:id="@+id/solveTxt"
                                            style="@style/FontRegular"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Solved"
                                            android:textColor="#808080"
                                            android:textSize="@dimen/_12sp" />
                                    </LinearLayout>
                                    <ImageView
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:layout_marginStart="8dp"
                                        android:layout_gravity="center_vertical"
                                        android:src="@drawable/ic_complain_green" />
                                </LinearLayout>
                            </LinearLayout>
                        </HorizontalScrollView>
                        <LinearLayout
                            android:id="@+id/filter_lay"
                            android:layout_width="match_parent"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintTop_toBottomOf="@id/line1"
                            android:layout_height="wrap_content">
                            <EditText
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:hint="Search"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_14sp"
                                android:layout_marginEnd="10dp"
                                android:inputType="text"
                                android:id="@+id/search"
                                android:singleLine="true"
                                android:imeOptions="actionSearch"
                                android:drawableStart="@drawable/ic_search"
                                android:drawablePadding="10dp"
                                android:paddingVertical="8dp"
                                android:paddingHorizontal="20dp"
                                android:textColor="@color/black"
                                android:background="@drawable/border_line_curve_8dp_grey"/>
                            <ImageView
                                android:id="@+id/filter"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/filter_icon_atten"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/topTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Complaint's"
                            style="@style/FontSemiBold"
                            android:layout_marginTop="12dp"
                            android:textColor="#124090"
                            android:textSize="14dp"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="6dp"
                            android:visibility="visible"
                            android:orientation="vertical">
                            <include
                                android:id="@+id/no_data"
                                layout="@layout/layout_no_data_found"
                                android:visibility="gone"/>
                            <androidx.recyclerview.widget.RecyclerView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/complaintsRecyclerView" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/page2"
                    android:visibility="gone">
                    <LinearLayout
                        android:background="@drawable/border_line_curve_8dp_grey"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:orientation="vertical"
                            android:layout_marginBottom="20dp"
                            android:layout_weight="1">
                            <androidx.core.widget.NestedScrollView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView
                                        style="@style/FontRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Complaints Title"
                                        android:textColor="#4F4F4F"
                                        android:textSize="@dimen/_14sp" />
                                    <EditText
                                        android:id="@+id/title"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="textMultiLine"
                                        android:gravity="top"
                                        android:textSize="@dimen/_14sp"
                                        android:background="@drawable/border_line_curve_8dp_light_blue"
                                        android:paddingHorizontal="16dp"
                                        android:paddingVertical="12dp"
                                        android:textColorHint="#868686"
                                        android:textColor="#868686"
                                        android:hint="Enter your complaint title"
                                        style="@style/FontRegular" />
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/_14sp"
                                            android:textColor="#4F4F4F"
                                            style="@style/FontRegular"
                                            android:text="Description"/>
                                        <EditText
                                            android:id="@+id/desc"
                                            android:layout_width="match_parent"
                                            android:layout_height="90dp"
                                            android:inputType="textMultiLine"
                                            android:gravity="top"
                                            android:textSize="@dimen/_14sp"
                                            android:background="@drawable/border_line_curve_8dp_light_blue"
                                            android:paddingHorizontal="16dp"
                                            android:paddingVertical="12dp"
                                            android:textColorHint="#868686"
                                            android:textColor="#868686"
                                            android:hint="Write here...."
                                            style="@style/FontRegular" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/_14sp"
                                            android:textColor="#4F4F4F"
                                            style="@style/FontRegular"
                                            android:text="Category"/>

                                        <Spinner
                                            android:id="@+id/spinner"
                                            style="@style/SpinnerTheme1"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="8dp" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/_14sp"
                                            android:textColor="#4F4F4F"
                                            style="@style/FontRegular"
                                            android:text="ToWhom"/>

                                        <Spinner
                                            android:id="@+id/spinner1"
                                            style="@style/SpinnerTheme1"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="8dp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_marginTop="10dp"
                                        android:layout_gravity="center"
                                        android:paddingVertical="10dp"
                                        android:paddingHorizontal="8dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/_14sp"
                                            android:textColor="#4F4F4F"
                                            style="@style/FontRegular"
                                            android:text="Attachment"/>
                                        <LinearLayout
                                            app:layout_constraintTop_toTopOf="parent"
                                            app:layout_constraintEnd_toEndOf="parent"
                                            app:layout_constraintStart_toStartOf="parent"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:id="@+id/uploadLay"
                                            android:layout_marginTop="4dp"
                                            android:orientation="vertical">
                                            <TextView
                                                android:id="@+id/attach"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:hint="Choose File"
                                                android:background="@drawable/border_line_curve_8dp_light_blue"
                                                android:paddingVertical="12dp"
                                                android:layout_marginTop="8dp"
                                                android:paddingHorizontal="16dp"
                                                android:textColor="#868686"
                                                android:drawableEnd="@drawable/prime_upload"
                                                android:textSize="14sp"
                                                style="@style/FontRegular"/>
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/_12sp"
                                                android:layout_marginTop="2dp"
                                                style="@style/FontRegular"
                                                android:layout_gravity="left"
                                                android:textColor="#E34747"
                                                android:text="* Maximum size 5Mb"/>
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:id="@+id/attach_lay"
                                                android:visibility="gone"
                                                android:orientation="vertical">
                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textSize="@dimen/_14sp"
                                                    android:layout_marginTop="12dp"
                                                    style="@style/FontRegular"
                                                    android:id="@+id/uploadTxtt"
                                                    android:textColor="@color/black_varient3"
                                                    android:text="Uploaded Home Work"/>
                                                <androidx.recyclerview.widget.RecyclerView
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginVertical="8dp"
                                                    android:id="@+id/attachRecycler"/>
                                            </LinearLayout>
                                        </LinearLayout>
                                    </LinearLayout>
                                    <TextView
                                        android:id="@+id/submit"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Submit"
                                        android:textAllCaps="false"
                                        android:textColor="@color/white"
                                        android:background="@drawable/ic_button_bg"
                                        android:paddingVertical="12dp"
                                        android:gravity="center"
                                        android:layout_marginTop="16dp"
                                        android:paddingHorizontal="16dp"
                                        style="@style/FontRegular"
                                        android:textSize="14sp"/>
                                </LinearLayout>

                            </androidx.core.widget.NestedScrollView>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <include
        android:visibility="gone"
        android:id="@+id/dialogComplaint"
        layout="@layout/dialog_solve_complaints"/>
</androidx.constraintlayout.widget.ConstraintLayout>