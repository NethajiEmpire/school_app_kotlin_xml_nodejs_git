<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/border_line_curve_10dp_light_grey_blue"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/top"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:id="@+id/batch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2015 - 2018"
                    android:textSize="@dimen/_18sp"
                    style="@style/FontMedium"
                    android:textColor="@color/black_varient3" />
                <TextView
                    android:id="@+id/batchId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#BT345645"
                    android:textSize="@dimen/_16sp"
                    android:textColor="@color/black_varient6"
                    style="@style/FontRegular" />
            </LinearLayout>
            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_12sp"
                style="@style/FontDefault"
                android:textColor="#348F23"
                android:layout_gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="3dp"
                android:background="@drawable/border_curve_16dp"
                android:backgroundTint="#E6FFE2"
                android:text="Active"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:id="@+id/view"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/top"
            android:background="@drawable/dash_line"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/view">
            <LinearLayout
                android:id="@+id/dateAndStatsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <TextView
                    android:id="@+id/startEndDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12.01.2022 - 16.06.2022"
                    android:drawableStart="@drawable/ic_clock_record"
                    android:drawablePadding="4dp"
                    android:drawableTint="#DDA50E"
                    android:layout_gravity="center"
                    style="@style/FontRegular"
                    android:gravity="center"
                    android:textColor="@color/black_varient6"
                    android:textSize="@dimen/_14sp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/teacherCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="142+"
                        android:textSize="@dimen/_14sp"
                        android:gravity="center"
                        android:textColor="@color/black_varient6"
                        android:drawableStart="@drawable/ic_teacher"
                        android:drawablePadding="3dp"
                        style="@style/FontRegular"
                        android:maxLines="2" />
                    <TextView
                        android:id="@+id/studentCounts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="2242+"
                        android:textColor="@color/black_varient6"
                        android:textSize="@dimen/_14sp"
                        android:gravity="center"
                        android:drawableStart="@drawable/ic_student"
                        style="@style/FontRegular" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/admissionSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:id="@+id/add_open"
                    android:src="@drawable/add_open"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
