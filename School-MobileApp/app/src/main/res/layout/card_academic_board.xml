<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="8dp"
        android:background="@drawable/border_line_curve_10dp_light_grey_blue"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:layout_width="3dp"
                android:layout_height="0dp"
                android:id="@+id/view"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:background="@drawable/border_curve_4dp"
                android:backgroundTint="#4CA5D5"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:id="@+id/top"
                app:layout_constraintStart_toEndOf="@id/view"
                app:layout_constraintEnd_toEndOf="parent"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.makeramen.roundedimageview.RoundedImageView
                            style="@style/FontRegular"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            app:riv_corner_radius="28dp"
                            android:id="@+id/img"
                            android:src="@drawable/sub"/>
                        <TextView
                            android:id="@+id/name"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="CBSE"
                            android:layout_gravity="center"
                            android:layout_marginStart="8dp"
                            android:textSize="@dimen/_18sp"
                            style="@style/FontMedium"
                            android:textColor="@color/black_varient3" />
                        <TextView
                            android:id="@+id/status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_12sp"
                            style="@style/FontDefault"
                            android:layout_gravity="center"
                            android:textColor="#348F23"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="3dp"
                            android:background="@drawable/border_curve_16dp"
                            android:backgroundTint="#E6FFE2"
                            android:text="Active"/>
                    </LinearLayout>
                    <com.lms.sch.customviews.SeeMoreTextView
                        android:id="@+id/desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="International General Certificate of Secondary Education"
                        android:textSize="@dimen/_12sp"
                        android:textColor="@color/black_varient6"
                        style="@style/FontRegular" />
                </LinearLayout>

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/top"
            android:background="@drawable/dash_line"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/clss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="142+"
                    android:textSize="@dimen/_14sp"
                    android:gravity="center"
                    android:drawableStart="@drawable/ic_teacher"
                    android:drawablePadding="3dp"
                    style="@style/FontRegular"
                    android:maxLines="2" />
                <TextView
                    android:id="@+id/studentCounts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="2242+"
                    android:textColor="#333333"
                    android:textSize="@dimen/_14sp"
                    android:gravity="center"
                    android:drawableStart="@drawable/ic_student"
                    style="@style/FontRegular" />
            </LinearLayout>
            <TextView
                android:id="@+id/boardId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#BT345645"
                android:layout_gravity="center"
                android:textSize="@dimen/_12sp"
                android:textColor="@color/black_varient6"
                style="@style/FontRegular" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
