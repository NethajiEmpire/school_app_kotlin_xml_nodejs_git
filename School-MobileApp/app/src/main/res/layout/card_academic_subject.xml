<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:padding="12dp"
        android:id="@+id/top"
        android:weightSum="2"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:background="@drawable/border_line_curve_10dp_grey">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:orientation="vertical">
            <com.makeramen.roundedimageview.RoundedImageView
                style="@style/FontRegular"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:riv_corner_radius="6dp"
                android:id="@+id/img"
                android:src="@drawable/sub"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight=".5"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="General Knowledge"
                    android:textSize="@dimen/_16sp"
                    android:layout_gravity="center"
                    android:id="@+id/subName"
                    style="@style/FontMedium"
                    android:textColor="@color/black_varient3"/>
                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_12sp"
                    style="@style/FontDefault"
                    android:textColor="#348F23"
                    android:layout_gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="3dp"
                    android:background="@drawable/border_curve_16dp"
                    android:backgroundTint="#E6FFE2"
                    android:text="Active"/>
            </LinearLayout>
            <com.lms.sch.customviews.SeeMoreTextView
                android:id="@+id/desc"
                style="@style/FontRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="GK is the study of Genaral Knowledge based on politics,captials, states etc.."
                android:textColor="#828282"
                android:textSize="@dimen/_12sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:weightSum="2"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        app:riv_corner_radius="20dp"
                        app:riv_border_width="1dp"
                        app:riv_border_color="@color/grey"
                        android:src="@drawable/stu1"/>
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:layout_marginStart="-14dp"
                        app:riv_corner_radius="20dp"
                        app:riv_border_width="1dp"
                        app:riv_border_color="@color/grey"
                        android:src="@drawable/stu2"/>
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:layout_marginStart="-14dp"
                        app:riv_corner_radius="20dp"
                        app:riv_border_width="1dp"
                        app:riv_border_color="@color/grey"
                        android:src="@drawable/stu1"/>
                    <TextView
                        style="@style/FontRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15+"
                        android:id="@+id/teacherCnt"
                        android:layout_gravity="center"
                        android:textColor="#828282"
                        android:layout_marginStart="4dp"
                        android:textSize="@dimen/_14sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/subId"
                    style="@style/FontRegular"
                    android:layout_width="wrap_content"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Sub ID\nSB250256"
                    android:layout_gravity="center"
                    android:textColor="#828282"
                    android:textSize="@dimen/_12sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>