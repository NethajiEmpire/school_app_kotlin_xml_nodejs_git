<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="10dp"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/border_line_curve_8dp_light_blue">
        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_16sp"
            style="@style/FontMedium"
            android:padding="10dp"
            android:textColor="@color/colorPrimary"
            android:text="Acknowledgement"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7D7D7"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dashed_border_line_curve_8dp"
            android:layout_margin="12dp"
            android:padding="8dp"
            android:visibility="gone"
            android:id="@+id/uploadLay"
            android:orientation="vertical">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:id="@+id/img_upload1"
                android:src="@drawable/upload_file"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_14sp"
                style="@style/FontRegular"
                android:id="@+id/txt"
                android:layout_gravity="center"
                android:layout_marginTop="7dp"
                android:textColor="@color/black"
                android:layout_centerVertical="true"
                android:text="Upload your signature with date"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="File Format Only PNG,JPG,JPEG"
                style="@style/FontMedium"
                android:textSize="12sp"
                android:layout_gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_below="@id/txt"
                android:id="@+id/title_txt2"
                android:textColor="@color/colorPrimary"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_14sp"
                    style="@style/FontRegular"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/black"
                    android:layout_centerVertical="true"
                    android:text="Application form"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/img_eye2"
                    android:layout_toStartOf="@id/img_upload2"
                    android:src="@drawable/frame_1597883016"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:id="@+id/img_upload2"
                    android:src="@drawable/frame_1597883017"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_14sp"
                    style="@style/FontRegular"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/black"
                    android:layout_centerVertical="true"
                    android:text="Declaration form"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/img_eye3"
                    android:layout_toStartOf="@id/img_upload3"
                    android:src="@drawable/frame_1597883016"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:id="@+id/img_upload3"
                    android:src="@drawable/frame_1597883017"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_12sp"
                style="@style/FontRegular"
                android:textColor="@color/black_varient3"
                android:text="Upload Your Signatue"/>
            <TextView
                android:id="@+id/student_attach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Choose File"
                android:background="@drawable/border_line_curve_8dp_light_blue"
                android:paddingVertical="12dp"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="16dp"
                android:textColor="#868686"
                android:drawableEnd="@drawable/prime_upload"
                android:textSize="14sp"
                style="@style/FontRegular"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_12sp"
                android:layout_marginTop="12dp"
                style="@style/FontRegular"
                android:textColor="@color/black_varient3"
                android:text="Upload Parent Signature"/>
            <TextView
                android:id="@+id/parent_attach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Choose File"
                android:background="@drawable/border_line_curve_8dp_light_blue"
                android:paddingVertical="12dp"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="16dp"
                android:textColor="#868686"
                android:drawableEnd="@drawable/prime_upload"
                android:textSize="14sp"
                style="@style/FontRegular"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_12sp"
                android:layout_marginTop="2dp"
                style="@style/FontRegular"
                android:layout_gravity="left"
                android:textColor="#E34747"
                android:text="* Maximum size 5Mb"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:visibility="gone"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtUpload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uploaded File"
                android:textColor="#000000"
                android:visibility="gone"
                android:textSize="@dimen/_12sp"
                style="@style/FontRegular"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerurl"
                android:layout_width="match_parent"
                android:layout_marginTop="7dp"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <CheckBox
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/colorPrimary"
        android:textColor="@color/black"
        android:id="@+id/check"
        android:text="I hereby declare that the information provided is
true and correct"
        android:textSize="@dimen/_12sp"
        style="@style/FontRegular"/>
</LinearLayout>
