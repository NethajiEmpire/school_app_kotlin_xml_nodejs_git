<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardCornerRadius="10dp"
            android:id="@+id/card"
            android:layout_marginVertical="4dp"
            app:cardBackgroundColor="#EB7172">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/topBg"
                android:layout_marginTop="2dp"
                android:paddingVertical="8dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/border_line_curve_8dp_gray_with_gray_bg"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/profile"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:riv_corner_radius="24dp"
                        app:riv_border_color="#efefef"
                        app:riv_border_width=".5dp"
                        android:src="@drawable/ic_user_profile" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nethaji Hada"
                            android:textSize="@dimen/_16sp"
                            style="@style/FontMedium"
                            android:textColor="@color/black_varient3" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Roll no: 211"
                            android:textSize="@dimen/_12sp"
                            style="@style/FontRegular"
                            android:textColor="@color/black_varient3" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending"
                        android:background="@drawable/border_curve_24dp"
                        android:backgroundTint="#FFE0E1"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:textSize="@dimen/_12sp"
                        style="@style/FontRegular"
                        android:textColor="#EA5455"
                        android:layout_gravity="center_vertical" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/dashed_border_line_curve_8dp_with_white_bg"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/feeDateType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#868686"
                            style="@style/FontDefault"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:text="Due Date"/>
                        <TextView
                            android:id="@+id/feeDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#333333"
                            style="@style/FontRegular"
                            android:textSize="12sp"
                            android:maxLines="2"
                            android:layout_marginTop="4dp"
                            android:text="16 May 2024"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="right"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/amtType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#868686"
                            style="@style/FontDefault"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:text="Pending Amount"/>

                        <TextView
                            android:id="@+id/date"
                            style="@style/FontRegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="₹1,80,000"
                            android:textColor="#EA5455"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>