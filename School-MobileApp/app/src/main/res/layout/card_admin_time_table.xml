<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/border_line_curve_10dp_grey_blue"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            android:layout_margin="1dp"
            app:cardElevation="0dp"
            android:id="@+id/card"
            app:cardBackgroundColor="#3F8BFB"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginStart="3dp"
                android:paddingVertical="6dp"
                android:id="@+id/linBg"
                android:background="#FBFBFB"
                android:orientation="horizontal">
                <LinearLayout
                    android:weightSum="3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="8dp"
                    android:layout_gravity="center"
                    android:paddingVertical="5dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1st Std - A sec"
                            style="@style/FontMedium"
                            android:singleLine="true"
                            android:id="@+id/standard"
                            android:ellipsize="end"
                            android:textSize="@dimen/_14sp"
                            android:textColor="#333333"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CL250011"
                            style="@style/FontRegular"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:id="@+id/program"
                            android:layout_marginTop="4dp"
                            android:textSize="@dimen/_12sp"
                            android:textColor="@color/black_varient6"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Incharge - Karthi"
                            style="@style/FontRegular"
                            android:singleLine="true"
                            android:id="@+id/incharge"
                            android:textSize="@dimen/_12sp"
                            android:textColor="@color/black_varient6"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2023/Jul - 2025/Jul"
                            style="@style/FontRegular"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:id="@+id/batch"
                            android:textSize="@dimen/_12sp"
                            android:textColor="#333333"/>
                        <TextView
                            android:id="@+id/subjects"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="8 Subjects"
                            android:gravity="center"
                            android:textSize="12sp"
                            android:paddingVertical="4dp"
                            android:textColor="#00355C"
                            style="@style/FontRegular"
                            android:background="@drawable/border_curve_16dp"
                            android:backgroundTint="#E1F0FB"
                            android:paddingHorizontal="8dp"
                            android:layout_marginTop="8dp"
                            android:drawablePadding="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>