<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:id="@+id/card"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#0C31FF">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:background="@drawable/border_line_curve_10dp_grey"
            android:backgroundTint="#F9F9F9">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:id="@+id/img"
                        android:src="@drawable/sub"/>
                    <TextView
                        android:layout_weight="1"
                        android:id="@+id/subjectName"
                        style="@style/FontRegular"
                        android:layout_width="0dp"
                        android:textSize="@dimen/_14sp"
                        android:layout_marginStart="6dp"
                        android:textStyle="bold"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:text="Mathematics"
                        android:textColor="@color/black_varient3" />
                    <TextView
                        android:id="@+id/status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#9C27B0"
                        android:paddingVertical="3dp"
                        android:paddingHorizontal="16dp"
                        android:text="Morning"
                        android:layout_gravity="center"
                        style="@style/FontRegular"
                        android:textSize="@dimen/_12sp"
                        android:background="@drawable/dashed_border_line_curve_17dp_with_pink"
                        />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/dashed_border_line_curve_6dp_blue"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="center">
                    <LinearLayout
                        android:id="@+id/row1"
                        android:layout_weight="1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Exam Date"
                                android:textColor="#868686"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp" />
                            <TextView
                                android:id="@+id/examDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="16 th May,2024"
                                android:textColor="#333333"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Timing"
                                android:textColor="#868686"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp" />
                            <TextView
                                android:id="@+id/timing"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10:00 AM – 12:00 PM"
                                android:textColor="#333333"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Duration"
                                android:textColor="#868686"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp" />
                            <TextView
                                android:id="@+id/duration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2 hours"
                                android:textColor="#333333"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/row2"
                        android:layout_weight="1"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Invigilator"
                                android:textColor="#868686"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp" />
                            <TextView
                                android:id="@+id/invisiletor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Karthick"
                                android:textColor="#333333"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Mark"
                                android:textColor="#868686"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp" />
                            <TextView
                                android:id="@+id/mark"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100 Mark"
                                android:textColor="#333333"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pass Mark"
                                android:textColor="#868686"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp" />
                            <TextView
                                android:id="@+id/passMark"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="35"
                                android:textColor="#333333"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>