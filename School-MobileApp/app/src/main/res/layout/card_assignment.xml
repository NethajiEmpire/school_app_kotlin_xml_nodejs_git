<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:cardCornerRadius="12dp"
        android:layout_marginBottom="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#3F8BFB">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:background="@drawable/border_line_curve_10dp_grey">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/subjectImg"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:src="@drawable/sub"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/subjectName"
                            style="@style/FontMedium"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_width="0dp"
                            android:textSize="@dimen/_14sp"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="English"
                            android:textColor="#333333" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/teacherName"
                            android:textSize="@dimen/_12sp"
                            style="@style/FontRegular"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/subjectName"
                            android:textColor="#828282"
                            android:text="Mrs. Anitha"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:visibility="visible"
                        android:id="@+id/status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_curve_24dp"
                        android:backgroundTint="#DAE7FF"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        style="@style/FontRegular"
                        android:paddingVertical="4dp"
                        android:layout_gravity="center"
                        android:textSize="@dimen/_12sp"
                        android:text="Ongoing"
                        android:textColor="#3F8BFB" />

                    <!-- <androidx.constraintlayout.widget.ConstraintLayout
                         android:layout_width="0dp"
                         android:layout_weight="1"
                         android:layout_height="wrap_content"
                         android:padding="4dp"
                         android:layout_marginStart="8dp"
                         android:orientation="vertical">
                         <TextView
                             android:id="@+id/subjectName"
                             style="@style/FontMedium"
                             app:layout_constraintStart_toStartOf="parent"
                             app:layout_constraintTop_toTopOf="parent"
                             android:layout_width="0dp"
                             android:textSize="12sp"
                             android:layout_height="wrap_content"
                             android:ellipsize="end"
                             android:maxLines="2"
                             android:text="English"
                             android:textColor="#333333" />
                         <TextView
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:id="@+id/teacherName"
                             android:textSize="12sp"
                             style="@style/FontMedium"
                             app:layout_constraintStart_toStartOf="parent"
                             app:layout_constraintTop_toBottomOf="@id/subjectName"
                             android:textColor="#828282"
                             android:text="Mrs. Anitha"/>
                     </androidx.constraintlayout.widget.ConstraintLayout>-->

                   <!-- <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_curve_24dp"
                        android:backgroundTint="#DAE7FF"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="3dp"
                        style="@style/FontRegular"
                        android:id="@+id/assignmentStatus"
                        android:textSize="@dimen/_12sp"
                       android:layout_gravity="center"
                        android:text="New Assignment"
                        android:textColor="#3F8BFB" />-->

                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/border_line_curve_gray">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:id="@+id/lin1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/assignmentTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#232B68"
                            style="@style/FontRegular"
                            android:textSize="@dimen/_14sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="Linear Equations Assignment"/>
                        <com.lms.sch.customviews.SeeMoreTextView
                            android:id="@+id/desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#8F8F8F"
                            style="@style/FontRegular"
                            android:textSize="@dimen/_12sp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:layout_marginTop="4dp"
                            android:text="Write a 150-word essay about your favorite festival. Mention why you like it, how it's celebrated, and..."/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="4dp"
                        android:layout_weight="1">

                        <TextView
                            style="@style/FontRegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Given Date"
                            android:textColor="@color/black_varient6"
                            android:textSize="@dimen/_12sp" />
                        <TextView
                            android:id="@+id/assGivenDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/hugeicons_date_time"
                            android:text="18-04-2025"
                            android:textColor="@color/black_varient3"
                            android:drawablePadding="4dp"
                            android:textSize="@dimen/_14sp"
                            style="@style/FontRegular"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="4dp"
                        android:layout_weight="1">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last Date"
                            android:id="@+id/submitTxt"
                            android:textSize="@dimen/_12sp"
                            android:textColor="@color/black_varient6"
                            style="@style/FontRegular"/>
                        <TextView
                            android:id="@+id/assUpdatedDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/FontRegular"
                            android:textSize="@dimen/_14sp"
                            android:drawableStart="@drawable/hugeicons_date_time_red"
                            android:drawablePadding="4dp"
                            android:textColor="@color/black_varient3"
                            android:text="21-04-2025"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="4dp"
                        android:gravity="start"
                        android:id="@+id/attachLay"
                        android:layout_weight="1">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/FontRegular"
                            android:textSize="@dimen/_12sp"
                            android:textColor="@color/black_varient6"
                            android:text="Attachment"/>
                        <TextView
                            android:id="@+id/attach"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_14sp"
                            android:drawableEnd="@drawable/pdf"
                            android:drawablePadding="3dp"
                            android:textColor="@color/black_varient3"
                            style="@style/FontRegular"
                            android:text="+2"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>