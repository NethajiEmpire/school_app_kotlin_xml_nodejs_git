<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:minWidth="320dp"
    android:maxWidth="320dp"
    android:layout_marginStart="12dp"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#3F8BFB"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:background="@drawable/border_line_curve_10dp_grey">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/subjectImg"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:src="@drawable/sub" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/subjectName"
                            style="@style/FontMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="English"
                            android:textColor="#333333"
                            android:textSize="@dimen/_14sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/teacherName"
                            style="@style/FontRegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mrs. Anitha"
                            android:textColor="#828282"
                            android:textSize="@dimen/_12sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/subjectName" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/status"
                        style="@style/FontRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@drawable/border_curve_24dp"
                        android:backgroundTint="#DAE7FF"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="2dp"
                        android:text="Ongoing"
                        android:textColor="#3F8BFB"
                        android:textSize="@dimen/_12sp" />

                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/border_line_curve_gray">

                    <LinearLayout
                        android:id="@+id/lin1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="6dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/assignmentTitle"
                            style="@style/FontRegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Linear Equations Assignment"
                            android:textColor="#232B68"
                            android:textSize="@dimen/_14sp" />

                        <com.lms.sch.customviews.SeeMoreTextView
                            android:id="@+id/desc"
                            style="@style/FontDefault"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Write a 150-word essay about your favorite festival. Mention why you like it, how it's celebrated, and..."
                            android:textColor="#8F8F8F"
                            android:textSize="@dimen/_12sp" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingVertical="4dp">

                        <TextView
                            style="@style/FontDefault"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Given Date"
                            android:textColor="@color/black_varient6"
                            android:textSize="@dimen/_12sp" />
                        <TextView
                            android:id="@+id/assGivenDate"
                            style="@style/FontRegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/hugeicons_date_time"
                            android:drawablePadding="4dp"
                            android:text="18-04-2025"
                            android:textColor="@color/black_varient3"
                            android:textSize="@dimen/_12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingVertical="4dp">

                        <TextView
                            style="@style/FontDefault"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last Date"
                            android:id="@+id/submitTxt"
                            android:textColor="@color/black_varient6"
                            android:textSize="@dimen/_12sp" />

                        <TextView
                            android:id="@+id/assUpdatedDate"
                            style="@style/FontRegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/hugeicons_date_time_red"
                            android:drawablePadding="4dp"
                            android:text="21-04-2025"
                            android:textColor="@color/black_varient3"
                            android:textSize="@dimen/_12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:id="@+id/attach_lay"
                        android:orientation="vertical"
                        android:paddingVertical="4dp">

                        <TextView
                            style="@style/FontDefault"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Attachment"
                            android:textAlignment="viewStart"
                            android:textColor="@color/black_varient6"
                            android:textSize="@dimen/_12sp" />
                        <TextView
                            android:id="@+id/attach"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_12sp"
                            android:drawableEnd="@drawable/pdf"
                            android:drawablePadding="3dp"
                            android:textColor="@color/black_varient3"
                            style="@style/FontRegular"
                            android:text="+2"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>