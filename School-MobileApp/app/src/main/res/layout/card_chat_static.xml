<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="16dp"
    android:layout_marginHorizontal="24dp"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/linear_chat"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingVertical="8dp"
            android:id="@+id/title"
            style="@style/FontRegular"
            android:visibility="gone"
            android:textColor="#333333"
            android:text="Today"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/layout_input"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:id="@+id/profile_img_layout">
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_user_profile"
                        android:layout_marginEnd="4dp"
                        android:id="@+id/profile_img"
                        app:riv_corner_radius="24dp"/>
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/profile_img_layout"
                    app:layout_constraintEnd_toEndOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        android:id="@+id/input_msg_layout">
                        <TextView
                            android:id="@+id/text_input_chat"
                            style="@style/FontRegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/border_curve_left_bot_16dp"
                            android:backgroundTint="#EAEAEA"
                            android:visibility="visible"
                            android:paddingVertical="10dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            android:paddingHorizontal="20dp"
                            android:layout_gravity="start"
                            android:text="Hey! How have you been?"
                            android:textColor="@color/black_varient3"
                            android:textSize="@dimen/_14sp" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="8dp"
                            android:visibility="gone"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            android:id="@+id/audio_input_chat"
                            android:layout_gravity="start"
                            android:background="@drawable/border_curve_24dp"
                            android:backgroundTint="#EAEAEA"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/play_img_input"
                                android:src="@drawable/player_play_icon"/>
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_play_audio_track"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="250dp"
                            android:layout_height="0dp"
                            android:adjustViewBounds="true"
                            android:background="@drawable/border_curve_left_bot_16dp"
                            android:backgroundTint="#EAEAEA"
                            android:src="@drawable/default_img1"
                            android:visibility="gone"
                            android:scaleType="centerCrop"
                            android:id="@+id/image_input_chat"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintDimensionRatio="1:1"/>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_play"
                            android:visibility="gone"
                            app:layout_constraintTop_toTopOf="@id/image_input_chat"
                            app:layout_constraintBottom_toBottomOf="@id/image_input_chat"
                            app:layout_constraintStart_toStartOf="@id/image_input_chat"
                            app:layout_constraintEnd_toEndOf="@id/image_input_chat"
                            android:id="@+id/play_video_input_chat"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/FontDefault"
                        android:layout_marginTop="6dp"
                        app:layout_constraintTop_toBottomOf="@id/input_msg_layout"
                        app:layout_constraintStart_toStartOf="parent"
                        android:textSize="@dimen/_12sp"
                        android:text="12:15 PM"
                        android:id="@+id/txt_input_time"
                        android:layout_gravity="start"
                        android:textColor="#666666"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/layout_output"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/text_output_chat"
                    style="@style/FontRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="20dp"
                    android:layout_marginTop="6dp"
                    android:visibility="visible"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:background="@drawable/border_curve_right_bot_16dp"
                    android:layout_gravity="end"
                    android:backgroundTint="#D2EBFF"
                    android:text="Awesome! Let’s meet up"
                    android:textColor="@color/black_varient3"
                    android:textSize="@dimen/_14sp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:id="@+id/audio_output_chat"
                    android:layout_gravity="end"
                    android:background="@drawable/border_curve_24dp"
                    android:backgroundTint="#D2EBFF"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/play_img_output"
                        android:src="@drawable/player_play_icon"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_play_audio_track"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="250dp"
                    android:layout_height="0dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/border_curve_right_bot_16dp"
                    android:backgroundTint="#EAEAEA"
                    android:src="@drawable/default_img1"
                    android:visibility="gone"
                    android:scaleType="centerCrop"
                    android:id="@+id/image_output_chat"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintDimensionRatio="1:1"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_play"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@id/image_output_chat"
                    app:layout_constraintBottom_toBottomOf="@id/image_output_chat"
                    app:layout_constraintStart_toStartOf="@id/image_output_chat"
                    app:layout_constraintEnd_toEndOf="@id/image_output_chat"
                    android:id="@+id/play_video_output_chat"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontDefault"
                android:layout_marginTop="6dp"
                android:layout_gravity="end"
                android:textSize="@dimen/_12sp"
                android:text="12:15 PM"
                android:id="@+id/txt_output_time"
                android:textColor="#666666"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/layout_input1"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:id="@+id/profile_img_layout1">
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_user_profile"
                        android:layout_marginEnd="4dp"
                        android:id="@+id/profile_img1"
                        app:riv_corner_radius="24dp"/>
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/profile_img_layout1"
                    app:layout_constraintEnd_toEndOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        android:id="@+id/input_msg_layout1">
                        <TextView
                            android:id="@+id/text_input_chat1"
                            style="@style/FontRegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/border_curve_left_bot_16dp"
                            android:backgroundTint="#EAEAEA"
                            android:visibility="gone"
                            android:paddingVertical="10dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            android:paddingHorizontal="20dp"
                            android:layout_gravity="start"
                            android:text="Hey! How have you been?"
                            android:textColor="@color/black_varient3"
                            android:textSize="@dimen/_14sp" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="8dp"
                            android:visibility="visible"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            android:id="@+id/audio_input_chat1"
                            android:layout_gravity="start"
                            android:background="@drawable/border_curve_24dp"
                            android:backgroundTint="#EAEAEA"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/play_img_input1"
                                android:src="@drawable/player_play_icon"/>
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_play_audio_track"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="250dp"
                            android:layout_height="0dp"
                            android:adjustViewBounds="true"
                            android:background="@drawable/border_curve_left_bot_16dp"
                            android:backgroundTint="#EAEAEA"
                            android:src="@drawable/default_img1"
                            android:visibility="gone"
                            android:scaleType="centerCrop"
                            android:id="@+id/image_input_chat1"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintDimensionRatio="1:1"/>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_play"
                            android:visibility="gone"
                            app:layout_constraintTop_toTopOf="@id/image_input_chat1"
                            app:layout_constraintBottom_toBottomOf="@id/image_input_chat1"
                            app:layout_constraintStart_toStartOf="@id/image_input_chat1"
                            app:layout_constraintEnd_toEndOf="@id/image_input_chat1"
                            android:id="@+id/play_video_input_chat1"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/FontDefault"
                        android:layout_marginTop="6dp"
                        app:layout_constraintTop_toBottomOf="@id/input_msg_layout1"
                        app:layout_constraintStart_toStartOf="parent"
                        android:textSize="@dimen/_12sp"
                        android:text="12:15 PM"
                        android:id="@+id/txt_input_time1"
                        android:layout_gravity="start"
                        android:textColor="#666666"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/layout_output1"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/text_output_chat1"
                    style="@style/FontRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="20dp"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:background="@drawable/border_curve_right_bot_16dp"
                    android:layout_gravity="end"
                    android:backgroundTint="#D2EBFF"
                    android:text="Awesome! Let’s meet up"
                    android:textColor="@color/black_varient3"
                    android:textSize="@dimen/_14sp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:id="@+id/audio_output_chat1"
                    android:layout_gravity="end"
                    android:background="@drawable/border_curve_24dp"
                    android:backgroundTint="#D2EBFF"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/play_img_output1"
                        android:src="@drawable/player_play_icon"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_play_audio_track"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="250dp"
                    android:layout_height="0dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/border_curve_right_bot_16dp"
                    android:backgroundTint="#EAEAEA"
                    android:src="@drawable/default_img1"
                    android:visibility="gone"
                    android:scaleType="centerCrop"
                    android:id="@+id/image_output_chat1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintDimensionRatio="1:1"/>
                <LinearLayout
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_weight=".4"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:background="@drawable/border_curve_right_bot_16dp"
                    android:backgroundTint="#EAEAEA"
                    android:orientation="vertical">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="10dp"
                        android:layout_weight=".4"
                        android:id="@+id/main"
                        app:layout_constraintDimensionRatio="1:1">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:id="@+id/img_lin2"
                            android:weightSum="2">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:id="@+id/img21"
                                android:scaleType="centerCrop"/>
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:id="@+id/img22"
                                android:layout_marginStart="1dp"
                                android:scaleType="centerCrop"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:id="@+id/img_lin3"
                            android:weightSum="2">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight=".8"
                                android:id="@+id/img31"
                                android:scaleType="centerCrop"/>
                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:layout_marginStart="1dp"
                                android:layout_weight="1.2">
                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:id="@+id/img32"
                                    android:layout_marginBottom="1dp"
                                    android:scaleType="centerCrop"/>
                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:id="@+id/img33"
                                    android:scaleType="centerCrop"/>
                            </androidx.appcompat.widget.LinearLayoutCompat>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:id="@+id/img_lin4"
                            android:orientation="vertical"
                            android:weightSum="2">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:weightSum="2"
                                android:layout_weight="1">
                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="1dp"
                                    android:id="@+id/img41"
                                    android:scaleType="centerCrop"/>
                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:id="@+id/img42"
                                    android:layout_marginStart="1dp"
                                    android:scaleType="centerCrop"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:weightSum="2"
                                android:layout_weight="1">
                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:layout_marginTop="1dp"
                                    android:layout_marginEnd="1dp"
                                    android:id="@+id/img43"
                                    android:scaleType="centerCrop"/>
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginTop="1dp"
                                    android:layout_marginStart="1dp"
                                    android:layout_weight="1">
                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:id="@+id/img44"
                                        android:scaleType="centerCrop"/>
                                    <View
                                        android:id="@+id/view44"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:alpha="0.7"
                                        android:visibility="invisible"
                                        android:background="#80000000" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:id="@+id/txt_img_count"
                                        android:textColor="@color/white"
                                        android:visibility="invisible"
                                        style="@style/FontMedium"
                                        android:text="2+"
                                        android:textSize="@dimen/_24sp"
                                        android:layout_centerInParent="true"
                                        android:layout_gravity="center"/>
                                </RelativeLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_play"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@id/image_output_chat1"
                    app:layout_constraintBottom_toBottomOf="@id/image_output_chat1"
                    app:layout_constraintStart_toStartOf="@id/image_output_chat1"
                    app:layout_constraintEnd_toEndOf="@id/image_output_chat1"
                    android:id="@+id/play_video_output_chat1"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontDefault"
                android:layout_marginTop="6dp"
                android:layout_gravity="end"
                android:textSize="@dimen/_12sp"
                android:text="12:15 PM"
                android:id="@+id/txt_output_time1"
                android:textColor="#666666"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>