<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="2"
            android:id="@+id/timetable_lay"
            android:visibility="visible"
            android:orientation="horizontal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mainLay"
                android:layout_width="80dp"
                android:layout_height="match_parent">

                <View
                    android:id="@+id/verticalLine"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:background="#DFDFDF"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/no"
                    app:layout_constraintEnd_toEndOf="@id/no"/>

                <TextView
                    android:id="@+id/startTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:15 AM"
                    android:maxWidth="50dp"
                    android:minWidth="50dp"
                    android:textSize="10sp"
                    style="@style/FontRegular"
                    android:textColor="#5A5A5A"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <TextView
                    android:id="@+id/no"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:text="1"
                    android:gravity="center"
                    android:textSize="@dimen/_14sp"
                    android:textColor="#232B68"
                    style="@style/FontMedium"
                    android:backgroundTint="#E0E6F3"
                    android:background="@drawable/ic_round"
                    android:layout_marginStart="5dp"
                    android:layout_marginHorizontal="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/startTime"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                android:id="@+id/card"
                android:layout_marginHorizontal="5dp"
                android:layout_marginVertical="4dp"
                app:cardBackgroundColor="#3F8BFB"
                app:layout_constraintBottom_toBottomOf="parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginStart="3dp"
                    android:paddingVertical="6dp"
                    android:id="@+id/linBg"
                    android:background="@drawable/border_curve_8dp"
                    android:backgroundTint="#F0F6FF"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="8dp"
                        android:layout_gravity="center"
                        android:paddingVertical="5dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="English"
                                style="@style/FontMedium"
                                android:singleLine="true"
                                android:id="@+id/subject"
                                android:ellipsize="end"
                                android:textSize="@dimen/_12sp"
                                android:textColor="#333333"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mrs. Anitha"
                                style="@style/FontDefault"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:id="@+id/teacher"
                                android:textSize="@dimen/_12sp"
                                android:textColor="#525252"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginEnd="10dp"
                            android:gravity="start"
                            android:orientation="vertical">
                            <TextView
                                android:drawableStart="@drawable/homework_dot"
                                android:drawablePadding="4dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Home Work"
                                style="@style/FontRegular"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:textSize="@dimen/_9sp"
                                android:textColor="#666666"/>
                            <TextView
                                android:drawableStart="@drawable/project_dot"
                                android:drawablePadding="4dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Project"
                                style="@style/FontRegular"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:textSize="@dimen/_9sp"
                                android:textColor="#666666"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="start"
                            android:orientation="vertical">
                            <TextView
                                android:drawableStart="@drawable/assignment_dot"
                                android:drawablePadding="4dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Assignment"
                                style="@style/FontRegular"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:textSize="@dimen/_9sp"
                                android:textColor="#666666"/>
                            <TextView
                                android:drawableStart="@drawable/class_test_dot"
                                android:drawablePadding="4dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Class Test"
                                style="@style/FontRegular"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:textSize="@dimen/_9sp"
                                android:textColor="#666666"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/week_lay"
            android:visibility="visible"
            android:orientation="horizontal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mainLay1"
                android:layout_width="80dp"
                android:layout_height="match_parent">

                <View
                    android:id="@+id/verticalLine1"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:background="#DFDFDF"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/no1"
                    app:layout_constraintEnd_toEndOf="@id/no1"/>

                <TextView
                    android:id="@+id/startTime1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:15 AM"
                    android:maxWidth="50dp"
                    android:minWidth="50dp"
                    android:textSize="10sp"
                    style="@style/FontRegular"
                    android:textColor="#5A5A5A"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <TextView
                    android:id="@+id/no1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:text="1"
                    android:gravity="center"
                    android:textSize="@dimen/_14sp"
                    android:visibility="invisible"
                    android:textColor="#232B68"
                    style="@style/FontMedium"
                    android:backgroundTint="#E0E6F3"
                    android:background="@drawable/ic_round"
                    android:layout_marginStart="5dp"
                    android:layout_marginHorizontal="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/startTime1"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:id="@+id/day_recycler"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1.5"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:visibility="visible"
                    android:id="@+id/breakLay"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="1dp"
                        android:background="#EFEFEF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Morning Break"
                        android:textSize="12sp"
                        android:id="@+id/break_txt"
                        android:paddingHorizontal="8dp"
                        android:layout_marginVertical="3dp"
                        style="@style/FontRegular"
                        android:textColor="#5A5A5A"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="1dp"
                        android:background="#EFEFEF"/>
                </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>