<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingVertical="10dp"
        android:padding="4dp"
        android:layout_margin="8dp"
        android:background="@drawable/border_curve_background_color_gray"
        android:orientation="horizontal">

        <ImageView
            android:paddingVertical="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/ic_user_profile" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:paddingVertical="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rank"
                style="@style/FontRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="1st Rank"
                android:textColor="#232B68"
                android:textSize="@dimen/_14sp" />

            <TextView
                android:id="@+id/points"
                style="@style/FontRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="480 Points"
                android:textColor="#909090"
                android:textSize="@dimen/_12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:paddingVertical="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                style="@style/FontRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Robin SD"
                android:textColor="#333333"
                android:textSize="@dimen/_14sp" />

            <TextView
                android:id="@+id/name1"
                style="@style/FontRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="480 Points"
                android:textColor="#909090"
                android:textSize="@dimen/_12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:paddingVertical="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                style="@style/FontRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="English, Math +2"
                android:textColor="#2BB82B"
                android:textSize="@dimen/_14sp" />

            <TextView
                android:id="@+id/discount"
                style="@style/FontRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subjects Mastered"
                android:textColor="#909090"
                android:singleLine="true"
                android:textSize="@dimen/_12sp" />
        </LinearLayout>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>