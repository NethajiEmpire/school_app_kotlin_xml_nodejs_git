<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="350dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/border_line_curve_10dp_grey"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:orientation="horizontal">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_marginStart="4dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:paddingVertical="2dp"
                        android:id="@+id/txt_title"
                        style="@style/FontMedium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_width="0dp"
                        android:textSize="@dimen/_14sp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Tution Fee"
                        android:textColor="@color/colorPrimary" />
                    <TextView
                        android:paddingVertical="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/txt_incharge"
                        android:textSize="@dimen/_12sp"
                        style="@style/FontDefault"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txt_title"
                        android:textColor="#A8A8A8"
                        android:text="1 st Term"/>
                    <TextView
                        android:layout_marginTop="4dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#FFEBEB"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="4dp"
                        android:textColor="#EA5455"
                        style="@style/FontDefault"
                        android:textSize="@dimen/_12sp"
                        android:background="@drawable/border_line_curve_12dp_grey"
                        android:text="Over Due"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:background="@drawable/dash_line"
                android:backgroundTint="#F0F0F0"
                />
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp">
                <ImageView
                    android:layout_marginStart="3dp"
                    android:textAlignment="center"
                    android:paddingVertical="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/carbon_information"
                    android:id="@+id/info_img"/>
                <TextView
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/info_img"
                    android:text="Last Date : "
                    android:textSize="@dimen/_12sp"
                    android:layout_marginStart="4dp"
                    style="@style/FontDefault"
                    android:textColor="#8A8888"
                    android:id="@+id/last_date"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="2dp"
                    android:textAlignment="center"
                    android:text="29-09-2025"
                    android:textSize="@dimen/_12sp"
                    style="@style/FontDefault"
                    android:textColor="#EA5455"
                    android:layout_toEndOf="@id/last_date"/>
            </RelativeLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:background="@drawable/dash_line"
                android:backgroundTint="#F0F0F0"
                />
            <LinearLayout
                android:layout_marginStart="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:weightSum="3">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="2">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="2dp"
                        android:text="Payable Amount"
                        android:textSize="@dimen/_14sp"
                        style="@style/FontMedium"
                        android:textColor="@color/colorPrimary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="2dp"
                        android:text="₹30,000"
                        android:textSize="@dimen/_12sp"
                        style="@style/FontMedium"
                        android:textColor="#32B138"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_gravity="center"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/back"
                        android:layout_weight="1"
                        style="@style/FontDefault"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_curve_8dp"
                        android:backgroundTint="@color/colorPrimary"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="Pay Now"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_12sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>