<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/border_line_curve_6dp_light_red"
        android:layout_margin="8dp"
        android:id="@+id/card"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:padding="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Term 1 Exam Timetable Released"
                    android:maxLines="1"
                    android:id="@+id/title"
                    android:ellipsize="end"
                    style="@style/FontRegular"
                    android:textSize="@dimen/_14sp"
                    android:textColor="@color/colorPrimary"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" The Term 1 examination timetable is n..."
                    style="@style/FontDefault"
                    android:maxLines="1"
                    android:id="@+id/desc"
                    android:ellipsize="end"
                    android:textSize="@dimen/_12sp"
                    android:textColor="#666666"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Exam"
                android:background="@drawable/border_curve_16dp"
                android:backgroundTint="#1AFF7475"
                android:paddingVertical="4dp"
                android:id="@+id/type"
                android:layout_gravity="center"
                android:paddingHorizontal="16dp"
                style="@style/FontDefault"
                android:textSize="@dimen/_12sp"
                android:textColor="#E85A5B"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFE6E6"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:padding="12dp"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01:00 PM - 02:00 PM"
                android:drawableStart="@drawable/time_line"
                android:drawablePadding="3dp"
                android:gravity="center"
                android:id="@+id/date"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                style="@style/FontRegular"
                android:textSize="@dimen/_12sp"
                android:textColor="#666666"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+2"
                android:drawableStart="@drawable/pdf"
                android:drawablePadding="3dp"
                android:gravity="center"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                style="@style/FontMedium"
                android:textSize="@dimen/_14sp"
                android:textColor="@color/colorPrimary"/>

        </RelativeLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>