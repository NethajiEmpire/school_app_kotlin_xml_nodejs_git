<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/border_curve_8dp"
        app:layout_constraintEnd_toStartOf="@+id/layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/num"
        android:gravity="center"
        android:layout_gravity="center"
        android:backgroundTint="@color/colorPrimary">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4"
            android:id="@+id/txt"
            style="@style/FontRegular"
            android:textColor="@color/white"
            android:textSize="@dimen/_18sp"/>
    </LinearLayout>
    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="#EFEFEF"
        app:layout_constraintTop_toBottomOf="@id/num"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/layout"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/num"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp"
        android:id="@+id/layout"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 Hours"
                    android:textSize="@dimen/_12sp"
                    style="@style/FontMedium"
                    android:id="@+id/type"
                    android:textColor="@color/black_varient3"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Social Science"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/border_curve_24dp"
                    android:textSize="@dimen/_16sp"
                    style="@style/FontMedium"
                    android:id="@+id/title"
                    android:textColor="@color/black_varient3"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        app:riv_corner_radius="10dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_user_profile"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Karthick (Invigilator)"
                        android:layout_marginStart="6dp"
                        android:textSize="@dimen/_14sp"
                        style="@style/FontRegular"
                        android:id="@+id/code"
                        android:textColor="@color/black_varient6"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingVertical="8dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/border_line_curve_8dp_grey"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FN"
                    android:textSize="@dimen/_16sp"
                    style="@style/FontSemiBold"
                    android:id="@+id/fn"
                    android:textColor="@color/colorPrimary"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="5dp"
                    android:background="#EFEFEF"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AN"
                    android:textSize="@dimen/_16sp"
                    style="@style/FontSemiBold"
                    android:id="@+id/an"
                    android:textColor="#E8E8E8"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="16dp"
            android:paddingVertical="12dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04/03/2025 - 10:30AM to 01:00PM"
                android:textSize="@dimen/_14sp"
                android:drawableStart="@drawable/hugeicons_date_time_green"
                android:drawablePadding="6dp"
                style="@style/FontRegular"
                android:id="@+id/date"
                android:textColor="@color/black_varient3"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100 Marks (20 Pass Marks)"
                android:layout_marginTop="8dp"
                android:textSize="@dimen/_14sp"
                android:drawableStart="@drawable/text"
                android:drawablePadding="6dp"
                android:drawableTint="@color/black_varient3"
                style="@style/FontRegular"
                android:id="@+id/mark"
                android:textColor="@color/black_varient3"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WEDNESDAY"
                android:textSize="@dimen/_14sp"
                android:layout_marginTop="8dp"
                android:id="@+id/day"
                style="@style/FontRegular"
                android:textColor="@color/colorPrimary"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:id="@+id/dashView"
            android:background="@drawable/dash_line"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:visibility="gone"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WEDNESDAY"
                android:textSize="@dimen/_14sp"
                style="@style/FontRegular"
                android:textColor="@color/colorPrimary"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 Theory | 2 Practical"
                    android:textSize="@dimen/_14sp"
                    android:id="@+id/theory"
                    style="@style/FontRegular"
                    android:textColor="@color/black_varient6"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hall Ticket"
                    android:drawableStart="@drawable/mynaui_download"
                    android:textSize="@dimen/_14sp"
                    android:layout_marginTop="8dp"
                    android:id="@+id/download"
                    android:drawablePadding="6dp"
                    style="@style/FontRegular"
                    android:textColor="@color/colorPrimary"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See Full Details"
                android:layout_gravity="center"
                android:background="@drawable/border_curve_4dp"
                android:backgroundTint="@color/colorPrimary"
                android:textSize="@dimen/_12sp"
                android:visibility="gone"
                style="@style/FontMedium"
                android:id="@+id/next"
                android:paddingVertical="6dp"
                android:paddingHorizontal="10dp"
                android:textColor="@color/white"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>