<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:background="@drawable/border_line_curve_10dp_grey_blue"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            android:layout_margin="1dp"
            app:cardElevation="0dp"
            android:id="@+id/card"
            app:cardBackgroundColor="#3F8BFB"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginStart="3dp"
                android:id="@+id/linBg"
                android:background="#FBFBFB"
                android:orientation="horizontal">
                <LinearLayout
                    android:weightSum="3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="12dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Today"
                                android:layout_gravity="center"
                                android:textSize="@dimen/_12sp"
                                android:paddingVertical="4dp"
                                android:textColor="#00355C"
                                style="@style/FontRegular"
                                android:background="@drawable/border_curve_16dp"
                                android:backgroundTint="#E1F0FB"
                                android:paddingHorizontal="14dp"
                                android:drawablePadding="4dp" />
                            <View
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="0dp"/>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/border_line_curve_10dp_grey_blue">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="FN"
                                    style="@style/FontRegular"
                                    android:singleLine="true"
                                    android:id="@+id/fn"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="6dp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    android:ellipsize="end"
                                    android:textSize="@dimen/_14sp"
                                    android:textColor="#999999"/>
                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="0dp"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintStart_toEndOf="@id/fn"
                                    app:layout_constraintEnd_toStartOf="@id/an"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    android:background="#EFEFEF"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="AN"
                                    style="@style/FontRegular"
                                    android:id="@+id/an"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="6dp"
                                    android:singleLine="true"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    android:ellipsize="end"
                                    android:textSize="@dimen/_14sp"
                                    android:textColor="#E9EDF4"/>

                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tamil"
                            style="@style/FontMedium"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:id="@+id/subject"
                            android:textSize="@dimen/_18sp"
                            android:textColor="#525252"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Half yearly Exam"
                            style="@style/FontDefault"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:id="@+id/examName"
                            android:textSize="@dimen/_14sp"
                            android:textColor="#348F23"/>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/dash_line"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="27 May 2025 | 01:00 PM - 03:00 PM | 3 Hours"
                            style="@style/FontRegular"
                            android:singleLine="true"
                            android:id="@+id/date"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:textSize="@dimen/_12sp"
                            android:textColor="#333333"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monday"
                            style="@style/FontRegular"
                            android:id="@+id/day"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textSize="@dimen/_14sp"
                            android:textColor="#666666"/>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>