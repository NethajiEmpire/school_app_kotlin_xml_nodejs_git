<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="320dp"
    android:minWidth="320dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/parentlay"
        android:background="@drawable/border_curve_15dp_orange"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2">
                    <TextView
                        android:id="@+id/typeOfExam"
                        android:layout_alignParentStart="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_14sp"
                        style="@style/FontRegular"
                        android:text="1st Mid-Term exam"
                        android:textColor="@color/colorPrimary"
                        android:textAlignment="viewStart"
                        />
                    <TextView
                        android:id="@+id/studentStatus"
                        android:paddingVertical="2dp"
                        android:paddingHorizontal="10dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/border_curve_16dp"
                        android:backgroundTint="#FFF8EB"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:textSize="@dimen/_12sp"
                        style="@style/FontRegular"
                        android:text="Ongoing"
                        android:textColor="#F39519"
                        android:textAlignment="viewEnd"
                        />

                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/linearlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:background="@drawable/border_curve_15dp_orangeborder">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_gravity="center">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="4dp"
                        android:layout_weight="1">

                        <TextView
                            style="@style/FontDefault"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start Date"
                            android:textColor="@color/black_varient6"
                            android:textSize="@dimen/_12sp" />
                        <TextView
                            android:id="@+id/startDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12 Mar 2024"
                            android:textColor="@color/black_varient3"
                            android:textSize="@dimen/_12sp"
                            style="@style/FontRegular"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="4dp"
                        android:layout_weight="1">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="End Date"
                            android:textSize="@dimen/_12sp"
                            android:textColor="@color/black_varient6"
                            style="@style/FontDefault"/>
                        <TextView
                            android:id="@+id/endDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/FontRegular"
                            android:textSize="@dimen/_12sp"
                            android:textColor="@color/black_varient3"
                            android:text="26 Mar 2024"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="4dp"
                        android:layout_weight="1">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/FontDefault"
                            android:textAlignment="viewStart"
                            android:textSize="@dimen/_12sp"
                            android:textColor="@color/black_varient6"
                            android:text="Total Subject"/>
                        <TextView
                            android:id="@+id/subjectCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_12sp"
                            android:textAlignment="viewStart"
                            android:textColor="@color/black_varient3"
                            style="@style/FontRegular"
                            android:text="5 Subjects"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>