<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_marginVertical="6dp"
            android:paddingVertical="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3"
            android:orientation="horizontal">
            <View
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_gravity="center"
                android:background="@color/black_varient6"
                android:backgroundTint="#A5ADE7"
                />
            <TextView
                android:paddingVertical="4dp"
                android:background="@drawable/border_curve_100dp_blue"
                android:layout_weight="1"
                android:gravity="center"
                android:id="@+id/title"
                style="@style/FontRegular"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_14sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Term 1"/>
            <View
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_gravity="center"
                android:background="@color/black_varient6"
                android:backgroundTint="#A5ADE7" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:visibility="gone"
            android:orientation="horizontal">
            <TextView
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tution Fees"
                android:textColor="#666666"
                style="@style/FontRegular"
                android:textSize="@dimen/_14sp"/>
            <TextView
                android:textAlignment="textEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹3,000"
                android:textColor="#111111"
                style="@style/FontRegular"
                android:textSize="@dimen/_14sp"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:visibility="gone"
            android:background="@drawable/dash_line"
            android:backgroundTint="#F0F0F0" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:visibility="gone"
            android:orientation="horizontal">
            <TextView
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Book Fees"
                android:textColor="#666666"
                style="@style/FontRegular"
                android:textSize="@dimen/_14sp"/>
            <TextView
                android:textAlignment="textEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹45,00"
                android:textColor="#111111"
                style="@style/FontRegular"
                android:textSize="@dimen/_14sp"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/recycler"/>
    </LinearLayout>
    <LinearLayout
        android:background="@drawable/border_line_curve_8dp_light_blue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:id="@+id/payable_lay"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:orientation="horizontal">
            <TextView
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Amount"
                android:textColor="#666666"
                style="@style/FontRegular"
                android:textSize="@dimen/_14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹3,000"
                android:id="@+id/tAmt"
                android:textColor="#333333"
                style="@style/FontRegular"
                android:textSize="@dimen/_14sp"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:background="@drawable/dash_line"
            android:backgroundTint="#F0F0F0" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:orientation="horizontal">
            <TextView
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Discount"
                android:textColor="#666666"
                style="@style/FontRegular"
                android:textSize="@dimen/_14sp"/>
            <TextView
                android:textAlignment="textEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹3,000"
                android:id="@+id/discount"
                android:textColor="#333333"
                style="@style/FontRegular"
                android:textSize="@dimen/_14sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@drawable/border_curve_8dp_bottom"
            android:backgroundTint="#005DA7"
            android:orientation="horizontal">
            <TextView
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Payable Amount"
                android:textColor="@color/white"
                style="@style/FontRegular"
                android:textSize="@dimen/_14sp"/>
            <TextView
                android:textAlignment="textEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹3,000"
                android:id="@+id/pAmt"
                android:textColor="@color/white"
                style="@style/FontRegular"
                android:textSize="@dimen/_14sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>