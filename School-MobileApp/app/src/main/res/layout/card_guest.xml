<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingVertical="5dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:id="@+id/title"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/status"
            android:textColor="#89879C"
            android:layout_centerVertical="true"
            android:paddingVertical="5dp"
            android:paddingHorizontal="3dp"
            style="@style/FontRegular"
            android:text="First Name *"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:id="@+id/status"
            android:visibility="gone"
            android:layout_centerVertical="true"
            android:backgroundTint="@color/green"
            android:background="@drawable/border_curve_24dp"
            android:layout_alignParentEnd="true"
            android:textColor="@color/black"
            android:paddingVertical="3dp"
            android:paddingHorizontal="8dp"
            style="@style/FontRegular"
            android:text="Approved"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical">
        <EditText
            android:inputType="textPersonName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_12sp"
            android:textColorHint="#C8C8C8"
            android:textColor="@color/black_varient3"
            style="@style/FontDefault"
            android:id="@+id/edt"
            android:paddingVertical="14dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/border_line_curve_8dp_light_blue"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="----"
            android:id="@+id/emailError"
            android:visibility="gone"
            android:textColor="#F02E2E"/>
        <EditText
            android:visibility="gone"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="textPersonName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_12sp"
            android:textColorHint="#C8C8C8"
            android:textColor="@color/black_varient3"
            style="@style/FontDefault"
            android:id="@+id/othertext"
            android:paddingVertical="14dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/border_line_curve_8dp_light_blue"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:textSize="@dimen/_12sp"
            android:textColorHint="#C8C8C8"
            android:textColor="@color/black_varient3"
            style="@style/FontDefault"
            android:visibility="gone"
            android:hint="enter"
            android:id="@+id/edt_big"
            android:gravity="top"
            android:paddingVertical="10dp"
            android:paddingHorizontal="14dp"
            android:inputType="textMultiLine"
            android:background="@drawable/border_line_curve_8dp_light_blue"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="5dp"
            android:visibility="gone"
            android:paddingHorizontal="3dp"
            android:id="@+id/edt_txt">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="10sp"
                style="@style/FontRegular"
                android:text="Don't Have ABC ID? "/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorPrimary"
                android:textSize="10sp"
                style="@style/FontRegular"
                android:text="Click Here"/>
        </LinearLayout>
    </LinearLayout>
    <CheckBox
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/checkbox"
        android:visibility="gone"
        android:textSize="@dimen/_12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:buttonTint="@color/colorPrimary"
        style="@style/FontRegular"
        android:textColor="@color/black"
        android:text="Currently Working"
        android:gravity="start|center"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_12sp"
        style="@style/FontDefault"
        android:id="@+id/txt"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingVertical="14dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:drawableEnd="@drawable/prime_upload"
        android:textColor="@color/black_varient3"
        android:text="All Semester Marksheet"
        android:background="@drawable/border_line_curve_8dp_light_blue"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/colorPrimary"
        android:textSize="10sp"
        android:id="@+id/txt_txt"
        android:paddingVertical="5dp"
        android:paddingHorizontal="3dp"
        style="@style/FontRegular"
        android:visibility="gone"
        android:text="Don't Have ABC ID? Click Here"/>
</LinearLayout>