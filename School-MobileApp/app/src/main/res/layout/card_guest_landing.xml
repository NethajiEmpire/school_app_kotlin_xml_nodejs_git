<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="80dp"
    android:layout_marginEnd="8dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/border_line_curve_6dp_light_blue_gradient"
        android:padding="10dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/group_profile"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/group_profile" />
            <TextView
                android:id="@+id/classtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="Smart Classrooms"
                android:textColor="#4B4B4B"
                android:layout_gravity="center"
                style="@style/FontRegular"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/classdesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Equiped with interactive board and tech-enabled"
            android:textColor="#B5B5B5"
            android:textSize="10sp"
            android:maxLines="2"
            style="@style/FontRegular"
            android:layout_marginTop="6dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>