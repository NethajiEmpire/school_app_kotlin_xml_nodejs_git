<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="2"
            android:id="@+id/timetable_lay"
            android:visibility="visible"
            android:orientation="horizontal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mainLay"
                android:layout_width="80dp"
                android:layout_height="match_parent">

                <View
                    android:id="@+id/verticalLine"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:background="#DFDFDF"
                    android:layout_marginTop="2dp"
                    app:layout_constraintTop_toBottomOf="@+id/no"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APR"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:textColor="@color/black_varient6"
                    android:textSize="10sp"
                    android:id="@+id/mon"
                    style="@style/FontRegular"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:id="@+id/view"
                    android:layout_marginStart="2dp"
                    app:layout_constraintStart_toEndOf="@id/no"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/no"
                    app:layout_constraintBottom_toBottomOf="@id/no"
                    android:background="#EFEFEF"/>

                <TextView
                    android:id="@+id/no"
                    style="@style/FontMedium"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/ic_round"
                    android:backgroundTint="#E0E6F3"
                    android:gravity="center"
                    android:text="21"
                    android:textColor="#232B68"
                    android:textSize="@dimen/_14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/mon" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:paddingVertical="6dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:id="@+id/linBg"
                android:background="@drawable/border_line_curve_8dp_grey_light_blue"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="8dp"
                    android:layout_gravity="center"
                    android:paddingVertical="5dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MONDAY"
                            style="@style/FontMedium"
                            android:singleLine="true"
                            android:id="@+id/day"
                            android:ellipsize="end"
                            android:textSize="@dimen/_12sp"
                            android:textColor="#333333"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="April 23, 2025"
                            style="@style/FontRegular"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:id="@+id/date1"
                            android:textSize="@dimen/_12sp"
                            android:textColor="#525252"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Present"
                        style="@style/FontRegular"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:background="@drawable/border_curve_24dp"
                        android:backgroundTint="#e6ffe8"
                        android:id="@+id/status"
                        android:drawableStart="@drawable/dot"
                        android:drawablePadding="4dp"
                        android:drawableTint="#1BB428"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="3dp"
                        android:textSize="@dimen/_12sp"
                        android:textColor="#1BB428"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>