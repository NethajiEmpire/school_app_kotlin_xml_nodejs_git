<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/border_line_curve_10dp_very_light_gray">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.makeramen.roundedimageview.RoundedImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:id="@+id/img"
                    app:riv_corner_radius="20dp"
                    android:src="@drawable/ic_user_profile"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="4dp">
                    <TextView
                        android:id="@+id/staffName"
                        style="@style/FontMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:text="Nethaji Hada"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/black_varient3"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/staff"
                        style="@style/FontMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Teacher"
                        android:layout_marginStart="4dp"
                        android:textColor="#818181"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/staffName" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:background="@drawable/border_curve_24dp"
                    android:backgroundTint="#E8F6FF"
                    android:id="@+id/leaveType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="@dimen/_14sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    style="@style/FontMedium"
                    android:textColor="#799BFF"
                    android:layout_marginEnd="10dp"
                    android:text="Sick "/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/dash_line"
                android:backgroundTint="#BFBFBF"/>
            <TextView
                android:id="@+id/reasonLeave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#124090"
                style="@style/FontRegular"
                android:textSize="@dimen/_14sp"
                android:layout_marginTop="8dp"
                android:text="''Fever and cold — need 2 days rest''" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:background="@drawable/dashed_border_line_curve_8dp_with_white_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:id="@+id/request"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="left">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Requested On"
                        android:textColor="#818181"
                        android:textSize="12sp"
                        style="@style/FontRegular" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="12 May 2024"
                        android:textColor="#333333"
                        android:id="@+id/requested"
                        android:textSize="12sp"
                        style="@style/FontMedium" />
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:background="#F5F5F5"
                    android:layout_marginHorizontal="8dp"/>
                <LinearLayout
                    android:id="@+id/givenDateLayout"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="From Date"
                        android:textColor="#818181"
                        android:textSize="12sp"
                        style="@style/FontRegular" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="16 May 2024"
                        android:textColor="#333333"
                        android:id="@+id/start"
                        android:textSize="12sp"
                        style="@style/FontMedium" />
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:background="#F5F5F5"
                    android:layout_marginHorizontal="8dp"/>
                <LinearLayout
                    android:id="@+id/raise"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="To Date"
                        android:textColor="#818181"
                        android:textSize="12sp"
                        style="@style/FontRegular" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="18 May 2024"
                        android:textColor="#333333"
                        android:id="@+id/end"
                        android:textSize="12sp"
                        style="@style/FontMedium" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>