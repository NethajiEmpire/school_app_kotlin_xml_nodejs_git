<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:id="@+id/myclass"
            android:layout_marginStart="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/primary_clr_drb"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:visibility="visible">
            <ImageView
                android:id="@+id/img"
                android:layout_width="70dp"
                android:layout_height="20dp"
                android:src="@drawable/inchargeclasstwo" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/mysub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingVertical="3dp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/border_line_curve_4dp_primary"
            app:layout_constraintTop_toBottomOf="@id/myclass"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginTop="0dp">
            <TextView
                android:id="@+id/totalStd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5th Std - A / Tamil"
                android:textSize="14sp"
                style="@style/FontSemiBold"
                android:textColor="#1C3F2E" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
