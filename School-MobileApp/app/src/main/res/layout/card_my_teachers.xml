<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="center"
        android:orientation="vertical">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/img1"
                android:layout_width="52dp"
                android:layout_height="74dp"
                android:visibility="gone"
                android:src="@drawable/sub_teacher"
                android:scaleType="centerCrop"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="-16dp"
                android:elevation="24dp"
                app:layout_constraintTop_toTopOf="@id/mainn1"
                app:layout_constraintEnd_toEndOf="@id/mainn1"/>

            <LinearLayout
                android:id="@+id/mainn1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/border_line_curve_10dp_light_blue"
                android:gravity="bottom"
                android:padding="8dp"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:id="@+id/profile1"
                        android:src="@drawable/ic_user_profile"/>
                    <LinearLayout
                        android:layout_marginStart="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toEndOf="@id/profile1"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Karthick"
                            android:id="@+id/name"
                            android:textSize="@dimen/_14sp"
                            android:textColor="@color/black_varient3"
                            style="@style/FontDefault"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Physics Teacher"
                            android:id="@+id/sub"
                            android:textSize="@dimen/_12sp"
                            android:textColor="@color/black_varient6"
                            style="@style/FontDefault"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/dash_line"
                    android:backgroundTint="#CFF3FB"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:weightSum="2">
                    <TextView
                        android:id="@+id/mobile"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_12sp"
                        style="@style/FontRegular"
                        android:drawablePadding="4dp"
                        android:paddingStart="12dp"
                        android:drawableStart="@drawable/ic_call_with_blue"
                        android:singleLine="true"
                        android:textColor="@color/colorPrimary"
                        android:text="+91 98765 43210"/>
                    <TextView
                        android:layout_marginStart="6dp"
                        android:id="@+id/email"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_mail_with_blue"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4dp"
                        android:textSize="@dimen/_12sp"
                        android:singleLine="true"
                        style="@style/FontRegular"
                        android:textColor="@color/colorPrimary"
                        android:text="sasikumar@school.edu"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>