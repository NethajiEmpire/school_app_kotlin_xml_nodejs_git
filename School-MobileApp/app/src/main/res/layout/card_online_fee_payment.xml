<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    android:visibility="visible"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/lin_online"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/border_line_curve_8dp_light_blue">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_14sp"
            style="@style/FontMedium"
            android:padding="10dp"
            android:textColor="@color/colorPrimary"
            android:text="Payment Details"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DAEFFF"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:orientation="vertical">
            <LinearLayout
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="match_parent"
                android:weightSum="2"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_12sp"
                        style="@style/FontRegular"
                        android:text="Full Name"
                        android:textColor="#89879C"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_14sp"
                        style="@style/FontMedium"
                        android:layout_marginTop="3dp"
                        android:id="@+id/name"
                        android:text="Alrin sherbi"
                        android:textColor="#636363"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_12sp"
                        style="@style/FontRegular"
                        android:text="Email"
                        android:textColor="#89879C"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_14sp"
                        style="@style/FontMedium"
                        android:layout_marginTop="3dp"
                        android:id="@+id/email"
                        android:text="alrinsherbi@gmail.com"
                        android:textColor="#636363"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="match_parent"
                android:weightSum="2"
                android:layout_marginTop="12dp"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_12sp"
                        style="@style/FontRegular"
                        android:text="Mobile"
                        android:textColor="#89879C"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_14sp"
                        style="@style/FontMedium"
                        android:layout_marginTop="3dp"
                        android:id="@+id/mobile_no"
                        android:text="9873456890"
                        android:textColor="#636363"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FontRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:text="Grade Applying For"
                        android:textColor="#89879C"
                        android:textSize="@dimen/_12sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_14sp"
                        android:id="@+id/graduation"
                        style="@style/FontMedium"
                        android:layout_marginTop="3dp"
                        android:text="9th Standard"
                        android:textColor="#636363"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="match_parent"
                android:weightSum="2"
                android:layout_marginTop="12dp"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_12sp"
                        style="@style/FontRegular"
                        android:text="Fees Type"
                        android:textColor="#666666"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_14sp"
                        style="@style/FontMedium"
                        android:id="@+id/degree"
                        android:layout_marginTop="3dp"
                        android:text="Registration Fee"
                        android:textColor="#636363"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_12sp"
                        style="@style/FontRegular"
                        android:text="Fees Amount"
                        android:textColor="#666666"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_14sp"
                        style="@style/FontMedium"
                        android:id="@+id/batch"
                        android:layout_marginTop="3dp"
                        android:text="₹5,000"
                        android:textColor="#37AF6D"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>