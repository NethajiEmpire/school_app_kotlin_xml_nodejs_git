<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:weightSum="4"
        android:layout_marginBottom="8dp"
        android:background="@drawable/border_line_curve_12dp_grey">
        <ImageView
            android:layout_width="47dp"
            android:layout_height="47dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/img"
            android:src="@drawable/exam_pad_img"
            />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@id/img"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/endLay"
            app:layout_constraintBottom_toBottomOf="parent"
            android:paddingHorizontal="4dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_14sp"
                style="@style/FontMedium"
                android:text="Tution Fee"
                android:singleLine="true"
                android:id="@+id/fees"
                android:textColor="@color/colorPrimary"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontRegular"
                android:textSize="@dimen/_12sp"
                android:id="@+id/date"
                android:singleLine="true"
                android:text="24th May,2024 at 01:00 pm"
                android:textColor="#666666"/>
        </LinearLayout>
        <LinearLayout
            android:paddingHorizontal="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/endLay"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textSize="@dimen/_12sp"
                style="@style/FontRegular"
                android:paddingVertical="3dp"
                android:paddingHorizontal="16dp"
                android:text="Online"
                android:background="@drawable/border_curve_24dp"
                android:backgroundTint="#DDEBFF"
                android:id="@+id/status"
                android:textColor="#3F8BFB"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/amount"
                android:layout_marginTop="4dp"
                android:layout_gravity="center"
                style="@style/FontRegular"
                android:textSize="@dimen/_14sp"
                android:layout_alignParentEnd="true"
                android:text="₹15,000"
                android:textColor="#32B138"/>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>