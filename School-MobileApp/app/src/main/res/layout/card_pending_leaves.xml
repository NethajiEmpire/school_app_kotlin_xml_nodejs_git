<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="4dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/totalTab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/border_line_curve_8dp_grey"
        android:gravity="center">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2"
            android:orientation="horizontal">
            <TextView
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:id="@+id/leaveName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Special Leave"
                android:textSize="@dimen/_12sp"
                android:textColor="@color/colorPrimary"
                style="@style/FontRegular" />
            <TextView
                android:layout_weight="1"
                android:id="@+id/daysleft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/border_line_curve_10dp_events_green"
                android:backgroundTint="#D2F0FF"
                android:paddingHorizontal="8dp"
                android:text="1 Day"
                android:textColor="#2FBAFF"
                android:textSize="12sp"
                style="@style/FontRegular"
                />
        </LinearLayout>
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2"
        android:layout_gravity="center"
        android:orientation="horizontal">
        <TextView
            android:drawableStart="@drawable/remaing"
            android:layout_weight="1"
            android:id="@+id/taken"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:text="Taken"
            android:textSize="@dimen/_12sp"
            android:textColor="#4F4F4F"
            style="@style/FontRegular" />
            <TextView
                android:layout_marginStart="6dp"
                android:drawableStart="@drawable/taken"
                android:textAlignment="viewEnd"
                android:layout_weight="1"
                android:id="@+id/remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remaining"
                android:textSize="@dimen/_12sp"
                android:textColor="#4F4F4F"
                style="@style/FontRegular" />
    </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2"
            android:orientation="horizontal">
            <TextView
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:id="@+id/count"
                android:textAlignment="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="@dimen/_12sp"
                android:textColor="@color/red"
                style="@style/FontRegular" />
            <TextView
                android:textAlignment="center"
                android:layout_weight="1"
                android:id="@+id/count2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#D2F0FF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="0"
                android:textColor="@color/green"
                android:textSize="12sp"
                style="@style/FontRegular"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>