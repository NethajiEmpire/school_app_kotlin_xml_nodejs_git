<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/border_line_curve_10dp_grey">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mathematics"
                        style="@style/FontRegular"
                        android:drawableTint="#348f23"
                        android:drawablePadding="4dp"
                        android:drawableStart="@drawable/books"
                        android:id="@+id/subject"
                        android:textSize="@dimen/_14sp"
                        android:textColor="#348F23"/>
                    <TextView
                        android:id="@+id/title"
                        style="@style/FontMedium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_width="wrap_content"
                        android:textSize="@dimen/_16sp"
                        android:maxLines="2"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:layout_height="wrap_content"
                        android:text="Linear Equations Assignment"
                        android:textColor="#333333" />

                    <com.lms.sch.customviews.SeeMoreTextView
                        android:id="@+id/desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#8F8F8F"
                        style="@style/FontRegular"
                        android:layout_marginTop="4dp"
                        android:textSize="@dimen/_12sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:text="Write a 150-word essay about your favorite festival. Mention why you like it, how it's celebrated, and..."/>
                </LinearLayout>
                <TextView
                    android:visibility="gone"
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_curve_24dp"
                    android:backgroundTint="#DAE7FF"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    style="@style/FontRegular"
                    android:paddingVertical="4dp"
                    android:layout_gravity="center"
                    android:textSize="@dimen/_12sp"
                    android:text="Ongoing"
                    android:textColor="#3F8BFB" />

                <!-- <androidx.constraintlayout.widget.ConstraintLayout
                     android:layout_width="0dp"
                     android:layout_weight="1"
                     android:layout_height="wrap_content"
                     android:padding="4dp"
                     android:layout_marginStart="8dp"
                     android:orientation="vertical">
                     <TextView
                         android:id="@+id/subjectName"
                         style="@style/FontMedium"
                         app:layout_constraintStart_toStartOf="parent"
                         app:layout_constraintTop_toTopOf="parent"
                         android:layout_width="0dp"
                         android:textSize="12sp"
                         android:layout_height="wrap_content"
                         android:ellipsize="end"
                         android:maxLines="2"
                         android:text="English"
                         android:textColor="#333333" />
                     <TextView
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:id="@+id/teacherName"
                         android:textSize="12sp"
                         style="@style/FontMedium"
                         app:layout_constraintStart_toStartOf="parent"
                         app:layout_constraintTop_toBottomOf="@id/subjectName"
                         android:textColor="#828282"
                         android:text="Mrs. Anitha"/>
                 </androidx.constraintlayout.widget.ConstraintLayout>-->

                <!-- <TextView
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:background="@drawable/border_curve_24dp"
                     android:backgroundTint="#DAE7FF"
                     android:paddingHorizontal="14dp"
                     android:paddingVertical="3dp"
                     style="@style/FontRegular"
                     android:id="@+id/assignmentStatus"
                     android:textSize="@dimen/_12sp"
                    android:layout_gravity="center"
                     android:text="New Assignment"
                     android:textColor="#3F8BFB" />-->

            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height=".7dp"
                android:layout_marginTop="6dp"
                android:background="#EFEFEF"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_marginTop="6dp"
                android:padding="6dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center">
                        <com.makeramen.roundedimageview.RoundedImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            app:riv_corner_radius="11dp"
                            android:id="@+id/profile"
                            android:src="@drawable/ic_user_profile"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Karthick"
                            android:id="@+id/teacher"
                            android:layout_marginStart="4dp"
                            style="@style/FontRegular"
                            android:gravity="center"
                            android:singleLine="true"
                            android:textSize="12sp"
                            android:textColor="#348F23"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Doc"
                    android:id="@+id/viewDoc"
                    android:drawableEnd="@drawable/ic_next"
                    android:drawableTint="#348f23"
                    android:drawablePadding="4dp"
                    android:layout_marginEnd="16dp"
                    style="@style/FontRegular"
                    android:textSize="@dimen/_12sp"
                    android:textColor="#348F23"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 days left"
                        android:id="@+id/daysLeft"
                        android:layout_marginEnd="4dp"
                        style="@style/FontRegular"
                        android:drawableTint="#348F23"
                        android:drawablePadding="3dp"
                        android:drawableStart="@drawable/time_line"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#348F23"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>