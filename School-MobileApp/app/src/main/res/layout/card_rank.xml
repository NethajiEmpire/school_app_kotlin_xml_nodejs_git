<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="8dp"
        android:padding="4dp"
        android:orientation="horizontal">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:id="@+id/drb"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:background="@drawable/border_curve_8dp"
            android:backgroundTint="#F0F6FF">
            <com.makeramen.roundedimageview.RoundedImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/profile"
                app:riv_corner_radius="24dp"
                app:riv_border_color="#efefef"
                app:riv_border_width=".5dp"
                app:layout_constraintStart_toStartOf="parent"
                android:src="@drawable/ic_user_profile"/>
            <TextView
                android:id="@+id/stdName"
                style="@style/FontMedium"
                app:layout_constraintStart_toEndOf="@id/profile"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="0dp"
                android:textSize="@dimen/_14sp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:padding="4dp"
                android:text="Robin SD (You)"
                android:textColor="#333333" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/stdMarks"
                android:textSize="@dimen/_14sp"
                style="@style/FontMedium"
                android:padding="4dp"
                app:layout_constraintStart_toEndOf="@id/profile"
                app:layout_constraintTop_toBottomOf="@id/stdName"
                android:textColor="#32B138"
                android:text="160 Points"/>
            <TextView
                android:id="@+id/rank"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/stdName"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontMedium"
                android:padding="4dp"
                android:textSize="@dimen/_14sp"
                android:text="4th Rank"
                android:textColor="#3F8BFB" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>