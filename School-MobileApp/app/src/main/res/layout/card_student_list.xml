<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingVertical="2dp"
        android:layout_margin="8dp"
        android:id="@+id/top"
        android:background="@drawable/border_line_curve_10dp_grey"
        android:paddingHorizontal="8dp"
        android:layout_height="wrap_content">
        <com.makeramen.roundedimageview.RoundedImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/profile"
            app:riv_corner_radius="25dp"
            app:riv_border_color="#efefef"
            app:riv_border_width=".5dp"
            app:layout_constraintStart_toStartOf="parent"
            android:src="@drawable/ic_user_profile"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/profile"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:orientation="vertical">
            <TextView
                android:id="@+id/stdName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Karthick"
                android:textSize="@dimen/_16sp"
                style="@style/FontMedium"
                android:textColor="@color/black_varient3"/>
            <TextView
                android:id="@+id/stdclass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STD: 6th -A | Roll: 21"
                android:textSize="@dimen/_12sp"
                style="@style/FontRegular"
                android:textColor="@color/black_varient3"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Present"
            android:id="@+id/status"
            android:background="@drawable/border_curve_24dp"
            android:backgroundTint="#EAFFEA"
            android:paddingVertical="2dp"
            android:paddingHorizontal="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textSize="@dimen/_12sp"
            style="@style/FontRegular"
            android:textColor="#32B138"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>