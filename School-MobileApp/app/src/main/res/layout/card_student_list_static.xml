<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingVertical="12dp"
        android:layout_margin="8dp"
        android:id="@+id/top"
        android:background="@drawable/border_line_curve_10dp_grey"
        android:paddingHorizontal="16dp"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/profile"
            app:layout_constraintStart_toStartOf="parent"
            android:src="@drawable/ic_user_profile"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/profile"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sushi"
                android:textSize="@dimen/_16sp"
                style="@style/FontMedium"
                android:textColor="@color/black_varient3"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STD: 6th -A | Roll: 21"
                android:textSize="@dimen/_12sp"
                style="@style/FontRegular"
                android:textColor="@color/black_varient3"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Present"
            android:id="@+id/status"
            android:background="@drawable/border_curve_24dp"
            android:backgroundTint="#EAFFEA"
            android:paddingVertical="2dp"
            android:paddingHorizontal="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textSize="@dimen/_12sp"
            style="@style/FontRegular"
            android:textColor="#32B138"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingVertical="12dp"
        android:layout_margin="8dp"
        android:id="@+id/top1"
        android:background="@drawable/border_line_curve_10dp_grey"
        android:paddingHorizontal="16dp"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/profile1"
            app:layout_constraintStart_toStartOf="parent"
            android:src="@drawable/ic_user_profile"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/profile1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Surya"
                android:textSize="@dimen/_16sp"
                style="@style/FontMedium"
                android:textColor="@color/black_varient3"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STD: 6th -A | Roll: 21"
                android:textSize="@dimen/_12sp"
                style="@style/FontRegular"
                android:textColor="@color/black_varient3"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Absent"
            android:id="@+id/status1"
            android:background="@drawable/border_curve_24dp"
            android:backgroundTint="#FFF1F1"
            android:paddingVertical="2dp"
            android:paddingHorizontal="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textSize="@dimen/_12sp"
            style="@style/FontRegular"
            android:textColor="#FF7475"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>