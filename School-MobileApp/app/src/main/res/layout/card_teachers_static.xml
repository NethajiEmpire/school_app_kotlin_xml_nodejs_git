<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/teachersushma"
            android:padding="8dp"
            android:maxWidth="80dp">
            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/img"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_user_profile"
                android:scaleType="centerCrop"
                app:riv_mutate_background="true"
                android:visibility="visible"
                android:layout_marginEnd="6dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/txt"
                app:layout_constraintEnd_toEndOf="parent"
                app:riv_corner_radius="50dp"
                app:riv_border_color="@color/hint_color2"
                app:riv_border_width=".7dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sushma"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/img"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:singleLine="true"
                android:id="@+id/txt"
                android:textSize="@dimen/_14sp"
                style="@style/FontDefault"
                android:textColor="@color/white"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/tSasi"
            android:padding="8dp"
            android:maxWidth="80dp">
            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/img1"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/sta2"
                android:scaleType="centerCrop"
                app:riv_mutate_background="true"
                android:visibility="visible"
                android:layout_marginEnd="6dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/txt1"
                app:layout_constraintEnd_toEndOf="parent"
                app:riv_corner_radius="50dp"
                app:riv_border_color="@color/hint_color2"
                app:riv_border_width=".7dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mr Sasi Balan"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/img1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:singleLine="true"
                android:id="@+id/txt1"
                android:textSize="@dimen/_14sp"
                style="@style/FontDefault"
                android:textColor="@color/white"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/tchandru"
            android:padding="8dp"
            android:maxWidth="80dp">
            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/img2"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/sta1"
                android:scaleType="centerCrop"
                app:riv_mutate_background="true"
                android:visibility="visible"
                android:layout_marginEnd="6dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/txt2"
                app:layout_constraintEnd_toEndOf="parent"
                app:riv_corner_radius="50dp"
                app:riv_border_color="@color/hint_color2"
                app:riv_border_width=".7dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mr Chandru"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/img2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:singleLine="true"
                android:id="@+id/txt2"
                android:textSize="@dimen/_14sp"
                style="@style/FontDefault"
                android:textColor="@color/white"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/tSurya"
            android:padding="8dp"
            android:maxWidth="80dp">
            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/img3"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_user_profile"
                android:scaleType="centerCrop"
                app:riv_mutate_background="true"
                android:visibility="visible"
                android:layout_marginEnd="6dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/txt3"
                app:layout_constraintEnd_toEndOf="parent"
                app:riv_corner_radius="50dp"
                app:riv_border_color="@color/hint_color2"
                app:riv_border_width=".7dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mr Surya"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/img3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:singleLine="true"
                android:id="@+id/txt3"
                android:textSize="@dimen/_14sp"
                style="@style/FontDefault"
                android:textColor="@color/white"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/tArish"
            android:padding="8dp"
            android:maxWidth="80dp">
            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/img4"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/sta3"
                android:scaleType="centerCrop"
                app:riv_mutate_background="true"
                android:visibility="visible"
                android:layout_marginEnd="6dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/txt4"
                app:layout_constraintEnd_toEndOf="parent"
                app:riv_corner_radius="50dp"
                app:riv_border_color="@color/hint_color2"
                app:riv_border_width=".7dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mr Arish"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/img4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:singleLine="true"
                android:id="@+id/txt4"
                android:textSize="@dimen/_14sp"
                style="@style/FontDefault"
                android:textColor="@color/white"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</HorizontalScrollView>