<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/border_line_curve_10dp_very_light_gray"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="8dp">
    <RelativeLayout
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/personalInformation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="1dp"
        android:orientation="horizontal"
        android:background="@drawable/border_line_curve_8dp_red"
        android:backgroundTint="#D2ECFF"
        android:paddingVertical="6dp"
        android:paddingHorizontal="10dp">
        <TextView
            style="@style/FontMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Term 1"
            android:id="@+id/term1"
            android:textColor="#003A63"
            android:textSize="@dimen/_14sp" />
        <ImageView
            android:id="@+id/down1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/down_gradient" />
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/subTerms"
        app:layout_constraintTop_toBottomOf="@id/personalInformation"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>