<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/time_lay"
        android:background="@drawable/border_line_curve_16dp_end_navy_blue"
        android:layout_marginVertical="12dp"
        android:paddingVertical="2dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9.00 AM"
            android:layout_gravity="center"
            style="@style/FontDefault"
            android:id="@+id/startTime"
            android:paddingStart="18dp"
            android:layout_alignParentStart="true"
            android:textSize="@dimen/_10sp"
            android:textColor="@color/black_varient3"/>
    </LinearLayout>
    <View
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:elevation="-24dp"
        app:layout_constraintTop_toTopOf="@id/time_lay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/time_lay"
        android:background="@drawable/dash_line"/>
    <TextView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:text="1"
        android:elevation="24dp"
        android:gravity="center"
        android:id="@+id/no"
        android:textSize="@dimen/_10sp"
        style="@style/FontRegular"
        android:textColor="@color/colorPrimary"
        android:backgroundTint="#29232B68"
        android:background="@drawable/ic_round"
        app:layout_constraintTop_toTopOf="@id/time_lay"
        app:layout_constraintStart_toStartOf="@id/time_lay"
        app:layout_constraintBottom_toBottomOf="@id/time_lay"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="0dp"
        app:cardCornerRadius="10dp"
        android:id="@+id/card"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#3F8BFB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/time_lay">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:id="@+id/linBg"
            android:layout_marginStart="3dp"
            android:background="@drawable/border_curve_8dp"
            android:backgroundTint="#F0F6FF"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:src="@drawable/img_sub"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="English"
                    android:id="@+id/subject"
                    android:singleLine="true"
                    style="@style/FontMedium"
                    android:textSize="@dimen/_12sp"
                    android:textColor="@color/black_varient3"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mrs. Anitha"
                    style="@style/FontRegular"
                    android:id="@+id/teacher"
                    android:singleLine="true"
                    android:textSize="@dimen/_12sp"
                    android:textColor="@color/black_varient3"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/ic_round_line"
                        android:backgroundTint="#3F8BFB"/>
                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/ic_round_line"
                        android:backgroundTint="#FF7475"/>
                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/ic_round_line"
                        android:backgroundTint="#6BE9A3"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/container"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>