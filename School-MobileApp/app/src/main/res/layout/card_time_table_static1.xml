<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/time_lay"
        android:background="@drawable/border_line_curve_16dp_end_navy_blue"
        android:layout_marginVertical="12dp"
        android:paddingVertical="3dp"
        android:paddingHorizontal="10dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9.00 AM"
            android:layout_gravity="center"
            style="@style/FontDefault"
            android:layout_alignParentStart="true"
            android:textSize="@dimen/_14sp"
            android:textColor="@color/white"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:45 AM"
            android:layout_gravity="center"
            style="@style/FontDefault"
            android:layout_alignParentEnd="true"
            android:textSize="@dimen/_14sp"
            android:textColor="@color/white"/>
    </RelativeLayout>
    <TextView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:text="3"
        android:gravity="center"
        android:id="@+id/no"
        android:textSize="@dimen/_14sp"
        style="@style/FontRegular"
        android:layout_marginHorizontal="4dp"
        android:textColor="@color/white"
        android:backgroundTint="#F6891E"
        android:background="@drawable/ic_round"
        app:layout_constraintTop_toTopOf="@id/time_lay"
        app:layout_constraintStart_toStartOf="@id/time_lay"
        app:layout_constraintEnd_toEndOf="@id/time_lay"
        app:layout_constraintBottom_toBottomOf="@id/time_lay"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="0dp"
        app:cardCornerRadius="10dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="6dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#6BE9A3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/time_lay">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/border_curve_8dp"
            android:backgroundTint="#E0FFEE"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/img_sub"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Social"
                    style="@style/FontMedium"
                    android:textSize="@dimen/_14sp"
                    android:textColor="@color/black_varient3"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mrs. Anitha"
                    style="@style/FontDefault"
                    android:layout_marginTop="4dp"
                    android:textSize="@dimen/_14sp"
                    android:textColor="@color/black_varient3"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>