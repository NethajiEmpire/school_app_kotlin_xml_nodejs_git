<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="4"
        android:orientation="horizontal">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/time_lay"
                android:background="@drawable/border_line_curve_16dp_end_navy_blue"
                android:layout_marginVertical="12dp"
                android:paddingVertical="4dp"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toStartOf="parent"
                android:paddingHorizontal="10dp"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.45 PM"
                    android:layout_gravity="center"
                    style="@style/FontDefault"
                    android:paddingStart="18dp"
                    android:textSize="@dimen/_12sp"
                    android:textColor="@color/black_varient3"/>
            </LinearLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="5dp"
                app:layout_constraintTop_toTopOf="@id/time_lay"
                app:layout_constraintStart_toEndOf="@id/time_lay"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/time_lay"
                android:background="@drawable/dash_line"/>
            <TextView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:text="5"
                android:gravity="center"
                android:id="@+id/no"
                android:textSize="@dimen/_12sp"
                style="@style/FontRegular"
                android:textColor="@color/colorPrimary"
                android:backgroundTint="#29232B68"
                android:background="@drawable/ic_round"
                app:layout_constraintTop_toTopOf="@id/time_lay"
                app:layout_constraintStart_toStartOf="@id/time_lay"
                app:layout_constraintBottom_toBottomOf="@id/time_lay"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="0dp"
                app:cardCornerRadius="10dp"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="6dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#DF3FFB"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/time_lay">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="6dp"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/border_curve_8dp"
                    android:backgroundTint="#FCE8FF"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="English"
                            style="@style/FontMedium"
                            android:textSize="@dimen/_12sp"
                            android:textColor="@color/black_varient3"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mr. Karthick"
                            style="@style/FontDefault"
                            android:singleLine="true"
                            android:textSize="@dimen/_12sp"
                            android:textColor="@color/black_varient3"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="4dp"
                            android:layout_height="5dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bluedot" />
                        <ImageView
                            android:layout_width="4dp"
                            android:layout_height="5dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/voiletdot" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
