<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha=".6"
        android:background="@color/black" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:id="@+id/top_lay"
        android:maxHeight="600dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="0dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            android:id="@+id/card_view"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="-20dp"
            android:layout_gravity="bottom">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F3F3F3">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    android:src="@drawable/rectangle_curve"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#232B68"
                    android:textSize="@dimen/_16sp"
                    android:padding="12dp"
                    style="@style/FontSemiBold"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:id="@+id/txt1"
                    android:text="Homework"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset"
                    android:textSize="16sp"
                    style="@style/FontRegular"
                    android:padding="16dp"
                    android:id="@+id/reset"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:textColor="@color/colorPrimary"
                    android:paddingVertical="3dp"
                    android:paddingHorizontal="6dp"
                    android:layout_alignParentEnd="true"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:layout_marginBottom="20dp"
                android:layout_weight="1">
                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp">
                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_gravity="center"
                                android:src="@drawable/garden" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginLeft="8dp"
                                android:orientation="vertical">
                                <RelativeLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center">
                                    <TextView
                                        android:id="@+id/subject"
                                        style="@style/FontDefault"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Subject  : "
                                        android:textColor="@color/black_varient6"
                                        android:textSize="@dimen/_14sp" />

                                    <TextView
                                        android:id="@+id/english"
                                        style="@style/FontRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_toEndOf="@id/subject"
                                        android:text="English"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/_14sp" />

                                    <TextView
                                        android:id="@+id/submited"
                                        style="@style/FontDefault"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentEnd="true"
                                        android:background="@drawable/border_curve_16dp"
                                        android:backgroundTint="#EFFFF0"
                                        android:paddingHorizontal="16dp"
                                        android:paddingVertical="4dp"
                                        android:text="Submitted"
                                        android:textColor="#32B138"
                                        android:textSize="@dimen/_12sp" />
                                </RelativeLayout>

                                <RelativeLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp">

                                    <TextView
                                        android:id="@+id/teacher"
                                        style="@style/FontDefault"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Teacher  : "
                                        android:textColor="@color/black_varient6"
                                        android:textSize="@dimen/_14sp" />

                                    <TextView
                                        android:id="@+id/tname"
                                        style="@style/FontRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_toEndOf="@id/teacher"
                                        android:text="Mrs Anitha"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/_14sp" />

                                    <TextView
                                        android:visibility="gone"
                                        android:id="@+id/points"
                                        style="@style/FontDefault"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentEnd="true"
                                        android:layout_marginEnd="6dp"
                                        android:text="+5 Points"
                                        android:textColor="#32B138"
                                        android:textSize="@dimen/_12sp" />
                                </RelativeLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_alignBottom="@+id/homeworktext"
                            android:background="@drawable/dash_line"
                            android:backgroundTint="#F0F0F0" />

                        <RelativeLayout
                            android:id="@+id/relp2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:paddingVertical="8dp">

                            <TextView
                                android:id="@+id/givenOn"
                                style="@style/FontDefault"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:paddingVertical="2dp"
                                android:text="Given On : "
                                android:textColor="#4F4F4F"
                                android:textSize="@dimen/_12sp" />

                            <TextView
                                android:id="@+id/givendate"
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_toRightOf="@id/givenOn"
                                android:paddingVertical="2dp"
                                android:text="20-04-2025"
                                android:textColor="#4F4F4F"
                                android:textSize="@dimen/_14sp" />

                            <TextView
                                android:id="@+id/submiton"
                                style="@style/FontDefault"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_toLeftOf="@id/submitdate"
                                android:paddingVertical="2dp"
                                android:text="Submit On : "
                                android:textColor="#4F4F4F"
                                android:textSize="@dimen/_12sp" />

                            <TextView
                                android:id="@+id/submitdate"
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:paddingVertical="2dp"
                                android:text="24-04-2025"
                                android:textColor="#4F4F4F"
                                android:textSize="@dimen/_14sp" />
                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_alignBottom="@+id/homeworktext"
                            android:background="@drawable/dash_line"
                            android:backgroundTint="#F0F0F0" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="100.5dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/project_res_background"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/border_line_curve_6dp_gray"
                                android:orientation="vertical"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="18dp">

                                <TextView
                                    style="@style/FontRegular"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Your Mark"
                                    android:textColor="#232B68"
                                    android:textSize="@dimen/_16sp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/marks"
                                        style="@style/FontRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" 08 "
                                        android:textColor="#32B138"
                                        android:textSize="@dimen/_16sp" />

                                    <TextView
                                        style="@style/FontRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="/ 10"
                                        android:textColor="#32B138"
                                        android:textSize="@dimen/_16sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:padding="12dp"
                            android:orientation="vertical"
                            android:background="@drawable/border_line_curve_10dp_orange">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <com.makeramen.roundedimageview.RoundedImageView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:src="@drawable/ic_user_profile"
                                    android:scaleType="centerCrop"
                                    app:riv_mutate_background="true"
                                    android:layout_gravity="center"
                                    android:elevation="24dp"
                                    app:layout_constraintStart_toStartOf="@id/mainn"
                                    app:layout_constraintTop_toTopOf="@id/mainn"
                                    app:layout_constraintBottom_toTopOf="@id/mainn"
                                    app:layout_constraintEnd_toEndOf="@id/mainn"
                                    app:riv_corner_radius="50dp"
                                    app:riv_border_color="@color/hint_color2"
                                    app:riv_border_width="0dp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#333333"
                                    style="@style/FontDefault"
                                    android:layout_gravity="center"
                                    android:layout_marginStart="8dp"
                                    android:textSize="14sp"
                                    android:maxLines="1"
                                    android:text="Mr Karthick"/>
                            </LinearLayout>
                            <TextView
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:ellipsize="end"
                                android:layout_marginTop="8dp"
                                android:text="Chapter 3: Algebraic Expressions"
                                android:textColor="#232B68"
                                android:textSize="@dimen/_12sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sp"
                                android:textColor="#868686"
                                style="@style/FontDefault"
                                android:maxLines="3"
                                android:ellipsize="end"
                                android:text="* Introduction to algebra"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sp"
                                android:textColor="#868686"
                                android:layout_marginTop="3dp"
                                style="@style/FontDefault"
                                android:maxLines="3"
                                android:ellipsize="end"
                                android:text="* Basic operations on algebraic expressions"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sp"
                                android:textColor="#868686"
                                style="@style/FontDefault"
                                android:layout_marginTop="3dp"
                                android:maxLines="3"
                                android:ellipsize="end"
                                android:text="* Factorization techniques"/>
                            <TextView
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:ellipsize="end"
                                android:layout_marginTop="8dp"
                                android:text="Chapter 5: Linear Equations"
                                android:textColor="#232B68"
                                android:textSize="@dimen/_12sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sp"
                                android:textColor="#868686"
                                style="@style/FontDefault"
                                android:maxLines="3"
                                android:ellipsize="end"
                                android:text="* Solving one-variable equations"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sp"
                                android:textColor="#868686"
                                style="@style/FontDefault"
                                android:layout_marginTop="3dp"
                                android:maxLines="3"
                                android:ellipsize="end"
                                android:text="* Word problems on linear equations"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="10dp"
                            android:layout_gravity="center"
                            android:paddingVertical="10dp"
                            android:paddingHorizontal="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_14sp"
                                android:textColor="#89879C"
                                style="@style/FontRegular"
                                android:text="Answer Sheet"/>
                            <LinearLayout
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:orientation="vertical">

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/border_curve_4dp"
                                    android:backgroundTint="#F9F9F9"
                                    android:padding="4dp">

                                    <ImageView
                                        android:id="@+id/imgeIc"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_alignParentStart="true"
                                        android:layout_centerVertical="true"
                                        android:src="@drawable/ic_image" />

                                    <EditText
                                        android:id="@+id/imageDown"
                                        style="@style/FontRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerVertical="true"
                                        android:layout_marginStart="8dp"
                                        android:layout_toEndOf="@id/imgeIc"
                                        android:background="#F9F9F9"
                                        android:text="Image 1223"
                                        android:textAlignment="center"
                                        android:textColor="#868686"
                                        android:textSize="@dimen/_12sp" />

                                    <ImageView
                                        android:id="@+id/uploadIcon"
                                        android:layout_width="35dp"
                                        android:layout_height="35dp"
                                        android:layout_alignParentEnd="true"
                                        android:layout_centerVertical="true"
                                        android:backgroundTint="@color/colorPrimary"
                                        android:padding="8dp"
                                        android:src="@drawable/mynaui_download" />
                                </RelativeLayout>

                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/next"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Done"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:background="@drawable/ic_button_bg"
                            android:paddingVertical="12dp"
                            android:gravity="center"
                            android:layout_marginTop="16dp"
                            android:paddingHorizontal="16dp"
                            style="@style/FontRegular"
                            android:textSize="14sp"/>
                    </LinearLayout>

                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>