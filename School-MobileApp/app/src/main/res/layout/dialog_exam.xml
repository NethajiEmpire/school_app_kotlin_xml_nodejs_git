<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha=".6"
        android:background="@color/black" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:id="@+id/top_lay"
        android:maxHeight="600dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="0dp">
        <ImageView
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            app:layout_constraintBottom_toTopOf="@id/card_view"
            android:src="@drawable/cancel"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            android:id="@+id/card_view"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="-20dp"
            android:layout_gravity="bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F3F3F3">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginTop="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:src="@drawable/rectangle_curve"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_16sp"
                        android:padding="12dp"
                        style="@style/FontSemiBold"
                        android:layout_marginTop="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:id="@+id/txt1"
                        android:text="Class Test"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reset"
                        android:textSize="16sp"
                        style="@style/FontRegular"
                        android:padding="16dp"
                        android:id="@+id/reset"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:textColor="@color/colorPrimary"
                        android:paddingVertical="3dp"
                        android:paddingHorizontal="6dp"
                        android:layout_alignParentEnd="true"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp"
                    android:layout_weight="1">
                    <androidx.core.widget.NestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:gravity="center"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:orientation="vertical"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="16dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:paddingVertical="8dp"
                                    android:orientation="horizontal">
                                    <ImageView
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/img_sub"/>
                                    <androidx.constraintlayout.widget.ConstraintLayout
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:id="@+id/head1"
                                        android:layout_height="wrap_content"
                                        android:padding="4dp"
                                        android:orientation="vertical">
                                        <TextView
                                            android:id="@+id/subName"
                                            style="@style/FontMedium"
                                            app:layout_constraintStart_toStartOf="parent"
                                            app:layout_constraintTop_toTopOf="parent"
                                            android:layout_width="0dp"
                                            android:textSize="14sp"
                                            android:layout_height="wrap_content"
                                            android:ellipsize="end"
                                            android:maxLines="2"
                                            android:text="Mathematics Unit Test – 2"
                                            android:textColor="@color/black_varient3" />
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:id="@+id/testTitle"
                                            android:textSize="14sp"
                                            style="@style/FontDefault"
                                            app:layout_constraintStart_toStartOf="parent"
                                            app:layout_constraintTop_toBottomOf="@id/subName"
                                            android:textColor="@color/colorPrimary"
                                            android:text="Mathematics | Algebra"/>
                                        <androidx.constraintlayout.widget.ConstraintLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            app:layout_constraintEnd_toEndOf="parent"
                                            app:layout_constraintTop_toTopOf="parent">
                                            <TextView
                                                app:layout_constraintEnd_toEndOf="parent"
                                                app:layout_constraintTop_toTopOf="parent"
                                                android:id="@+id/examStatus"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/_12sp"
                                                style="@style/FontDefault"
                                                android:textColor="#F39519"
                                                android:layout_gravity="center"
                                                android:paddingHorizontal="12dp"
                                                android:paddingVertical="3dp"
                                                android:background="@drawable/border_curve_16dp"
                                                android:backgroundTint="#FFF8EB"
                                                android:text="Today"
                                                android:layout_marginBottom="10dp"/>
                                            <TextView
                                                app:layout_constraintEnd_toEndOf="parent"
                                                app:layout_constraintBottom_toBottomOf="parent"
                                                app:layout_constraintTop_toBottomOf="@id/examStatus"
                                                android:id="@+id/credits"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/_12sp"
                                                style="@style/FontDefault"
                                                android:textColor="#F39519"
                                                android:layout_gravity="center"
                                                android:paddingHorizontal="12dp"
                                                android:paddingVertical="3dp"
                                                android:text="points"

                                                />

                                        </androidx.constraintlayout.widget.ConstraintLayout>


                                    </androidx.constraintlayout.widget.ConstraintLayout>



                                </LinearLayout>
                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:background="@drawable/dashed_border_line_curve_8dp">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:padding="8dp"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        android:id="@+id/lin1"
                                        android:weightSum="3"
                                        android:orientation="horizontal">
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:paddingStart="4dp"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textColor="#868686"
                                                style="@style/FontDefault"
                                                android:textSize="12sp"
                                                android:maxLines="1"
                                                android:text="Total Marks"/>
                                            <TextView
                                                android:id="@+id/totalMarks"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textColor="#333333"
                                                style="@style/FontRegular"
                                                android:textSize="12sp"
                                                android:maxLines="2"
                                                android:ellipsize="end"
                                                android:layout_marginTop="4dp"
                                                android:text="50 Mark"/>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:id="@+id/yourMarks"
                                            android:paddingStart="4dp"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textColor="#868686"
                                                style="@style/FontDefault"
                                                android:textSize="12sp"
                                                android:maxLines="1"
                                                android:text="Scored Marks"/>
                                            <TextView
                                                android:id="@+id/scoredMarks"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textColor="#333333"
                                                style="@style/FontRegular"
                                                android:textSize="12sp"
                                                android:maxLines="2"
                                                android:ellipsize="end"
                                                android:layout_marginTop="4dp"
                                                android:text="35 Mark"/>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:paddingStart="4dp"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textColor="#868686"
                                                style="@style/FontDefault"
                                                android:textSize="12sp"
                                                android:maxLines="1"
                                                android:text="Scheduled On"/>
                                            <TextView
                                                android:id="@+id/date"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textColor="#333333"
                                                style="@style/FontRegular"
                                                android:textSize="12sp"
                                                android:maxLines="2"
                                                android:ellipsize="end"
                                                android:layout_marginTop="4dp"
                                                android:text="16 May, 2024"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                </androidx.constraintlayout.widget.ConstraintLayout>
                                <LinearLayout
                                    android:layout_gravity="center"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:padding="12dp"
                                    android:orientation="vertical"
                                    android:background="@drawable/border_line_curve_10dp_orange">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">
                                        <com.makeramen.roundedimageview.RoundedImageView
                                            android:layout_width="36dp"
                                            android:layout_height="36dp"
                                            android:src="@drawable/ic_user_profile"
                                            android:scaleType="centerCrop"
                                            app:riv_mutate_background="true"
                                            android:layout_gravity="center"
                                            android:elevation="24dp"
                                            app:layout_constraintStart_toStartOf="@id/mainn"
                                            app:layout_constraintTop_toTopOf="@id/mainn"
                                            app:layout_constraintBottom_toTopOf="@id/mainn"
                                            app:layout_constraintEnd_toEndOf="@id/mainn"
                                            app:riv_corner_radius="50dp"
                                            app:riv_border_color="@color/hint_color2"
                                            app:riv_border_width="0dp"/>
                                        <TextView
                                            android:id="@+id/studentName"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textColor="#333333"
                                            style="@style/FontDefault"
                                            android:layout_gravity="center"
                                            android:layout_marginStart="8dp"
                                            android:textSize="14sp"
                                            android:maxLines="1"
                                            android:text="Mr Karthick"/>
                                    </LinearLayout>
                                    <TextView
                                        android:id="@+id/chapter"
                                        style="@style/FontRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="6dp"
                                        android:ellipsize="end"
                                        android:layout_marginTop="8dp"
                                        android:text="Chapter 3: Algebraic Expressions"
                                        android:textColor="#232B68"
                                        android:textSize="@dimen/_12sp" />
                                    <TextView
                                        android:id="@+id/description"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/_12sp"
                                        android:textColor="#868686"
                                        style="@style/FontDefault"
                                        android:maxLines="3"
                                        android:ellipsize="end"
                                        android:text="* Introduction to algebra"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/attach_lay"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/_12sp"
                                        android:layout_marginTop="12dp"
                                        style="@style/FontRegular"
                                        android:id="@+id/uploadTxtt"
                                        android:textColor="#5A5A5A"
                                        android:text="Uploaded Class Test"/>
                                    <androidx.recyclerview.widget.RecyclerView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginVertical="8dp"
                                        android:id="@+id/attachRecycler"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/upload_lay"
                                    android:visibility="gone"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/_12sp"
                                        android:layout_marginTop="12dp"
                                        style="@style/FontRegular"
                                        android:textColor="@color/black_varient3"
                                        android:text="Upload Your Class Test"/>
                                    <TextView
                                        android:id="@+id/attach"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="Choose File"
                                        android:background="@drawable/border_line_curve_8dp_light_blue"
                                        android:paddingVertical="12dp"
                                        android:layout_marginTop="8dp"
                                        android:paddingHorizontal="16dp"
                                        android:textColor="#868686"
                                        android:drawableEnd="@drawable/prime_upload"
                                        android:textSize="14sp"
                                        style="@style/FontRegular"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/_10sp"
                                        android:layout_marginTop="2dp"
                                        style="@style/FontRegular"
                                        android:textColor="#E34747"
                                        android:text="* Maximum size 5Mb"/>
                                    <LinearLayout
                                        android:id="@+id/okCancel"
                                        android:layout_marginTop="10dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:weightSum="2">
                                        <TextView
                                            android:id="@+id/cancel"
                                            android:layout_weight="1"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:textAlignment="center"
                                            android:textSize="@dimen/_14sp"
                                            android:paddingVertical="12dp"
                                            android:paddingHorizontal="8dp"
                                            android:textColor="@color/colorPrimary"
                                            style="@style/FontDefault"
                                            android:layout_marginEnd="12dp"
                                            android:text="Cancel"
                                            android:background="@drawable/border_line_curve_4dp_navy_blue"/>
                                        <TextView
                                            android:id="@+id/makeasdone"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:paddingVertical="12dp"
                                            android:paddingHorizontal="8dp"
                                            android:textSize="@dimen/_14sp"
                                            style="@style/FontDefault"
                                            android:textAlignment="center"
                                            android:layout_weight="1"
                                            android:background="@drawable/border_line_curve_4dp_navy_blue"
                                            android:backgroundTint="#232B68"
                                            android:text="Make As Done"
                                            android:textColor="#FFFFFF"
                                            />
                                    </LinearLayout>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_marginVertical="10dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:id="@+id/answerSheet">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerVertical="true"
                                        android:textSize="@dimen/_14sp"
                                        style="@style/FontDefault"
                                        android:text="Answer Sheet"
                                        android:textColor="#333333"
                                        android:textAlignment="center"
                                        />
                                    <!--<RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center"
                                        android:padding="4dp"
                                        android:backgroundTint="#F9F9F9"
                                        android:background="@drawable/border_curve_4dp"
                                        >
                                        <ImageView
                                            android:layout_alignParentStart="true"
                                            android:id="@+id/img"
                                            android:layout_width="22dp"
                                            android:layout_height="22dp"
                                            android:src="@drawable/pdf"
                                            android:layout_margin="8dp"/>
                                        <TextView
                                            android:layout_toEndOf="@id/img"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_centerVertical="true"
                                            android:textSize="@dimen/_14sp"
                                            android:id="@+id/txt"
                                            style="@style/FontDefault"
                                            android:text="Test 1.pdf"
                                            android:textAlignment="center"
                                            />
                                        <ImageView
                                            android:layout_alignParentEnd="true"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:src="@drawable/ic_eye_open"
                                            android:layout_centerVertical="true"
                                            android:padding="8dp"
                                            />
                                    </RelativeLayout>-->
                                    <androidx.recyclerview.widget.RecyclerView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:id="@+id/examRecycle"/>

                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:id="@+id/tRemarks">
                                    <TextView
                                        android:id="@+id/teacherRemarkHeading"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerVertical="true"
                                        android:textSize="@dimen/_14sp"
                                        style="@style/FontDefault"
                                        android:text="Teacher Remarks"
                                        android:textColor="#333333"
                                        android:textAlignment="center"
                                        />
                                    <TextView
                                        android:id="@+id/teacherRemarkContent"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerVertical="true"
                                        android:textSize="@dimen/_14sp"
                                        style="@style/FontDefault"
                                        android:text="Very Good Keep It Up !"
                                        android:textColor="@color/colorPrimary"
                                        android:textAlignment="center"
                                        />
                                </LinearLayout>
                                <TextView
                                    android:id="@+id/next"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Okay , I’ll Prepare for it"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:background="@drawable/ic_button_bg"
                                    android:paddingVertical="12dp"
                                    android:gravity="center"
                                    android:layout_marginTop="16dp"
                                    android:paddingHorizontal="16dp"
                                    style="@style/FontRegular"
                                    android:textSize="14sp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>