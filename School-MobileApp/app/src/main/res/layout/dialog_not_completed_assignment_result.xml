<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="wrap_content"
xmlns:app="http://schemas.android.com/apk/res-auto">

<View
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha=".6"
    android:background="@color/black" />
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:id="@+id/top_lay"
    android:maxHeight="600dp"
    app:layout_constraintBottom_toBottomOf="parent"
    android:layout_height="0dp">
    <ImageView
        android:id="@+id/cancel2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/card_view"
        android:src="@drawable/cancel"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        android:id="@+id/card_view"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="-20dp"
        android:layout_gravity="bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F3F3F3">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    android:src="@drawable/rectangle_curve"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/_16sp"
                    android:padding="12dp"
                    style="@style/FontSemiBold"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:id="@+id/txt1"
                    android:text="In complete Assignment"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset"
                    android:textSize="16sp"
                    style="@style/FontRegular"
                    android:padding="16dp"
                    android:id="@+id/reset"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:textColor="@color/colorPrimary"
                    android:paddingVertical="3dp"
                    android:paddingHorizontal="6dp"
                    android:layout_alignParentEnd="true"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:layout_marginBottom="20dp"
                android:layout_weight="1">
                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:background="@drawable/border_line_curve_8dp_grey"
                            android:layout_width="match_parent"
                            android:gravity="center"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="16dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_gravity="center"
                                android:layout_alignBottom="@+id/homeworktext"
                                android:background="@color/black_varient6"
                                android:backgroundTint="#F0F0F0"
                                />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_gravity="center"
                                android:paddingVertical="8dp">
                                <ImageView
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:src="@drawable/garden"
                                    android:layout_gravity="center"
                                    />
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_gravity="center"
                                    android:layout_marginLeft="8dp">
                                    <RelativeLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center">
                                        <TextView
                                            android:id="@+id/subject"
                                            style="@style/FontDefault"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Subject  : "
                                            android:textColor="@color/black_varient6"
                                            android:textSize="@dimen/_14sp"
                                            />
                                        <TextView
                                            android:id="@+id/english"
                                            android:layout_toEndOf="@id/subject"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textColor="@color/black"
                                            android:textSize="@dimen/_14sp"
                                            style="@style/FontRegular"
                                            android:text="English"
                                            />

                                        <TextView
                                            android:id="@+id/not"
                                            style="@style/FontDefault"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentEnd="true"
                                            android:background="@drawable/border_curve_16dp"
                                            android:backgroundTint="#FFEBEB"
                                            android:paddingHorizontal="16dp"
                                            android:paddingVertical="4dp"
                                            android:text="0 Days Left"
                                            android:textColor="#EA5455"
                                            android:textSize="@dimen/_12sp" />
                                    </RelativeLayout>
                                    <RelativeLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:layout_gravity="center">
                                        <TextView
                                            android:id="@+id/teacher"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textColor="@color/black_varient6"
                                            android:textSize="@dimen/_14sp"
                                            style="@style/FontDefault"
                                            android:text="Teacher  : "
                                            />
                                        <TextView
                                            android:layout_toEndOf="@id/teacher"
                                            android:id="@+id/tname"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textColor="@color/black"
                                            android:textSize="@dimen/_14sp"
                                            style="@style/FontRegular"
                                            android:text="Mrs Anitha"
                                            />
                                        <TextView
                                            android:id="@+id/points"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="+5 Points"
                                            android:layout_marginEnd="6dp"
                                            android:textSize="@dimen/_12sp"
                                            style="@style/FontDefault"
                                            android:textColor="#EA5455"
                                            android:layout_alignParentEnd="true"
                                            />
                                    </RelativeLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="5dp"
                                android:layout_alignBottom="@+id/homeworktext"
                                android:background="@drawable/dash_line"
                                android:backgroundTint="#F0F0F0"
                                />
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingVertical="8dp"
                                android:layout_gravity="center"
                                android:id="@+id/relp2"
                                >
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/_12sp"
                                    android:text="Given On : "
                                    android:layout_centerVertical="true"
                                    android:paddingVertical="2dp"
                                    android:textColor="#4F4F4F"
                                    style="@style/FontDefault"
                                    android:id="@+id/givenOn"
                                    android:layout_alignParentStart="true"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="20-04-2025"
                                    android:paddingVertical="2dp"
                                    android:layout_centerVertical="true"
                                    style="@style/FontRegular"
                                    android:textSize="@dimen/_14sp"
                                    android:textColor="#4F4F4F"
                                    android:id="@+id/givendate"
                                    android:layout_toRightOf="@id/givenOn"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Submit On : "
                                    android:textColor="#4F4F4F"
                                    style="@style/FontDefault"
                                    android:paddingVertical="2dp"
                                    android:layout_centerVertical="true"
                                    android:textSize="@dimen/_12sp"
                                    android:layout_toLeftOf="@id/submitdate"
                                    android:id="@+id/submiton"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#4F4F4F"
                                    android:text="24-04-2025"
                                    style="@style/FontRegular"
                                    android:layout_centerVertical="true"
                                    android:paddingVertical="2dp"
                                    android:textSize="@dimen/_14sp"
                                    android:id="@+id/submitdate"
                                    android:layout_alignParentEnd="true"
                                    />
                            </RelativeLayout>
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="5dp"
                                android:layout_alignBottom="@+id/homeworktext"
                                android:background="@drawable/dash_line"
                                android:backgroundTint="#F0F0F0"
                                />
                            <LinearLayout
                                android:layout_marginTop="6dp"
                                android:layout_width="match_parent"
                                android:layout_height="100.5dp"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:background="@drawable/project_res_background">
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:background="@drawable/border_line_curve_6dp_gray"
                                    android:paddingVertical="18dp"
                                    android:paddingHorizontal="16dp"
                                    >
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Your Mark"
                                        android:textColor="#232B68"
                                        android:textSize="@dimen/_16sp"
                                        style="@style/FontRegular"
                                        />
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_gravity="center">
                                        <TextView
                                            android:id="@+id/marks"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text=" 08 "
                                            android:textSize="@dimen/_16sp"
                                            android:textColor="#32B138"
                                            style="@style/FontRegular"
                                            />
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="/ 10"
                                            android:textSize="@dimen/_16sp"
                                            android:textColor="#32B138"
                                            style="@style/FontRegular"
                                            />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_marginTop="10dp"
                                android:layout_gravity="center"
                                android:paddingVertical="10dp"
                                android:paddingHorizontal="8dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/border_line_curve_8dp_light_blue"
                                >
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/colorPrimary"
                                    android:layout_marginBottom="6dp"
                                    style="@style/FontMedium"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:textSize="@dimen/_14sp"
                                    android:text="Write an essay On My Favorite Festival"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/_14sp"
                                    android:textColor="#868686"
                                    style="@style/FontDefault"
                                    android:maxLines="3"
                                    android:ellipsize="end"
                                    android:text="Write a short essay about your favorite festival. You can talk about how you celebrate it, why you love it, any special foods, clothes, or traditions you follow, and how it makes you feel. Try to keep it personal and creative!"
                                    />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_marginTop="10dp"
                                android:layout_gravity="center"
                                android:paddingVertical="10dp"
                                android:paddingHorizontal="8dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/_14sp"
                                    android:textColor="#4F4F4F"
                                    style="@style/FontRegular"
                                    android:text="Attachment"/>

                                <androidx.recyclerview.widget.RecyclerView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone"
                                    android:id="@+id/qnsAssign"/>

                                <include
                                    layout="@layout/card_attachment"/>
                                <include
                                    layout="@layout/card_attachment"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_marginTop="10dp"
                                android:layout_gravity="center"
                                android:paddingVertical="8dp"
                                android:paddingHorizontal="8dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <androidx.recyclerview.widget.RecyclerView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/project_res"
                                    />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_marginTop="10dp"
                                android:paddingVertical="10dp"
                                android:paddingHorizontal="8dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:id="@+id/resultNote"
                                android:backgroundTint="#FFF2F2"
                                android:background="@drawable/border_line_curve_10dp_grey"
                                >
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/_12sp"
                                    style="@style/FontDefault"
                                    android:textColor="#5A5A5A"
                                    android:text="Note*"
                                    />
                                <TextView
                                    android:id="@+id/noteTxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#5A5A5A"
                                    android:textSize="@dimen/_12sp"
                                    style="@style/FontDefault"
                                    android:text="The due date of this task has passed without submission. Please follow up with your child. "
                                    />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/okayParent"
                                android:layout_marginTop="10dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:visibility="gone"
                                android:weightSum="2">
                                <TextView
                                    android:id="@+id/oktrailChild"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:paddingVertical="12dp"
                                    android:paddingHorizontal="8dp"
                                    android:textSize="@dimen/_14sp"
                                    style="@style/FontDefault"
                                    android:textAlignment="center"
                                    android:layout_weight="1"
                                    android:background="@drawable/border_line_curve_4dp_navy_blue"
                                    android:backgroundTint="#232B68"
                                    android:text="I'll Remind  My Child"
                                    android:textColor="#FFFFFF"
                                    />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>