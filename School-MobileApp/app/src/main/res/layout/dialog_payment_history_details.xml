<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha=".6"
        android:background="@color/black" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:id="@+id/top_lay"
        android:maxHeight="610dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            android:id="@+id/card_view"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:background="#f74850">
                    <ImageView
                        android:id="@+id/close"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:src="@drawable/cancel"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/black_varient6" />
                    <TextView
                        android:id="@+id/txt1"
                        style="@style/FontSemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="12dp"
                        android:text="Transaction History"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_16sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:id="@+id/txt_time"
                        style="@style/FontRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone"
                        android:text="08.50 PM on 04 May 20255"
                        android:textColor="#7A7A7A"
                        android:textSize="@dimen/_12sp"
                        app:layout_constraintTop_toBottomOf="@id/txt1"
                        app:layout_constraintStart_toStartOf="@id/txt1"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp"
                    android:layout_weight="1">
                    <androidx.core.widget.NestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="16dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="12dp"
                                android:visibility="gone"
                                android:background="@drawable/border_line_curve_4dp_gray"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="You,re reached the payment limits"
                                    android:textSize="12sp"
                                    android:textColor="@color/black_varient3"
                                    style="@style/FontRegular"/>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Note: "
                                        android:textSize="12sp"
                                        android:textColor="@color/black_varient3"
                                        style="@style/FontRegular"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="No Money has left your account"
                                        android:textSize="12sp"
                                        android:textColor="@color/black_varient3"
                                        style="@style/FontRegular"/>
                                </LinearLayout>
                            </LinearLayout>
                            <ImageView
                                android:layout_width="70dp"
                                android:layout_height="70sp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_pending"/>
                            <TextView
                                android:id="@+id/amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="2dp"
                                android:text="₹ 50000"
                                android:layout_gravity="center"
                                style="@style/FontSemiBold"
                                android:textColor="#f74850"
                                android:textSize="@dimen/_14sp" />
                            <TextView
                                style="@style/FontRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:visibility="visible"
                                android:layout_gravity="center"
                                android:text="08.50 PM on 04 May 20255"
                                android:textColor="#7A7A7A"
                                android:textSize="@dimen/_12sp" />
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1.5dp"
                                android:visibility="gone"
                                android:background="@drawable/dash_line"/>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/border_line_curve_6dp_gray"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Payment"
                                    android:textSize="12sp"
                                    android:visibility="gone"
                                    android:textColor="@color/black_varient3"
                                    style="@style/FontRegular"/>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_gravity="center"
                                    android:visibility="gone"
                                    android:padding="4dp">
                                    <ImageView
                                        android:layout_width="50dp"
                                        android:layout_height="50dp"
                                        android:src="@drawable/ic_user_profile"/>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_gravity="center"
                                        android:layout_marginStart="8dp">
                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_weight="1"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:orientation="vertical">
                                            <TextView
                                                android:id="@+id/name"
                                                style="@style/FontRegular"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Hada Nethaji"
                                                android:textColor="@color/black_varient3"
                                                android:textSize="@dimen/_14sp"/>
                                            <TextView
                                                android:id="@+id/phNUm"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textColor="@color/black_varient6"
                                                android:textSize="@dimen/_12sp"
                                                android:layout_marginTop="4dp"
                                                style="@style/FontRegular"
                                                android:text="+91 7995526103"/>
                                        </LinearLayout>
                                        <TextView
                                            android:id="@+id/status"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:paddingHorizontal="12dp"
                                            android:paddingVertical="2dp"
                                            android:text="₹ 1000000"
                                            android:layout_gravity="center"
                                            style="@style/FontSemiBold"
                                            android:textColor="@color/black_varient6"
                                            android:textSize="@dimen/_14sp" />
                                    </LinearLayout>
                                </LinearLayout>
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1.5dp"
                                    android:layout_marginTop="4dp"
                                    android:visibility="gone"
                                    android:background="@drawable/dash_line"/>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:background="@android:color/white">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Payment Details"
                                        android:textSize="14sp"
                                        style="@style/FontMedium"
                                        android:textColor="@color/black_varient3"
                                        android:layout_marginBottom="8dp" />
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_marginBottom="4dp">
                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="Trans ID"
                                            style="@style/FontRegular"
                                            android:textColor="#7A7A7A"
                                            android:textSize="12sp" />
                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            style="@style/FontRegular"
                                            android:text="TXN20240618002"
                                            android:textColor="@color/black_varient3"
                                            android:textSize="12sp"
                                            android:gravity="end" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_marginBottom="4dp">
                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="Payment Mode"
                                            style="@style/FontRegular"
                                            android:textColor="#7A7A7A"
                                            android:textSize="12sp" />
                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="UPI"
                                            style="@style/FontRegular"
                                            android:textColor="@color/black_varient3"
                                            android:textSize="12sp"
                                            android:gravity="end" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_marginBottom="8dp">
                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            style="@style/FontRegular"
                                            android:text="Payment Method"
                                            android:textColor="#7A7A7A"
                                            android:textSize="12sp" />
                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="Phonepe"
                                            style="@style/FontRegular"
                                            android:textColor="@color/black_varient3"
                                            android:textSize="12sp"
                                            android:gravity="end" />
                                    </LinearLayout>
                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1.5dp"
                                        android:layout_marginTop="4dp"
                                        android:background="@drawable/dash_line"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Payment From"
                                        android:textSize="14sp"
                                        style="@style/FontMedium"
                                        android:textColor="@android:color/black"
                                        android:layout_marginTop="8dp"
                                        android:layout_marginBottom="8dp" />
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_marginBottom="4dp">
                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="Name"
                                            style="@style/FontRegular"
                                            android:textColor="#7A7A7A"
                                            android:textSize="12sp" />

                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="Hada Nethaji"
                                            style="@style/FontRegular"
                                            android:textColor="@color/black_varient3"
                                            android:textSize="12sp"
                                            android:gravity="end" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_marginBottom="4dp">
                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="Email Id"
                                            style="@style/FontRegular"
                                            android:textColor="#7A7A7A"
                                            android:textSize="12sp" />
                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="sasikumar@gmail.com"
                                            style="@style/FontRegular"
                                            android:textColor="@color/black_varient3"
                                            android:textSize="12sp"
                                            android:gravity="end" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_marginBottom="4dp">
                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="Gender"
                                            style="@style/FontRegular"
                                            android:textColor="#7A7A7A"
                                            android:textSize="12sp" />
                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="Male"
                                            style="@style/FontRegular"
                                            android:textColor="@color/black_varient3"
                                            android:textSize="12sp"
                                            android:gravity="end" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">
                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            style="@style/FontRegular"
                                            android:text="Mobile Number"
                                            android:textColor="#7A7A7A"
                                            android:textSize="12sp" />
                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="9500516721"
                                            style="@style/FontRegular"
                                            android:textColor="@color/black_varient3"
                                            android:textSize="12sp"
                                            android:gravity="end" />
                                    </LinearLayout>

                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>