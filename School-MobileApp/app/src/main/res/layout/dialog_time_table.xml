<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha=".6"
        android:background="@color/black" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:id="@+id/top_lay"
        android:maxHeight="600dp"
        android:minHeight="600dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="0dp">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            android:id="@+id/card_view"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="-20dp"
            android:layout_gravity="bottom">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F3F3F3">
                    <ImageView
                        android:id="@+id/close1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:padding="8dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:src="@drawable/cancel"
                        app:tint="@color/black_varient6" />
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginTop="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:src="@drawable/rectangle_curve"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#232B68"
                        android:textSize="@dimen/_16sp"
                        android:padding="12dp"
                        style="@style/FontSemiBold"
                        android:layout_marginTop="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:id="@+id/txt1"
                        android:text="Time Table"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reset"
                        android:textSize="16sp"
                        style="@style/FontRegular"
                        android:padding="16dp"
                        android:id="@+id/reset"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:textColor="@color/colorPrimary"
                        android:paddingVertical="3dp"
                        android:paddingHorizontal="6dp"
                        android:layout_alignParentEnd="true"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp"
                    android:layout_weight="1">
                    <androidx.core.widget.NestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="16dp">
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="80dp"
                                    android:gravity="center"
                                    android:id="@+id/graybg"
                                    app:layout_constraintTop_toTopOf="parent"
                                    android:background="@drawable/graybgimage"
                                    android:orientation="horizontal">
                                    <ImageView
                                        android:id="@+id/img1"
                                        android:layout_width="50dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/businesboygirl"
                                        android:elevation="34dp"
                                        android:layout_marginStart="10dp" />
                                    <LinearLayout
                                        android:id="@+id/metrics_container"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:paddingVertical="6dp"
                                        android:layout_marginStart="12dp"
                                        android:gravity="center"
                                        android:weightSum="3">
                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:gravity="left"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Subject"
                                                style="@style/FontRegular"
                                                android:textColor="@color/white"
                                                android:textSize="12sp" />

                                            <TextView
                                                android:id="@+id/subName"
                                                style="@style/FontRegular"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="2dp"
                                                android:text="Tamil"
                                                android:textColor="@color/white"
                                                android:textSize="12sp" />
                                        </LinearLayout>
                                      <!--  <View
                                            android:layout_width="1.4dp"
                                            android:layout_height="50dp"
                                            android:background="@drawable/dash_line_vertical_two"
                                            android:backgroundTint="#FFFFFF"/>
-->
                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Date"
                                                style="@style/FontRegular"
                                                android:textColor="@color/white"
                                                android:textSize="12sp" />
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="16-06-2024"
                                                style="@style/FontRegular"
                                                android:layout_marginTop="2dp"
                                                android:textColor="@color/white"
                                                android:textSize="12sp" />
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Incharge"
                                                style="@style/FontRegular"
                                                android:textColor="@color/white"
                                                android:textSize="12sp" />
                                            <TextView
                                                android:id="@+id/incharge"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Mrs.Anitha"
                                                style="@style/FontRegular"
                                                android:layout_marginTop="2dp"
                                                android:textColor="@color/white"
                                                android:textSize="12sp" />
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="12dp"
                                android:paddingHorizontal="2dp"
                                android:gravity="center_vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Homework"
                                    android:drawableStart="@drawable/dot"
                                    android:drawableTint="#799BFF"
                                    android:drawablePadding="4dp"
                                    android:textColor="#333333"
                                    android:textSize="11sp"
                                    android:layout_marginStart="4dp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Assignment"
                                    android:drawableStart="@drawable/dot"
                                    android:drawableTint="#FFA93C"
                                    android:drawablePadding="4dp"
                                    android:textColor="#333333"
                                    android:textSize="11sp"
                                    android:layout_marginStart="4dp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Project"
                                    android:drawableStart="@drawable/dot"
                                    android:drawableTint="#0097A3"
                                    android:drawablePadding="4dp"
                                    android:textColor="#333333"
                                    android:textSize="11sp"
                                    android:layout_marginStart="4dp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Class Test"
                                    android:drawableStart="@drawable/dot"
                                    android:drawableTint="#9588D1"
                                    android:drawablePadding="4dp"
                                    android:textColor="#333333"
                                    android:textSize="11sp"
                                    android:layout_marginStart="4dp" />
                            </LinearLayout>
                            <include
                                android:id="@+id/dialogHomework"
                                layout="@layout/card_homwork_timetable"/>
                            <include
                                android:id="@+id/dialogAssignment"
                                layout="@layout/card_assignment_timetable"/>
                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <ImageView
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:padding="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/card_view"
            android:src="@drawable/cancel"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>