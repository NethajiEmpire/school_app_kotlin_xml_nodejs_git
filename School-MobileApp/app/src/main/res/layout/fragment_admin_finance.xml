<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/otp_rec"
    android:fitsSystemWindows="true"
    android:layout_marginBottom="-30dp"
    tools:context=".fragment.FinanceFragment">
    <LinearLayout
        android:layout_marginBottom="30dp"
        android:id="@+id/userManagementTop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/header">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="18dp"
                    android:id="@+id/top"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/topHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:textSize="@dimen/_18sp"
                        android:textColor="@color/colorPrimary"
                        style="@style/FontMedium"
                        android:text="User Management"/>
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/notify"
                        android:layout_marginEnd="10dp"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        app:riv_corner_radius="10dp"
                        android:layout_gravity="center"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/profile"
                        android:src="@drawable/dash_notification"/>
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/profile"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:riv_corner_radius="20dp"
                        android:layout_gravity="center"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:src="@drawable/ic_user_profile"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardElevation="0dp"
            app:cardCornerRadius="25dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:id="@+id/parentLayout"
                android:background="@color/white"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/tab"
                        android:layout_marginHorizontal="8dp"
                        android:background="@color/white">
                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/white"
                            android:id="@+id/getBoard"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:id="@+id/statsLay"
                        android:layout_margin="8dp"
                        android:background="@drawable/rect_gray_line">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:id="@+id/lin1"
                            android:paddingVertical="12dp"
                            app:layout_constraintStart_toStartOf="parent"
                            android:gravity="center"
                            android:weightSum="3">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/totalCollectAmt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/FontRegular"
                                    android:textSize="@dimen/_14sp"
                                    android:text="₹3,15,000"
                                    android:textColor="#32B138"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/FontRegular"
                                    android:textSize="@dimen/_12sp"
                                    android:text="Collected Amt"
                                    android:textColor="#585858"/>
                            </LinearLayout>
                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="#EFEFEF"/>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:id="@+id/lin3"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/totalPendingAmt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/FontRegular"
                                    android:textSize="@dimen/_14sp"
                                    android:text="₹63,000"
                                    android:textColor="#FF7700"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/FontRegular"
                                    android:textSize="@dimen/_12sp"
                                    android:text="Pending Amt"
                                    android:textColor="#585858"/>
                            </LinearLayout>
                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="#EFEFEF"/>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/totalOverDueAmt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#FF7475"
                                    style="@style/FontRegular"
                                    android:textSize="@dimen/_14sp"
                                    android:text="₹27,000"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/FontRegular"
                                    android:textSize="@dimen/_12sp"
                                    android:text="Over Due Amt"
                                    android:textColor="#585858"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginHorizontal="12dp"
                                android:background="#F5F5F5"/>
                        </LinearLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="8dp"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_14sp"
                                android:textColor="#585858"
                                android:text="Overall Fees :"
                                android:id="@+id/overal_fee"/>
                            <TextView
                                android:id="@+id/overAllCltAmt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_14sp"
                                android:textStyle="bold"
                                android:textColor="#11356B"
                                android:text="₹4,05,000"
                                android:layout_toEndOf="@id/overal_fee"/>
                        </RelativeLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/search_lay"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"
                        android:layout_marginHorizontal="10dp"
                        app:layout_constraintTop_toBottomOf="@id/line1"
                        android:layout_height="wrap_content">
                        <EditText
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Search"
                            style="@style/FontRegular"
                            android:textSize="@dimen/_14sp"
                            android:layout_marginEnd="10dp"
                            android:inputType="text"
                            android:id="@+id/search"
                            android:singleLine="true"
                            android:imeOptions="actionSearch"
                            android:drawableStart="@drawable/ic_search"
                            android:drawablePadding="10dp"
                            android:paddingVertical="10dp"
                            android:paddingHorizontal="12dp"
                            android:textColor="@color/black_varient6"
                            android:background="@drawable/border_line_curve_8dp_grey"/>
                        <ImageView
                            android:id="@+id/filter3"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_filter_blue"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:orientation="vertical">
                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/feeslay"/>
                        <include
                            android:visibility="gone"
                            android:id="@+id/noData"
                            layout="@layout/layout_no_data_found"/>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>


