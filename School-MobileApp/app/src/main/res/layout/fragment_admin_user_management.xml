<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/otp_rec"
    android:fitsSystemWindows="true"
    android:id="@+id/swipe_refresh"
    android:layout_marginBottom="-30dp"
    tools:context=".fragment.UserManagementFragment">
    <LinearLayout
        android:layout_marginBottom="30dp"
        android:id="@+id/userManagementTop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/header">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="18dp"
                    android:id="@+id/top"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/topHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:textSize="@dimen/_18sp"
                        android:textColor="@color/colorPrimary"
                        style="@style/FontMedium"
                        android:text="User Management"/>
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/notify"
                        android:layout_marginEnd="10dp"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        app:riv_corner_radius="10dp"
                        android:layout_gravity="center"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/profile"
                        android:src="@drawable/dash_notification"/>
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/profile"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:riv_corner_radius="20dp"
                        android:layout_gravity="center"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:src="@drawable/ic_user_profile"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardElevation="0dp"
            app:cardCornerRadius="25dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:id="@+id/parentLayout"
                android:background="@color/white"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible"
                    android:orientation="vertical">
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/guestTap"
                                android:padding="4dp"
                                android:background="@drawable/border_line_curve_24dp_primary"
                                android:gravity="center">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Guest"
                                    android:id="@+id/guest"
                                    android:paddingHorizontal="6dp"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_14sp"
                                    android:drawablePadding="10dp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="06"
                                    android:id="@+id/guest_count"
                                    android:textSize="@dimen/_10sp"
                                    android:gravity="center"
                                    android:textColor="@color/white"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/ic_round_line2"
                                    style="@style/FontRegular"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/studentTap"
                                android:layout_marginStart="8dp"
                                android:padding="4dp"
                                android:background="@drawable/border_line_curve_24dp_grey"
                                android:gravity="center">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Student "
                                    style="@style/FontRegular"
                                    android:id="@+id/student"
                                    android:textColor="@color/black_varient6"
                                    android:paddingHorizontal="6dp"
                                    android:textSize="@dimen/_14sp"
                                    android:drawablePadding="10dp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="06"
                                    android:id="@+id/student_count"
                                    android:textSize="@dimen/_10sp"
                                    android:gravity="center"
                                    android:textColor="@color/white"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/ic_round_line_3"
                                    style="@style/FontRegular"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/teacherTap"
                                android:layout_marginStart="8dp"
                                android:padding="4dp"
                                android:background="@drawable/border_line_curve_24dp_grey"
                                android:gravity="center">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Teacher"
                                    android:id="@+id/teacher"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient6"
                                    android:paddingHorizontal="6dp"
                                    android:textSize="@dimen/_14sp"
                                    android:drawablePadding="10dp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="06"
                                    android:textSize="@dimen/_10sp"
                                    android:id="@+id/teacher_count"
                                    android:gravity="center"
                                    android:textColor="@color/white"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/ic_round_line_3"
                                    style="@style/FontRegular"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/staffTap"
                                android:layout_marginStart="8dp"
                                android:padding="4dp"
                                android:background="@drawable/border_line_curve_24dp_grey"
                                android:gravity="center">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Staff"
                                    android:id="@+id/staff"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient6"
                                    android:paddingHorizontal="6dp"
                                    android:textSize="@dimen/_14sp"
                                    android:drawablePadding="10dp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="06"
                                    android:id="@+id/staff_count"
                                    android:textSize="@dimen/_10sp"
                                    android:gravity="center"
                                    android:textColor="@color/white"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/ic_round_line_3"
                                    style="@style/FontRegular"/>
                            </LinearLayout>
                        </LinearLayout>
                    </HorizontalScrollView>
                    <LinearLayout
                        android:id="@+id/filter_lay"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:paddingVertical="8dp"
                        app:layout_constraintTop_toBottomOf="@id/line1"
                        android:layout_height="wrap_content">
                        <EditText
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Search"
                            style="@style/FontRegular"
                            android:textSize="@dimen/_14sp"
                            android:layout_marginEnd="10dp"
                            android:inputType="text"
                            android:id="@+id/search"
                            android:singleLine="true"
                            android:imeOptions="actionSearch"
                            android:drawableStart="@drawable/ic_search"
                            android:drawablePadding="10dp"
                            android:paddingVertical="10dp"
                            android:paddingHorizontal="20dp"
                            android:textColor="@color/black"
                            android:background="@drawable/border_line_curve_8dp_grey"/>
                        <ImageView
                            android:id="@+id/filter"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_filter_blue"/>
                    </LinearLayout>

                    <include
                        android:id="@+id/no_data"
                        layout="@layout/layout_no_data_found"
                        android:visibility="gone"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/filter_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/filter_lay" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintTop_toBottomOf="@id/filter_recycler"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:id="@+id/program_recycler" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/guestPage"
                    android:visibility="gone"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:scrollbars="none"
                        android:id="@+id/userManagmentGuestRecyclerView"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/studentPage"
                    android:visibility="gone"
                    android:orientation="vertical">
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:scrollbars="none"
                        android:id="@+id/userManagmentTeacherRecyclerView"/>
                    <include
                        android:id="@+id/studentCard"
                        layout="@layout/card_um_student_list"/>
                    <include
                        android:id="@+id/studentCard1"
                        layout="@layout/card_um_student_list"/>
                    <include
                        android:id="@+id/studentCard2"
                        layout="@layout/card_um_student_list"/>
                    <include
                        android:id="@+id/studentCard3"
                        layout="@layout/card_um_student_list"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/teacherPage"
                    android:visibility="gone"
                    android:orientation="vertical">
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:scrollbars="none"
                        android:id="@+id/userManagmentStuduentRecyclerView"/>
                    <include
                        android:visibility="gone"
                        android:id="@+id/teacherCard"
                        layout="@layout/card_um_student_list"/>
                    <include
                        android:visibility="gone"
                        android:id="@+id/teacherCard1"
                        layout="@layout/card_um_student_list"/>
                    <include
                        android:visibility="gone"
                        android:id="@+id/teacherCard2"
                        layout="@layout/card_um_student_list"/>
                    <include
                        android:visibility="gone"
                        android:id="@+id/teacherCard3"
                        layout="@layout/card_um_student_list"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/staffPage"
                    android:visibility="gone"
                    android:orientation="vertical">
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:scrollbars="none"
                        android:id="@+id/userManagmentStaffRecyclerView"/>
                    <include
                        android:visibility="gone"
                        android:id="@+id/StaffCard"
                        layout="@layout/card_um_student_list"/>
                    <include
                        android:visibility="gone"
                        android:id="@+id/staffCard1"
                        layout="@layout/card_um_student_list"/>
                    <include
                        android:visibility="gone"
                        android:id="@+id/StaffCard2"
                        layout="@layout/card_um_student_list"/>
                    <include
                        android:visibility="gone"
                        android:id="@+id/StaffCard3"
                        layout="@layout/card_um_student_list"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>