<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingVertical="12dp"
        android:background="@drawable/fees_dash"
        android:id="@+id/top"
        android:paddingHorizontal="16dp"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chat"
            android:textSize="@dimen/_22sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/FontMedium"
            android:textColor="@color/colorPrimary"/>
        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/notify"
            android:layout_marginEnd="10dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:riv_corner_radius="10dp"
            android:layout_gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/profile"
            android:src="@drawable/dash_notification"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/profile"
            app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/ic_user_profile"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/scroll_view">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/header">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginEnd="-6dp"
                    android:layout_marginStart="-6dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:background="@drawable/teacher_bg"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="My Teachers"
                        android:textSize="@dimen/_16sp"
                        android:id="@+id/teacher_heading"
                        android:textColor="@color/white"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="16dp"
                        style="@style/FontRegular"/>
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/teachers"
                            android:orientation="horizontal">
                            <include
                                android:id="@+id/tchat"
                                layout="@layout/card_chat_teachers"/>
                            <include
                                android:id="@+id/tStaticChat"
                                layout="@layout/card_teachers_static"/>
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/tabs"
                    android:background="#F8F8F8"
                    android:scrollbars="none">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:paddingVertical="8dp"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginEnd="8dp"
                            android:padding="4dp"
                            android:src="@drawable/ic_search"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/directMessage"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp"
                            android:backgroundTint="#FDF4A5"
                            android:background="@drawable/border_curve_24dp"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Direct Message"
                                android:paddingHorizontal="6dp"
                                style="@style/FontRegular"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_14sp"
                                android:drawablePadding="10dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4"
                                android:textSize="@dimen/_10sp"
                                android:gravity="center"
                                android:id="@+id/count_ongoing"
                                android:textColor="@color/white"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/ic_round_line2"
                                style="@style/FontRegular"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/groups"
                            android:layout_marginStart="8dp"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp"
                            android:background="@drawable/border_curve_24dp"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Group"
                                style="@style/FontRegular"
                                android:textColor="@color/black_varient6"
                                android:paddingHorizontal="6dp"
                                android:textSize="@dimen/_14sp"
                                android:drawablePadding="10dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4"
                                android:textSize="@dimen/_10sp"
                                android:gravity="center"
                                android:id="@+id/count_not_completed2"
                                android:textColor="@color/white"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/ic_round_line_3"
                                style="@style/FontRegular"/>
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pinned message(2)"
                    android:textSize="@dimen/_16sp"
                    android:gravity="center"
                    android:textColor="@color/black_varient3"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="16dp"
                    style="@style/FontRegular"/>
                <include
                    android:id="@+id/pin"
                    layout="@layout/card_chat_list_static"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All message(8)"
                    android:textSize="@dimen/_16sp"
                    android:gravity="center"
                    android:textColor="@color/black_varient3"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="16dp"
                    style="@style/FontRegular"/>
                <include
                    android:id="@+id/staticChats"
                    layout="@layout/card_chat_list_static1"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
