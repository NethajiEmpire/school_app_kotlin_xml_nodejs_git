<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/scroll_view">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/header">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:id="@+id/banner"
                    android:scaleType="centerCrop"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:src="@drawable/bg_top"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:paddingVertical="14dp"
                    android:id="@+id/top"
                    android:paddingHorizontal="16dp"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Subjects"
                        android:textSize="@dimen/_16sp"
                        style="@style/FontMedium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:textColor="@color/colorPrimary"/>
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/notify"
                        android:layout_marginEnd="10dp"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        app:riv_corner_radius="10dp"
                        android:layout_gravity="center"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/profile"
                        android:src="@drawable/dash_notification"/>
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/profile"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:riv_corner_radius="20dp"
                        android:layout_gravity="center"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:src="@drawable/ic_user_profile"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/subRecycler"/>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:id="@+id/sectionRecycler"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/std1"
                    android:text="8th Std -A"
                    style="@style/FontRegular"
                    android:background="@drawable/border_line_curve_24dp_primary"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/_14sp"
                    android:drawablePadding="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8th Std -B"
                    android:id="@+id/std2"
                    style="@style/FontRegular"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/border_line_curve_24dp_grey"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/black_varient6"
                    android:textSize="@dimen/_14sp"
                    android:drawablePadding="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9th Std - A"
                    android:id="@+id/std3"
                    style="@style/FontRegular"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/border_line_curve_24dp_grey"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/black_varient6"
                    android:textSize="@dimen/_14sp"
                    android:drawablePadding="10dp"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Students List"
                    style="@style/FontMedium"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:textColor="@color/black_varient3"
                    android:textSize="@dimen/_16sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View All"
                    android:id="@+id/viewAll"
                    style="@style/FontRegular"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:textColor="@color/black_varient6"
                    android:textSize="@dimen/_14sp"/>
            </RelativeLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/studentListRecycler"/>
            <TextView
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subject Wise progress"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                style="@style/FontMedium"
                android:textColor="@color/black_varient3"
                android:textSize="@dimen/_16sp"/>
            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tabClsTest"
                    android:text="Class Test"
                    style="@style/FontRegular"
                    android:background="@drawable/border_line_curve_24dp_primary"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/_14sp"
                    android:drawablePadding="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Examination"
                    android:id="@+id/tabExam"
                    style="@style/FontRegular"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/border_line_curve_24dp_grey"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/black_varient6"
                    android:textSize="@dimen/_14sp"
                    android:drawablePadding="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/border_line_curve_8dp_grey_blue"
                android:orientation="vertical">
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChart1"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginVertical="12dp"
                    android:layout_marginHorizontal="8dp" />
            </LinearLayout>
            <TextView
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Attendance"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                style="@style/FontMedium"
                android:textColor="@color/black_varient3"
                android:textSize="@dimen/_16sp"/>
            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/border_line_curve_10dp_grey"
                android:layout_marginHorizontal="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/round_progress"
                    android:orientation="vertical">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="parent"
                            android:paddingHorizontal="12dp"
                            android:weightSum="2"
                            android:id="@+id/workingPRogress"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/totalWorking"
                                android:layout_width="match_parent"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Total Working Days : 220"
                                style="@style/FontRegular"
                                android:layout_gravity="center"
                                android:paddingVertical="4dp"
                                android:textColor="@color/black_varient6"
                                android:textSize="@dimen/_14sp" />
                            <LinearLayout
                                android:layout_marginStart="20dp"
                                android:layout_weight="1"
                                android:layout_width="match_parent"
                                android:gravity="right"
                                android:paddingVertical="8dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <Spinner
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    style="@style/SpinnerTheme1"
                                    android:id="@+id/spinner_filterAttendance"/>

                            </LinearLayout>

                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            app:layout_constraintTop_toBottomOf="@id/workingPRogress"
                            android:background="#EEEEEE"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:id="@+id/pro"
                            app:layout_constraintTop_toBottomOf="@id/workingPRogress"
                            android:gravity="center"
                            android:weightSum="3">
                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight=".7" />
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="0dp"
                                android:layout_height="200dp"
                                android:layout_weight="1.6">
                                <com.github.mikephil.charting.charts.PieChart
                                    android:id="@+id/pieChart"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight=".7" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Overall\n60%"
                            android:id="@+id/percent"
                            android:gravity="center"
                            style="@style/FontRegular"
                            app:layout_constraintTop_toTopOf="@id/pro"
                            app:layout_constraintBottom_toBottomOf="@id/pro"
                            app:layout_constraintStart_toStartOf="@id/pro"
                            app:layout_constraintEnd_toEndOf="@id/pro"
                            android:paddingVertical="4dp"
                            android:paddingHorizontal="14dp"
                            android:textColor="@color/black_varient6"
                            android:textSize="@dimen/_16sp"
                            android:drawablePadding="10dp"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:background="@drawable/dash_line"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:weightSum="2">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="3"
                            android:layout_weight="1">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:layout_marginEnd="4dp"
                                android:paddingVertical="8dp"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Present  "
                                    android:drawableStart="@drawable/small_green_dot"
                                    android:drawablePadding="4dp"
                                    android:layout_marginEnd="4dp"
                                    android:gravity="center"
                                    style="@style/FontDefault"
                                    android:textColor="@color/black_varient6"
                                    android:textSize="@dimen/_12sp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="100"
                                    android:id="@+id/present"
                                    android:paddingVertical="6dp"
                                    android:layout_marginEnd="4dp"
                                    android:gravity="center"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient3"
                                    android:textSize="@dimen/_14sp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:paddingVertical="8dp"
                                android:gravity="center"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Absent  "
                                    android:drawableStart="@drawable/small_red_dot"
                                    android:drawablePadding="4dp"
                                    android:layout_marginEnd="4dp"
                                    android:gravity="center"
                                    style="@style/FontDefault"
                                    android:textColor="@color/black_varient6"
                                    android:textSize="@dimen/_12sp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="40"
                                    android:id="@+id/absent"
                                    android:paddingVertical="6dp"
                                    android:layout_marginEnd="4dp"
                                    android:gravity="center"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient3"
                                    android:textSize="@dimen/_14sp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:id="@+id/halfdaylay"
                                android:layout_marginEnd="4dp"
                                android:paddingVertical="8dp"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Half Day :"
                                    android:drawableStart="@drawable/small_wt_dot"
                                    android:drawableTint="#1170E4"
                                    android:drawablePadding="4dp"
                                    android:layout_marginEnd="4dp"
                                    android:gravity="center"
                                    style="@style/FontDefault"
                                    android:textColor="@color/black_varient6"
                                    android:textSize="@dimen/_12sp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="100"
                                    android:paddingVertical="6dp"
                                    android:layout_marginEnd="4dp"
                                    android:gravity="center"
                                    android:id="@+id/halfDay"
                                    style="@style/FontRegular"
                                    android:textColor="@color/black_varient3"
                                    android:textSize="@dimen/_14sp"/>
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submission Overview"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                style="@style/FontMedium"
                android:textColor="@color/black_varient3"
                android:textSize="@dimen/_16sp"/>
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="16dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tabHomeWorktab"
                        android:padding="4dp"
                        android:background="@drawable/border_line_curve_24dp_primary"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tab1"
                            style="@style/FontRegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="10dp"
                            android:paddingHorizontal="6dp"
                            android:text="Home Work"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tabAttendance1"
                        android:layout_marginStart="8dp"
                        android:padding="4dp"
                        android:background="@drawable/border_line_curve_24dp_grey"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tab2"
                            android:text="Assignments"
                            style="@style/FontRegular"
                            android:textColor="@color/black_varient6"
                            android:paddingHorizontal="6dp"
                            android:textSize="@dimen/_14sp"
                            android:drawablePadding="10dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tabProjects"
                        android:layout_marginStart="8dp"
                        android:padding="4dp"
                        android:background="@drawable/border_line_curve_24dp_grey"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tab3"
                            android:text="Projects"
                            style="@style/FontRegular"
                            android:textColor="@color/black_varient6"
                            android:paddingHorizontal="6dp"
                            android:textSize="@dimen/_14sp"
                            android:drawablePadding="10dp"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/border_line_curve_12dp_grey"
                android:orientation="vertical">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        android:padding="12dp"
                        android:id="@+id/totalPointsLay"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/total"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Total Submission : 220"
                            android:drawableStart="@drawable/ic_schedule"
                            style="@style/FontRegular"
                            android:layout_gravity="center"
                            android:paddingVertical="4dp"
                            android:textColor="@color/black_varient6"
                            android:textSize="@dimen/_14sp"
                            android:drawablePadding="3dp"/>
                        <TextView
                            android:visibility="gone"
                            android:id="@+id/points"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Points : 28"
                            android:drawableStart="@drawable/winner"
                            style="@style/FontRegular"
                            android:layout_gravity="center"
                            android:paddingVertical="4dp"
                            android:textColor="@color/black_varient6"
                            android:textSize="@dimen/_14sp"
                            android:drawablePadding="3dp"/>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        app:layout_constraintTop_toBottomOf="@id/totalPointsLay"
                        android:background="#EEEEEE"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:id="@+id/submission_pro"
                        android:layout_marginVertical="8dp"
                        app:layout_constraintTop_toBottomOf="@id/totalPointsLay"
                        android:gravity="center"
                        android:weightSum="3">
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight=".7" />
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="0dp"
                            android:layout_height="200dp"
                            android:layout_weight="1.6">
                            <com.github.mikephil.charting.charts.PieChart
                                android:id="@+id/pieChartAss"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight=".7" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="On-time\n60%"
                        android:id="@+id/sub_percent"
                        android:gravity="center"
                        style="@style/FontRegular"
                        app:layout_constraintTop_toTopOf="@id/submission_pro"
                        app:layout_constraintBottom_toBottomOf="@id/submission_pro"
                        app:layout_constraintStart_toStartOf="@id/submission_pro"
                        app:layout_constraintEnd_toEndOf="@id/submission_pro"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/black_varient6"
                        android:textSize="@dimen/_16sp"
                        android:drawablePadding="10dp"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:id="@+id/dash"
                        app:layout_constraintTop_toBottomOf="@id/submission_pro"
                        android:background="@drawable/dash_line"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/dash"
                        android:id="@+id/desc1"
                        android:padding="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/ontime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="On-Time: 100"
                            android:drawableStart="@drawable/dot"
                            android:drawableTint="#32B138"
                            android:drawablePadding="4dp"
                            android:layout_marginEnd="8dp"
                            android:textColor="@color/black_varient3"
                            android:textSize="@dimen/_12sp"
                            android:padding="3dp"
                            style="@style/FontRegular"/>
                        <TextView
                            android:id="@+id/missed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" Missed : 20"
                            android:drawableStart="@drawable/dot"
                            android:drawableTint="#EA5455"
                            android:drawablePadding="4dp"
                            android:layout_marginEnd="8dp"
                            android:textColor="@color/black_varient3"
                            android:textSize="@dimen/_12sp"
                            android:padding="3dp"
                            style="@style/FontRegular"/>
                        <TextView
                            android:id="@+id/late"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Late : 20"
                            android:drawableStart="@drawable/dot"
                            android:drawableTint="#FF9900"
                            android:drawablePadding="4dp"
                            android:textColor="@color/black_varient3"
                            android:textSize="@dimen/_12sp"
                            android:padding="3dp"
                            style="@style/FontRegular"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
