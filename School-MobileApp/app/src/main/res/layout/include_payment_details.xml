<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/border_line_curve_8dp_light_blue"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical">
        <ImageView
            android:layout_width="165dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:layout_marginVertical="8dp"
            android:src="@drawable/fees_img1"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The Admission Fee is a one-time payment required during enrollment."
            style="@style/FontRegular"
            android:textSize="@dimen/_12sp"
            android:layout_marginHorizontal="34dp"
            android:gravity="center"
            android:textColor="#B2B2B2"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admission Fees  ₹4500"
            style="@style/FontRegular"
            android:textSize="@dimen/_12sp"
            android:id="@+id/admissionFee"
            android:background="@drawable/dashed_border_line_curve_8dp_green"
            android:paddingVertical="8dp"
            android:paddingHorizontal="16dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="34dp"
            android:gravity="center"
            android:textColor="@color/black_varient3"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:id="@+id/feesListRecycler"/>
        <include
            android:visibility="gone"
            android:id="@+id/noData"
            layout="@layout/card_nodata"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp"
            android:id="@+id/lin_main"
            android:background="@drawable/border_curve_6dp"
            android:orientation="vertical">
<!--            android:backgroundTint="#005DA7"-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:id="@+id/lin"
                android:background="@drawable/border_line_curve_10dp_grey_bg">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:id="@+id/box"
                    android:src="@drawable/checkbox_untick"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Annual Fees Payment"
                    style="@style/FontRegular"
                    android:id="@+id/feesTitle"
                    android:layout_marginStart="8dp"
                    android:textSize="@dimen/_14sp"
                    android:layout_gravity="center"
                    android:textColor="@color/black_varient3"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:id="@+id/down"
                    android:src="@drawable/guest_down"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/lin_Child"
                android:visibility="gone"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    android:padding="8dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Total Amount"
                        style="@style/FontRegular"
                        android:textSize="@dimen/_14sp"
                        android:textColor="@color/black_varient6"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹16,500"
                        style="@style/FontMedium"
                        android:id="@+id/tAmt"
                        android:textSize="@dimen/_14sp"
                        android:textColor="@color/black_varient3"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:src="@drawable/dash_line"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    android:padding="8dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Discount Amount"
                        style="@style/FontRegular"
                        android:textSize="@dimen/_14sp"
                        android:textColor="@color/black_varient6"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹1000"
                        android:id="@+id/discount"
                        style="@style/FontMedium"
                        android:textSize="@dimen/_14sp"
                        android:textColor="@color/black_varient3"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:src="@drawable/dash_line"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    android:padding="8dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Payable Amount"
                        style="@style/FontRegular"
                        android:textSize="@dimen/_14sp"
                        android:textColor="@color/black_varient6"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹15,500"
                        style="@style/FontMedium"
                        android:id="@+id/pAmt"
                        android:textSize="@dimen/_14sp"
                        android:textColor="@color/black_varient3"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            app:layout_constraintTop_toBottomOf="@id/lin_online"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:layout_margin="12dp"
            android:background="@drawable/border_curve_8dp_orange"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Note"
                style="@style/FontRegular"
                android:drawableTint="#F6891E"
                android:drawablePadding="4dp"
                android:drawableStart="@drawable/red_info"
                android:textSize="@dimen/_12sp"
                android:gravity="center"
                android:textColor="#F6891E"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/FontRegular"
                android:textSize="@dimen/_12sp"
                android:textColor="#ACACAC"
                android:layout_marginStart="8dp"
                android:text="Annual Fees includes all 3 term fees with a discount of 10%" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>