<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/FontMedium"
        android:id="@+id/txt_status"
        android:textSize="@dimen/_16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textColor="@color/black_varient3"
        android:text="Application Status"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/FontSemiBold"
        android:id="@+id/txt_progress"
        android:textSize="@dimen/_16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textColor="@color/black_varient3"
        android:text="47%"/>
    <ProgressBar
        android:id="@+id/bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:progressDrawable="@drawable/progress_bar_back"
        android:max="100"
        android:progress="48"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/txt_status" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/bar">
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:id="@+id/img1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/constraint1"
            app:layout_constraintBottom_toBottomOf="@id/constraint1"
            android:src="@drawable/ic_complete"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="13dp"
            android:id="@+id/constraint1"
            android:layout_marginStart="20dp"
            android:background="@drawable/border_line_curve_6dp_grey"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/img1"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                style="@style/FontNumber"
                android:id="@+id/txt1"
                android:gravity="center"
                android:background="@drawable/ic_round1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textSize="@dimen/_14sp"
                android:textColor="@color/white"
                android:text="1"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toEndOf="@id/txt1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/FontMedium"
                    android:text="Sign Up"
                    android:textColor="@color/black_varient3"
                    android:textSize="@dimen/_14sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/FontRegular"
                    android:text="Create your account."
                    android:textColor="#ABB7C2"
                    android:textSize="@dimen/_10sp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontMedium"
                android:text="Done"
                android:id="@+id/txt1_value"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:textColor="@color/green"
                android:textSize="@dimen/_12sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:id="@+id/img2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/constraint2"
            app:layout_constraintBottom_toBottomOf="@id/constraint2"
            android:src="@drawable/ic_complete"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="13dp"
            android:id="@+id/constraint2"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/border_line_curve_6dp_grey"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/constraint1"
            app:layout_constraintStart_toEndOf="@id/img1"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                style="@style/FontNumber"
                android:id="@+id/txt2"
                android:gravity="center"
                android:background="@drawable/ic_round1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textSize="@dimen/_14sp"
                android:textColor="@color/white"
                android:text="2"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toEndOf="@id/txt2"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/FontMedium"
                    android:text="Application Form"
                    android:textColor="@color/black_varient3"
                    android:textSize="@dimen/_14sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/FontRegular"
                    android:text="Submit required information."
                    android:textColor="#ABB7C2"
                    android:textSize="@dimen/_10sp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontMedium"
                android:text="Done"
                android:id="@+id/txt2_value"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:textColor="@color/green"
                android:textSize="@dimen/_12sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:id="@+id/img3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/constraint3"
            app:layout_constraintBottom_toBottomOf="@id/constraint3"
            android:src="@drawable/ic_complete"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="13dp"
            android:id="@+id/constraint3"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/border_line_curve_6dp_grey"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/constraint2"
            app:layout_constraintStart_toEndOf="@id/img1"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                style="@style/FontNumber"
                android:id="@+id/txt3"
                android:gravity="center"
                android:background="@drawable/ic_round1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textSize="@dimen/_14sp"
                android:textColor="@color/white"
                android:text="3"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toEndOf="@id/txt3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/FontMedium"
                    android:singleLine="true"
                    android:text="Document Verification"
                    android:textColor="@color/black_varient3"
                    android:textSize="@dimen/_14sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/FontRegular"
                    android:singleLine="true"
                    android:text="Final verification before confirmation."
                    android:textColor="#ABB7C2"
                    android:textSize="@dimen/_10sp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontMedium"
                android:text="Pending"
                android:id="@+id/txt3_value"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:textColor="#A3A3A3"
                android:textSize="@dimen/_12sp"/>
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:id="@+id/doc_img"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/ic_msg_doc"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:id="@+id/img4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/constraint4"
            app:layout_constraintBottom_toBottomOf="@id/constraint4"
            android:src="@drawable/ic_progress"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="13dp"
            android:id="@+id/constraint4"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/border_line_curve_6dp_grey"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/constraint3"
            app:layout_constraintStart_toEndOf="@id/img1"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                style="@style/FontNumber"
                android:id="@+id/txt4"
                android:gravity="center"
                android:background="@drawable/ic_round1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textSize="@dimen/_14sp"
                android:textColor="@color/white"
                android:text="4"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toEndOf="@id/txt4"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/FontMedium"
                    android:text="Fees Payment"
                    android:textColor="@color/black_varient3"
                    android:textSize="@dimen/_14sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/FontRegular"
                    android:singleLine="true"
                    android:text="Complete your fee payment."
                    android:textColor="#ABB7C2"
                    android:textSize="@dimen/_10sp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontMedium"
                android:text="On process"
                android:id="@+id/txt4_value"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:textColor="#D9981B"
                android:textSize="@dimen/_12sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:id="@+id/img5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/constraint5"
            app:layout_constraintBottom_toBottomOf="@id/constraint5"
            android:src="@drawable/ic_pending"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="13dp"
            android:id="@+id/constraint5"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/border_line_curve_6dp_grey"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/constraint4"
            app:layout_constraintStart_toEndOf="@id/img1"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                style="@style/FontNumber"
                android:id="@+id/txt5"
                android:gravity="center"
                android:background="@drawable/ic_round_line"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textSize="@dimen/_14sp"
                android:textColor="@color/black_varient3"
                android:text="5"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toEndOf="@id/txt5"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/FontMedium"
                    android:text="Acknowledgement"
                    android:textColor="@color/black_varient3"
                    android:textSize="@dimen/_14sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/FontRegular"
                    android:text="Await confirmation from the admin."
                    android:textColor="#ABB7C2"
                    android:textSize="@dimen/_10sp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontMedium"
                android:text="Pending"
                android:id="@+id/txt5_value"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:textColor="#A3A3A3"
                android:textSize="@dimen/_12sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:id="@+id/img6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/constraint6"
            app:layout_constraintBottom_toBottomOf="@id/constraint6"
            android:src="@drawable/ic_pending"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="13dp"
            android:id="@+id/constraint6"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/border_line_curve_6dp_grey"
            android:paddingHorizontal="16dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/constraint5"
            app:layout_constraintStart_toEndOf="@id/img1"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                style="@style/FontNumber"
                android:id="@+id/txt6"
                android:gravity="center"
                android:background="@drawable/ic_round_line"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textSize="@dimen/_14sp"
                android:textColor="@color/black_varient3"
                android:text="6"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toEndOf="@id/txt6"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/acknowledge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/FontMedium"
                    android:text="Waiting Approval"
                    android:textColor="@color/black_varient3"
                    android:textSize="@dimen/_14sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/FontRegular"
                    android:text="Submit signature and proceed next."
                    android:textColor="#ABB7C2"
                    android:textSize="@dimen/_10sp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontMedium"
                android:text="Pending"
                android:id="@+id/txt6_value"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:textColor="#A3A3A3"
                android:textSize="@dimen/_12sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:id="@+id/view1"
            app:layout_constraintStart_toStartOf="@id/img1"
            app:layout_constraintEnd_toEndOf="@id/img1"
            app:layout_constraintTop_toBottomOf="@id/img1"
            app:layout_constraintBottom_toTopOf="@id/img2"
            android:background="@color/green"/>
        <View
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:id="@+id/view2"
            app:layout_constraintStart_toStartOf="@id/img1"
            app:layout_constraintEnd_toEndOf="@id/img1"
            app:layout_constraintTop_toBottomOf="@id/img2"
            app:layout_constraintBottom_toTopOf="@id/img3"
            android:background="@color/green"/>
        <View
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:id="@+id/view3"
            app:layout_constraintStart_toStartOf="@id/img1"
            app:layout_constraintEnd_toEndOf="@id/img1"
            app:layout_constraintTop_toBottomOf="@id/img3"
            app:layout_constraintBottom_toTopOf="@id/img4"
            android:background="@color/green"/>
        <View
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:id="@+id/view4"
            app:layout_constraintStart_toStartOf="@id/img1"
            app:layout_constraintEnd_toEndOf="@id/img1"
            app:layout_constraintTop_toBottomOf="@id/img4"
            app:layout_constraintBottom_toTopOf="@id/img5"
            android:background="#A3A3A3"/>
        <View
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:id="@+id/view5"
            app:layout_constraintStart_toStartOf="@id/img1"
            app:layout_constraintEnd_toEndOf="@id/img1"
            app:layout_constraintTop_toBottomOf="@id/img5"
            app:layout_constraintBottom_toTopOf="@id/img6"
            android:background="#A3A3A3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

