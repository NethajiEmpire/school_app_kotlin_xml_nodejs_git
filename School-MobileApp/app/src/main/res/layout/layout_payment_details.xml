<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/onlineRadio"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/lin_online"
                android:background="@drawable/border_line_curve_8dp_light_blue">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_16sp"
                    style="@style/FontRegular"
                    android:padding="10dp"
                    android:textColor="@color/colorPrimary"
                    android:text="Payment details"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DAEFFF"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:orientation="vertical">
                    <LinearLayout
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_width="match_parent"
                        android:weightSum="2"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sp"
                                style="@style/FontRegular"
                                android:text="Full Name"
                                android:textColor="#89879C"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_14sp"
                                style="@style/FontRegular"
                                android:layout_marginTop="3dp"
                                android:id="@+id/name"
                                android:text="Alrin sherbi"
                                android:textColor="#636363"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sp"
                                style="@style/FontRegular"
                                android:text="Email"
                                android:textColor="#89879C"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_14sp"
                                style="@style/FontRegular"
                                android:layout_marginTop="3dp"
                                android:id="@+id/email"
                                android:text="karthi@gmail.com"
                                android:textColor="#636363"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_width="match_parent"
                        android:weightSum="2"
                        android:layout_marginTop="12dp"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sp"
                                style="@style/FontRegular"
                                android:text="Mobile"
                                android:textColor="#89879C"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_14sp"
                                style="@style/FontRegular"
                                android:layout_marginTop="3dp"
                                android:id="@+id/mobile_no"
                                android:text="9873456890"
                                android:textColor="#636363"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sp"
                                style="@style/FontRegular"
                                android:text="Grade"
                                android:textColor="#89879C"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_14sp"
                                android:id="@+id/graduation"
                                style="@style/FontRegular"
                                android:layout_marginTop="3dp"
                                android:text="9th Standard"
                                android:textColor="#636363"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/border_line_curve_10dp_grey">
                        <LinearLayout
                            android:layout_marginVertical="6dp"
                            android:paddingVertical="4dp"
                            android:paddingHorizontal="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="3"
                            android:orientation="horizontal">
                            <View
                                android:layout_weight="1"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_gravity="center"
                                android:background="@color/black_varient6"
                                android:backgroundTint="#A5ADE7"
                                />
                            <TextView
                                android:paddingVertical="4dp"
                                android:background="@drawable/border_curve_100dp_blue"
                                android:layout_weight="1"
                                android:textAlignment="center"
                                style="@style/FontRegular"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/_14sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Term 1"/>
                            <View
                                android:layout_weight="1"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_gravity="center"
                                android:background="@color/black_varient6"
                                android:backgroundTint="#A5ADE7"
                                />

                        </LinearLayout>

                        <LinearLayout
                            android:paddingVertical="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="2"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:textAlignment="viewStart"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Tution Fees"
                                android:textColor="#666666"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp"/>
                            <TextView
                                android:layout_marginEnd="14dp"
                                android:textAlignment="textEnd"
                                android:layout_weight="1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="₹3,000"
                                android:textColor="#111111"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp"/>

                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:background="@drawable/dash_line"
                            android:backgroundTint="#F0F0F0"
                            />
                        <LinearLayout
                            android:paddingVertical="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="2"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:textAlignment="viewStart"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Book fees"
                                android:textColor="#666666"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp"/>
                            <TextView
                                android:layout_marginEnd="14dp"
                                android:textAlignment="textEnd"
                                android:layout_weight="1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="₹4,500"
                                android:textColor="#111111"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp"/>
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:background="@drawable/dash_line"
                            android:backgroundTint="#F0F0F0"
                            />
                        <LinearLayout
                            android:layout_marginVertical="6dp"
                            android:paddingVertical="4dp"
                            android:paddingHorizontal="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="3"
                            android:orientation="horizontal">
                            <View
                                android:layout_weight="1"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_gravity="center"
                                android:background="@color/black_varient6"
                                android:backgroundTint="#A5ADE7"
                                />
                            <TextView
                                android:paddingVertical="4dp"
                                android:background="@drawable/border_curve_100dp_blue"
                                android:layout_weight="1"
                                android:textAlignment="center"
                                style="@style/FontRegular"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/_14sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Term 2"/>
                            <View
                                android:layout_weight="1"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_gravity="center"
                                android:background="@color/black_varient6"
                                android:backgroundTint="#A5ADE7"
                                />
                        </LinearLayout>
                        <LinearLayout
                            android:paddingVertical="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="2"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:textAlignment="viewStart"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Tution Fees"
                                android:textColor="#666666"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp"/>
                            <TextView
                                android:layout_marginEnd="14dp"
                                android:textAlignment="textEnd"
                                android:layout_weight="1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="₹3,000"
                                android:textColor="#111111"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_12sp"/>
                        </LinearLayout>
                        <View
                            android:layout_weight="1"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_gravity="center"
                            android:background="@color/black_varient6"
                            android:backgroundTint="#DFDFDF"/>
                        <LinearLayout
                            android:background="@drawable/border_curve_0dp_blue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_weight="1"
                                android:textAlignment="viewStart"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Payable Amount"
                                android:textColor="#333333"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_14sp"/>
                            <TextView
                                android:textAlignment="textEnd"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹12,000"
                                android:textColor="#00A606"
                                style="@style/FontRegular"
                                android:textSize="@dimen/_14sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
             </LinearLayout>
        </LinearLayout>
        <LinearLayout
            app:layout_constraintTop_toBottomOf="@id/lin_online"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/border_curve_8dp_orange"
            android:orientation="vertical">
            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontRegular"
                android:textSize="@dimen/_12sp"
                android:gravity="center"
                android:buttonTint="@color/colorPrimary"
                android:textColor="@color/black_varient6"
                android:text="Agree With Acknowledgement"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingBottom="8dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/FontRegular"
                    android:textSize="@dimen/_12sp"
                    android:textColor="@color/black_varient6"
                    android:text="I understand that the fees are non-refundable and confirm that the details mentioned above are correct."
                    android:maxLines="2"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/FontRegular"
                    android:textSize="@dimen/_12sp"
                    android:textColor="@color/black_varient6"
                    android:text="🔹 I agree to follow all the rules and regulations of the institution."/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/FontRegular"
                    android:textSize="@dimen/_12sp"
                    android:textColor="@color/black_varient6"
                    android:text="🔹 Any outstanding dues will be cleared as per the school’s policies."/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/FontRegular"
                    android:textSize="@dimen/_12sp"
                    android:textColor="@color/black_varient6"
                    android:text="🔹 I have received the official receipt for this payment."/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>