<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.LMS" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorPrimary</item>
        <item name="colorSecondaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="SplashScreen" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="@style/Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/BottomSheet</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="BottomSheet" parent="@style/Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bottom_sheet_bg</item>
    </style>

    <style name="FontDefault">
        <item name="android:fontFamily">@font/font_regular</item>
        <item name="fontFamily">@font/font_regular</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="FontRegular">
        <item name="android:fontFamily">@font/font_regular</item>
        <item name="fontFamily">@font/font_regular</item>
    </style>
    <style name="FontMedium">
        <item name="android:fontFamily">@font/font_medium</item>
        <item name="fontFamily">@font/font_medium</item>
    </style>
    <style name="FontNumber">
        <item name="android:fontFamily">@font/urbanist_medium</item>
        <item name="fontFamily">@font/urbanist_medium</item>
    </style>

    <style name="FontBold">
        <item name="android:fontFamily">@font/font_bold</item>
        <item name="fontFamily">@font/font_bold</item>
    </style>

    <style name="FontSemiBold">
        <item name="android:fontFamily">@font/font_semibold</item>
        <item name="fontFamily">@font/font_semibold</item>
    </style>

    <style name="FontDefaultActive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/_10sp</item>
        <item name="fontFamily">@font/font_regular</item>
    </style>

    <style name="FontDefaultInactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/_10sp</item>
        <item name="fontFamily">@font/font_regular</item>
    </style>

    <style name="BottomNavigationViewItemStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemTextAppearanceActive">@style/FontDefaultActive</item>
        <item name="itemTextAppearanceInactive">@style/FontDefaultInactive</item>

    </style>

    <style name="SpinnerTheme" parent="android:Widget.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
    </style>
    <style name="SpinnerTheme1" parent="android:Widget.Spinner">
        <item name="android:background">@drawable/bg_spinner1</item>
        <item name="android:gravity">start</item>
        <item name="android:textColor">@color/black_varient6</item>
    </style>
  <!-- Base application theme. -->
    <style name="Base.Theme.LMS" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

</resources>