# ===== Server =====
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000

# ===== MySQL connection (MySQL Workbench / local server) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password

# ===== Master database (school registry) =====
MASTER_DB_NAME=school_master

# ===== JWT =====
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_too_to_a_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# ===== Super Admin (used only the very first time you run provision:master) =====
SUPER_ADMIN_EMAIL=superadmin@school-lms.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123

# ===== File uploads =====
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ===== OTP (mocked - plug in an SMS gateway later) =====
OTP_EXPIRY_MINUTES=5
