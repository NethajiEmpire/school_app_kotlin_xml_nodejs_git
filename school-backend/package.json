{
  "name": "school-lms-backend",
  "version": "1.0.0",
  "description": "Multi-tenant School LMS backend (Node.js + TypeScript + MySQL) - Master DB + per-school databases",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src -e ts --exec ts-node --files src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "provision:master": "ts-node --files src/database/master/migrate.ts",
    "provision:school": "ts-node --files src/database/tenant/provisionSchool.ts"
  },
  "keywords": ["school", "lms", "multi-tenant", "mysql", "typescript", "express"],
  "author": "Hada",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
